            #optionsTable thead th:nth-child(3),
            #optionsTable tbody td:nth-child(3),
            #optionsTable thead th:nth-child(4),
            #optionsTable tbody td:nth-child(4) {
                width: 22% !important;
            }

            #optionsTable tbody td:nth-child(3),
            #optionsTable tbody td:nth-child(4) {
                font-size: 8px;
                white-space: nowrap;
            }

            #optionsTable thead th:last-child,
            #optionsTable tbody td:last-child {
                width: 15% !important;
                min-width: 26px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <div class="dropdowns-sidebar">
            <div class="dropdowns-card">
                <div class="dropdown-section">
                    <label class="dropdown-label" id="brandLabel"> БРЕНД</label>
                    <select class="dropdown-select" id="brandDropdown" disabled>
                        <option value="">-- Загрузка... --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="modelLabel"> МОДЕЛЬ</label>
                    <select class="dropdown-select" id="modelDropdown" disabled>
                        <option value="">-- Сначала бренд --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="generationLabel"> ПОКОЛЕНИЕ</label>
                    <select class="dropdown-select" id="generationDropdown" disabled>
                        <option value="">-- Сначала модель --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="engineLabel"> ДВИГАТЕЛЬ</label>
                    <select class="dropdown-select" id="engineDropdown" disabled>
                        <option value="">-- Сначала поколение --</option>
                    </select>
                </div>

                <button class="btn-next" id="successButton" onclick="onSuccessButtonClick()">
                    ПЕРЕЙТИ →
                </button>
            </div>
        </div>

        <div class="container">

            <div class="car-header">
                <div class="specs-container desktop-specs">
                    <div class="spec-item">
                        <span class="spec-label">@GetLocalized("БРЕНД", "BRAND", "MARKE")</span>
                        <span class="spec-value">@Model.Brand</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@GetLocalized("МОДЕЛЬ", "MODEL", "MODELL")</span>
                        <span class="spec-value">@Model.Model</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@GetLocalized("ПОКОЛЕНИЕ", "GENERATION", "GENERATION")</span>
                        <span class="spec-value">@Model.Generation</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@GetLocalized("ДВИГАТЕЛЬ", "ENGINE", "MOTOR")</span>
                        <span class="spec-value">@Model.Engine</span>
                    </div>
                </div>

                <div class="header-dropdowns">
                    <div class="header-dropdowns-grid">
                        <div class="spec-item">
                            <span class="spec-label" id="brandLabelHeader">@GetLocalized("БРЕНД", "BRAND", "MARKE")</span>
                            <select class="dropdown-select" id="brandDropdownHeader" disabled>
                                <option value="">--</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label" id="modelLabelHeader">@GetLocalized("МОДЕЛЬ", "MODEL", "MODELL")</span>
                            <select class="dropdown-select" id="modelDropdownHeader" disabled>
                                <option value="">--</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label" id="generationLabelHeader">@GetLocalized("ПОКОЛЕНИЕ", "GENERATION", "GENERATION")</span>
                            <select class="dropdown-select" id="generationDropdownHeader" disabled>
                                <option value="">--</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label" id="engineLabelHeader">@GetLocalized("ДВИГАТЕЛЬ", "ENGINE", "MOTOR")</span>
                            <select class="dropdown-select" id="engineDropdownHeader" disabled>
                                <option value="">--</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn-next-mobile" id="successButtonMobile" onclick="onSuccessButtonClick()">
                        ПЕРЕЙТИ →
                    </button>
                </div>

                <div class="car-info-wrapper">
                    <div class="car-image-full">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@GetCarImagePath(Model.Image)" alt="@Model.Brand @Model.Model" class="car-image" 
                                 onerror="this.parentElement.innerHTML='<div class=\'no-image-placeholder\'><i class=\'fas fa-car\'></i> @GetLocalized("Нет изображения", "No image", "Kein Bild")</div>'" />
                        }
                        else
                        {
                            <div class="no-image-placeholder">
                                <i class="fas fa-car"></i>
                                @GetLocalized("Нет изображения", "No image", "Kein Bild")
                            </div>
                        }
                    </div>

                    <!-- ===== БЛОК ЦЕН СВЕРХУ (ПК) ===== -->
                    <div class="car-order-block">
                        <div class="order-content">
                            <div class="order-text">
                                <span class="order-title">@GetLocalized("Цены:", "Prices:", "Preise:")</span>
                                <div style="display: flex; flex-direction: column; gap: 6px; align-items: center; margin-top: 4px; width: 100%;">
                                    @if (Model.AdditionalPrices != null && Model.AdditionalPrices.Any())
                                    {
                                        var hasValidPrices = false;
                                        foreach (var item in Model.AdditionalPrices)
                                        {
                                            var price = item.GetPrice(language);
                                            var currency = item.GetCurrency(language);
                                            
                                            bool isZeroPrice = false;
                                            if (!string.IsNullOrEmpty(price))
                                            {
                                                var cleanPrice = price.Replace(",", ".").Replace(" ", "");
                                                if (decimal.TryParse(cleanPrice, out decimal numPrice) && numPrice == 0)
                                                    isZeroPrice = true;
                                            }
                                            
                                            if (!isZeroPrice && !string.IsNullOrEmpty(price))
                                            {
                                                hasValidPrices = true;
                                                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; width: 100%; font-size: 13px; padding: 4px 0; border-bottom: 1px solid var(--border-color);">
    <span style="font-weight: 500; flex: 1; min-width: 0; white-space: normal; word-break: break-word; overflow-wrap: anywhere;">
        @item.GetName(language)
    </span>
    <span style="font-weight: 700; color: var(--accent-color); white-space: nowrap; flex-shrink: 0;">
        @price @currency
    </span>
</div>
                                            }
                                        }
                                        
                                        if (!hasValidPrices)
                                        {
                                            <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">
                                                @GetLocalized("Нет доступных пакетов", "No packages available", "Keine Pakete verfügbar")
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="font-size: 14px; font-weight: 500; color: var(--text-muted);">
                                            @GetLocalized("Нет дополнительных пакетов", "No additional packages", "Keine zusätzlichen Pakete")
                                        </span>
                                    }
                                </div>
                            </div>
                            <button class="order-button" onclick="scrollToPrices()">
                                @GetLocalized("Перейти к ценам опций", "Go to option prices", "Zu den Optionspreisen")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ===== БЛОК ЦЕН СВЕРХУ (МОБИЛЬНАЯ ВЕРСИЯ) ===== -->
                <div class="mobile-price-block">
                    <div class="mobile-price-content">
                        <span class="mobile-price-title">@GetLocalized("Цены:", "Prices:", "Preise:")</span>
                        @if (Model.AdditionalPrices != null && Model.AdditionalPrices.Any())
                        {
                            var hasValidPrices = false;
                            foreach (var item in Model.AdditionalPrices)
                            {
                                var price = item.GetPrice(language);
                                var currency = item.GetCurrency(language);
                                
                                bool isZeroPrice = false;
                                if (!string.IsNullOrEmpty(price))
                                {
                                    var cleanPrice = price.Replace(",", ".").Replace(" ", "");
                                    if (decimal.TryParse(cleanPrice, out decimal numPrice) && numPrice == 0)
                                        isZeroPrice = true;
                                }
                                
                                if (!isZeroPrice && !string.IsNullOrEmpty(price))
                                {
                                    hasValidPrices = true;
                                    <div style="display: flex; justify-content: space-between; width: 100%; font-size: 13px; padding: 4px 0; border-bottom: 1px solid var(--border-color);">
                                        <span style="font-weight: 500; display: flex; align-items: center; gap: 6px;">
                                            @item.GetName(language)
                                        </span>
                                        <span style="font-weight: 700; color: var(--accent-color); white-space: nowrap;">
                                            @price @currency
                                        </span>
                                    </div>
                                }
                            }
                            
                            if (!hasValidPrices)
                            {
                                <span style="font-size: 13px; color: var(--text-muted);">
                                    @GetLocalized("Нет доступных пакетов", "No packages available", "Keine Pakete verfügbar")
                                </span>
                            }
                        }
                        else
                        {
                            <span style="font-size: 13px; color: var(--text-muted);">
                                @GetLocalized("Нет дополнительных пакетов", "No additional packages", "Keine zusätzlichen Pakete")
                            </span>
                        }
                        
                        <button class="order-button" onclick="scrollToPrices()" style="margin-top: 8px; padding: 10px 20px; font-size: 13px;">
                            @GetLocalized("Перейти к ценам опций", "Go to option prices", "Zu den Optionspreisen")
                        </button>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- БЛОК: ПОЛУЧАЕМЫЙ РЕЗУЛЬТАТ (ABOUT) -->
            <!-- ============================================================ -->
            <div class="info-block">
                <div class="info-title"> @GetLocalized("Получаемый результат", "Result obtained", "Erzieltes Ergebnis")</div>
                <div class="info-content">
                    @if (Model.Abouts != null && Model.Abouts.Any())
                    {
                        var items = Model.Abouts.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger)).ToList();
                        <ul class="info-list-plain">
                            @foreach (var item in items)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        @Model.AboutRu
                    }
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- БЛОК: ВОСПРИЯТИЕ (RESULTS) -->
            <!-- ============================================================ -->
            <div class="info-block">
                <div class="info-title"> @GetLocalized("Восприятие:", "Perception", "Wahrnehmung")</div>
                <div class="info-content">
                    @if (Model.PriResults != null && Model.PriResults.Any())
                    {
                        var items = Model.PriResults.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger)).ToList();
                        <ul class="info-list-star">
                            @foreach (var item in items)
                            {
                                var parts = SplitTextBySeparator(item);
                                foreach (var part in parts)
                                {
                                    <li>@part</li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        @Html.Raw(AddLineBreaks(Model.ResultRu))
                    }
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- БЛОК: УПРАВЛЕНИЕ ДВИГАТЕЛЕМ (ENGINE CONTROL) -->
            <!-- ============================================================ -->
            <div class="info-block">
                <div class="info-title"> @GetLocalized("В программе управления двигателем изменено:", "The following changes have been made to the engine management program:", "Im Motorsteuerprogramm wurde Folgendes geändert:")</div>
                <div class="info-content">
                    @if (Model.Engine_controlers != null && Model.Engine_controlers.Any())
                    {
                        var items = Model.Engine_controlers.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger)).ToList();
                        <ul class="info-list-star">
                            @foreach (var item in items)
                            {
                                var parts = SplitTextBySeparator(item);
                                foreach (var part in parts)
                                {
                                    <li>@part</li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        @Html.Raw(AddLineBreaks(Model.EngineControlRu))
                    }
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- БЛОК: КОНСТРУКТОР ЦЕН -->
            <!-- ============================================================ -->
            <div class="info-block" id="prices-section">
                @if (Model.AdditionalPrices != null && Model.AdditionalPrices.Any())
                {
                    <div class="price-label"> @GetLocalized("Цены:", "Prices:", "Preise:")</div>
                    <div class="price-table-wrapper">
                        <table class="price-table">
                            <thead>
                                <tr>
                                    <th class="name-col">@GetLocalized("Название", "Name", "Name")</th>
                                 
                                    <th>@GetLocalized("Цена", "Price", "Preis")</th>
                                    <th style="text-align: center; width: 80px;">@GetLocalized("Выбрать", "Select", "Wählen")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var allPrices = Model.AdditionalPrices.ToList();
                                    var firstNonZero = allPrices.FirstOrDefault(p => 
                                        !(string.IsNullOrEmpty(p.price_rubl) && string.IsNullOrEmpty(p.price_dolar) && string.IsNullOrEmpty(p.price_euro)) &&
                                        p.price_rubl != "0" && p.price_dolar != "0" && p.price_euro != "0"
                                    );
                                }
                                
                                @foreach (var item in allPrices)
                                {
                                    var price = item.GetPrice(language);
                                    var currency = item.GetCurrency(language);
                                    var name = item.GetName(language);
                                    var info = language switch
                                    {
                                        "en" => item.info_eng,
                                        "de" => item.info_ger,
                                        _ => item.info_ru
                                    };
                                    
                                    bool hasInfo = !string.IsNullOrEmpty(info);
                                    bool isZeroPrice = (item.price_rubl == "0" || item.price_dolar == "0" || item.price_euro == "0") ||
                                                       (string.IsNullOrEmpty(item.price_rubl) && string.IsNullOrEmpty(item.price_dolar) && string.IsNullOrEmpty(item.price_euro));
                                    
                                    bool isChecked = !isZeroPrice && firstNonZero != null && item.id == firstNonZero.id;
                                    
                                    <tr>
                                                                                <td class="name-col">
                                            <div class="price-name-desktop">
                                                <div class="price-name-cell">
                                                    <span>@name</span>
                                                    @if (hasInfo)
                                                    {
                                                        <button class="info-btn info-btn-inline" onclick='openInfoModal(@Json.Serialize(name), @Json.Serialize(info))' title="@GetLocalized("Подробнее", "More info", "Mehr Info")">
                                                            <i class="fas fa-info-circle"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            @if (hasInfo)
                                            {
                                                <span class="price-name-mobile-wrap"><table class="name-info-table" style="width:max-width:100%;border-collapse:collapse;border:none;margin:0;padding:0;table-layout:auto;vertical-align:middle;">
                                                    <tr>
                                                        <td class="name-cell" style="border:none;padding:0;margin:0;width:auto;vertical-align:middle;">@name</td>
                                                        <td class="info-cell" style="border:none;padding:0 0 0 4px;margin:0;width:1%;white-space:nowrap;vertical-align:middle;text-align:left;">
                                                            <button type="button" class="info-btn" onclick='openInfoModal(@Json.Serialize(name), @Json.Serialize(info))' title="@GetLocalized("Подробнее", "More info", "Mehr Info")">
                                                                <i class="fas fa-info-circle"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </table></span>
                                            }
                                            else
                                            {
                                                <span class="price-name-mobile">@name</span>
                                            }
                                        </td>
                                        <td style="text-align: center; font-weight: 700; color: var(--accent-color);">
                                            @if (!string.IsNullOrEmpty(price))
                                            {
                                                @price @currency
                                            }
                                            else
                                            {
                                                <span style="color: var(--text-muted);">—</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="radio" 
                                                   name="basePrice"
                                                   class="base-price-radio"
                                                   value="@item.id"
                                                   data-price="@price"
                                                   data-name="@name"
                                                   data-is-zero="@isZeroPrice.ToString().ToLower()"
                                                   data-price-controler="@item.price_controler"
                                                   data-unselected-mode="@item.unselected_price_mode"
                                                   @(isChecked ? "checked" : "")
                                                   onchange="handleBasePriceChange(this)"
                                                   style="width: 18px; height: 18px; accent-color: var(--accent-color); cursor: pointer;" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if ((Model.AdditionalPrices != null && Model.AdditionalPrices.Any()) && 
                     (Model.Prices != null && Model.Prices.Any()))
                {
                    <hr style="border: none; border-top: 2px solid var(--border-color); margin: 24px 0;" />
                }

                @if (Model.Prices != null && Model.Prices.Any())
                {
                    <div class="price-label"> @GetLocalized("Цены опций:", "Option prices:", "Optionspreise:")</div>
                    <div class="price-table-wrapper">
                        <table class="price-table" id="optionsTable">
                            <thead>
                                <tr>
                                    <th class="name-col" style="width: 40%;">@GetLocalized("Название опции", "Option Name", "Optionsbezeichnung")</th>
                                    
                                    <th style="width: 25%;">@GetLocalized("Цена без тюнинга", "Price without tuning", "Preis ohne Änderungen")</th>
                                    <th style="width: 25%;">@GetLocalized("Доплата при тюнинге", "Tuning Surcharge", "Tuning-Aufpreis")</th>
                                    <th style="width: 10%;">@GetLocalized("Выбрать", "Select", "Wählen")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var priceItem in Model.Prices)
                                {
                                    string basePrice = language switch
                                    {
                                        "en" => priceItem.base_price_eng,
                                        "de" => priceItem.base_price_ger,
                                        _ => priceItem.base_price
                                    };

                                    string proPrice = language switch
                                    {
                                        "en" => priceItem.pro_price_eng,
                                        "de" => priceItem.pro_price_ger,
                                        _ => priceItem.pro_price
                                    };

                                    string info = language switch
                                    {
                                        "en" => priceItem.info_eng,
                                        "de" => priceItem.info_ger,
                                        _ => priceItem.info_ru
                                    };

                                    string currency = language switch
                                    {
                                        "en" => "$",
                                        "de" => "€",
                                        _ => "₽"
                                    };

                                    bool hasInfo = !string.IsNullOrEmpty(info);
                                    bool isNumeric = IsPriceNumeric(proPrice);
                                    bool isBaseIncompatible = basePrice != null && basePrice.Trim() == "-";
                                    bool isProIncompatible = proPrice != null && proPrice.Trim() == "-";
                                    
                                    <tr id="option-row-@priceItem.id" class="@(isBaseIncompatible || isProIncompatible ? "incompatible-row" : "")">
                                                                                <td class="name-col">
                                            <div class="price-name-desktop">
                                                <div class="price-name-cell">
                                                    <span>@priceItem.GetName(language)</span>
                                                    @if (hasInfo)
                                                    {
                                                        <button class="info-btn info-btn-inline"
        onclick='openInfoModal(@Json.Serialize(priceItem.GetName(language)), @Json.Serialize(info))'
        title="@GetLocalized("Подробнее", "More info", "Mehr Info")">
                                                            <i class="fas fa-info-circle"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            @if (hasInfo)
                                            {
                                                <span class="price-name-mobile-wrap"><table class="name-info-table" style="width:max-content;max-width:100%;border-collapse:collapse;border:none;margin:0;padding:0;table-layout:auto;vertical-align:middle;">
                                                    <tr>
                                                        <td class="name-cell" style="border:none;padding:0;margin:0;width:auto;vertical-align:middle;">@priceItem.GetName(language)</td>
                                                        <td class="info-cell" style="border:none;padding:0 0 0 4px;margin:0;width:1%;white-space:nowrap;vertical-align:middle;text-align:left;">
                                                            <button type="button" class="info-btn"
        onclick='openInfoModal(@Json.Serialize(priceItem.GetName(language)), @Json.Serialize(info))'
        title="@GetLocalized("Подробнее", "More info", "Mehr Info")">
    <i class="fas fa-info-circle"></i>
</button>
                                                        </td>
                                                    </tr>
                                                </table></span>
                                            }
                                            else
                                            {
                                                <span class="price-name-mobile">@priceItem.GetName(language)</span>
                                            }
                                        </td>
                                        <td style="text-align: center;" class="@(isBaseIncompatible ? "price-cell-incompatible" : "")">
                                            @if (!string.IsNullOrEmpty(basePrice))
                                            {
                                                if (isBaseIncompatible)
                                                {
                                                    <span>—</span>
                                                }
                                                else
                                                {
                                                    @basePrice @currency
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: var(--text-muted);">—</span>
                                            }
                                        </td>
                                        <td style="text-align: center;" class="@(isProIncompatible ? "price-cell-incompatible" : "")">
                                            @if (!string.IsNullOrEmpty(proPrice))
                                            {
                                                if (isProIncompatible)
                                                {
                                                    <span>—</span>
                                                }
                                                else
                                                {
                                                    @proPrice @currency
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: var(--text-muted);">—</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="checkbox" 
                                                   class="additional-option"
                                                   value="@priceItem.id"
                                                   data-base-price="@basePrice"
                                                   data-pro-price="@proPrice"
                                                   data-name="@priceItem.GetName(language)"
                                                   data-is-numeric="@isNumeric.ToString().ToLower()"
                                                   onchange="updateTotalPrice()"
                                                   style="width: 18px; height: 18px; accent-color: var(--accent-color); cursor: pointer;" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if ((Model.AdditionalPrices == null || !Model.AdditionalPrices.Any()) && 
                     (Model.Prices == null || !Model.Prices.Any()))
                {
                    <div class="price-empty">
                        @if (!string.IsNullOrEmpty(Model.PriceRu))
                        {
                            @Model.PriceRu
                        }
                        else
                        {
                            @GetLocalized("Цены не указаны", "No prices available", "Keine Preise verfügbar")
                        }
                    </div>
                }

                <!-- ===== ИТОГОВАЯ ЦЕНА ===== -->
                <div class="price-result">
                    <div class="price-result-row">
                        <span class="price-result-label">@GetLocalized("Итого:", "Total:", "Gesamt:")</span>
                        <span class="price-result-value" id="finalTotalPrice">0</span>
                        <span class="price-result-currency" id="finalCurrency">@GetCurrency()</span>
                        <span class="price-result-text" id="priceResultText"></span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- БЛОК: ГРАФИКИ -->
            <!-- ============================================================ -->
            @if (Model.Grafics != null && Model.Grafics.Any())
            {
                <div class="info-block">
                    <div class="info-title"> @GetLocalized("Графики", "Graphs", "Grafiken")</div>
                    <div class="grafic-grid">
                        <div class="grafic-mini-grid">
                            @foreach (var grafic in Model.Grafics)
                            {
                                string graficName = language switch
                                {
                                    "en" => grafic.NameEng,
                                    "de" => grafic.NameGer,
                                    _ => grafic.Name
                                };
                                if (string.IsNullOrEmpty(graficName)) graficName = grafic.Name;
                                
                                <div class="grafic-mini-item" onclick="openGraficModal(@grafic.id)">
                                    @if (!string.IsNullOrEmpty(grafic.image))
                                    {
                                        <img src="@GetGraficImagePath(grafic.image)" alt="@graficName" class="mini-image" loading="lazy" 
                                             onerror="this.style.display='none'; this.parentElement.querySelector('.mini-icon')?.style?.removeProperty('display');" />
                                        <span class="mini-icon" style="display: none;"><i class="fas fa-chart-line"></i></span>
                                    }
                                    else
                                    {
                                        <span class="mini-icon"><i class="fas fa-chart-line"></i></span>
                                    }
                                    <div class="mini-name">@graficName</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- МОДАЛЬНОЕ ОКНО ДЛЯ ГРАФИКОВ -->
    <!-- ============================================================ -->
    <div class="modal-overlay" id="graficModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeGraficModal()">
                <i class="fas fa-times"></i>
            </button>

            <h2 class="modal-title">
                <i class="fas fa-chart-line"></i>
                <span id="modalGraficName">@GetLocalized("График", "Graph", "Grafik")</span>
                <span style="font-size: 16px; font-weight: 400; color: var(--text-muted); margin-left: 12px;">@Model.Brand @Model.Model</span>
            </h2>

            <div class="modal-grafic-container">
                <img id="modalGraficImage" src="" alt="" style="display: none;" />
                <div id="modalGraficNoImage" class="no-image" style="display: none;">
                    <i class="fas fa-image"></i>
                    <p>@GetLocalized("Изображение отсутствует", "No image", "Kein Bild")</p>
                </div>
                <div id="modalGraficDescription" style="margin-top: 20px; font-size: 15px; color: var(--text-secondary); line-height: 1.7; text-align: center; padding: 0 10px; max-width: 700px; margin-left: auto; margin-right: auto;"></div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- МОДАЛЬНОЕ ОКНО ДЛЯ ИНФОРМАЦИИ -->
    <!-- ============================================================ -->
    <div class="info-modal-overlay" id="infoModal">
    <div class="info-modal-content" id="infoModalContent">
        <button type="button" class="info-modal-close" id="infoModalCloseBtn">&times;</button>
        <div class="info-modal-title">
            <i class="fas fa-info-circle"></i>
            <span id="infoModalTitle">Информация</span>
        </div>
        <div class="info-modal-body" id="infoModalBody"></div>
    </div>
</div>

    <!-- ===== ПЕРЕДАЁМ ДАННЫЕ В JAVASCRIPT ===== -->
    <script>
        // Передаём данные дополнительных цен в JavaScript
        window.additionalPricesData = @Html.Raw(Json.Serialize(Model.AdditionalPrices));
    </script>

    <script>
        // ==========================================
        // ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА
        // ==========================================
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ==========================================
        // ПРОКРУТКА К ЦЕНАМ
        // ==========================================
        function scrollToPrices() {
            var pricesSection = document.getElementById('prices-section');
            if (pricesSection) {
                var offset = 20;
                var elementPosition = pricesSection.getBoundingClientRect().top;
                var offsetPosition = elementPosition + window.pageYOffset - offset;
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        }

        // ==========================================
        // МОДАЛЬНОЕ ОКНО ИНФОРМАЦИИ
        // ==========================================
        function openInfoModal(title, info) {
    var modal = document.getElementById('infoModal');
    var titleEl = document.getElementById('infoModalTitle');
    var bodyEl = document.getElementById('infoModalBody');
    if (!modal || !titleEl || !bodyEl) return;

    titleEl.textContent = title || '';
    var text = (info == null ? '' : String(info));
    bodyEl.innerHTML = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\r\n/g, '<br>')
        .replace(/\n/g, '<br>')
        .replace(/\r/g, '<br>');

    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeInfoModal() {
    var modal = document.getElementById('infoModal');
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
}

document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('infoModal');
    var closeBtn = document.getElementById('infoModalCloseBtn');
    var content = document.getElementById('infoModalContent');

    if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            closeInfoModal();
        });
    }

    if (modal) {
        modal.addEventListener('click', function (e) {
            // клик именно по затемнению, не по окну
            if (e.target === modal) {
                closeInfoModal();
            }
        });
    }

    if (content) {
        content.addEventListener('click', function (e) {
            e.stopPropagation();
        });
    }
});

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeInfoModal();
});

        // ==========================================
        // МОДАЛЬНОЕ ОКНО ГРАФИКОВ
        // ==========================================
        var graficList = @Html.Raw(Json.Serialize(Model.Grafics));

        function openGraficModal(graficId) {
            var modal = document.getElementById('graficModal');
            if (!modal) return;

            var selected = graficList.find(function(g) { return g.id === graficId; });
            if (!selected) {
                console.warn('График с ID ' + graficId + ' не найден');
                return;
            }

            var imageEl = document.getElementById('modalGraficImage');
            var nameEl = document.getElementById('modalGraficName');
            var noImageEl = document.getElementById('modalGraficNoImage');
            var descEl = document.getElementById('modalGraficDescription');

            var lang = document.cookie.split('; ').find(function(row) { return row.startsWith('Language='); })?.split('=')[1] || 'ru';

            var graficName = selected.name;
            if (lang === 'en' && selected.nameEng) graficName = selected.nameEng;
            else if (lang === 'de' && selected.nameGer) graficName = selected.nameGer;
            if (!graficName) graficName = selected.name || 'График';

            var description = '';
            if (lang === 'en') description = selected.descriptionEng || '';
            else if (lang === 'de') description = selected.descriptionGer || '';
            else description = selected.descriptionRu || '';

            if (selected.image && selected.image !== '') {
                var imagePath = selected.image;
                if (!imagePath.startsWith('http://') && !imagePath.startsWith('https://') && !imagePath.startsWith('/')) {
                    imagePath = '/shared-fotos/grafics/' + imagePath;
                }
                imageEl.src = imagePath;
                imageEl.alt = graficName || 'График';
                imageEl.style.display = 'block';
                noImageEl.style.display = 'none';
            } else {
                imageEl.style.display = 'none';
                noImageEl.style.display = 'flex';
            }

            nameEl.textContent = graficName;

            if (descEl) {
                if (description) {
                    descEl.textContent = description;
                    descEl.style.display = 'block';
                } else {
                    descEl.style.display = 'none';
                }
            }

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeGraficModal() {
            var modal = document.getElementById('graficModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            var modal = document.getElementById('graficModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeGraficModal();
                    }
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeGraficModal();
                }
            });
        });

        // ==========================================
        // КОНСТРУКТОР ЦЕН
        // ==========================================
        function getCurrency() {
            var lang = document.cookie.split('; ').find(function(row) { return row.startsWith('Language='); })?.split('=')[1] || 'ru';
            var currencies = {
                'ru': '₽',
                'en': '$',
                'de': '€'
            };
            return currencies[lang] || '₽';
        }

        function parsePrice(priceStr) {
            if (!priceStr) return 0;
            var cleaned = priceStr.replace(/[^0-9.,]/g, '').replace(',', '.');
            return parseFloat(cleaned) || 0;
        }

        function isPriceNumeric(priceStr) {
            if (!priceStr) return false;
            var cleaned = priceStr.trim();
            if (cleaned.length === 0) return false;
            var firstChar = cleaned[0];
            return (firstChar >= '0' && firstChar <= '9') || firstChar === '.' || firstChar === ',';
        }

        function isZeroPriceValue(priceStr) {
            if (!priceStr) return false;
            var cleaned = priceStr.replace(",", ".").replace(/[^0-9.]/g, '');
            if (cleaned === '') return false;
            var num = parseFloat(cleaned);
            return !isNaN(num) && num === 0;
        }

        function getSelectedBasePrice() {
            var selected = document.querySelector('.base-price-radio:checked');
            if (!selected) return null;
            
            return {
                price: selected.getAttribute('data-price'),
                name: selected.getAttribute('data-name'),
                isZero: selected.getAttribute('data-is-zero') === 'true',
                priceControler: parseInt(selected.getAttribute('data-price-controler')) || 0,
                freeIds: selected.dataset.freeIds ? selected.dataset.freeIds.split(',').map(Number) : [],
                baseIds: selected.dataset.baseIds ? selected.dataset.baseIds.split(',').map(Number) : [],
                proIds: selected.dataset.proIds ? selected.dataset.proIds.split(',').map(Number) : [],
                unselectedMode: parseInt(selected.dataset.unselectedMode) || 0
            };
        }

        function getSelectedAdditionalOptions() {
            var checkboxes = document.querySelectorAll('.additional-option:checked');
            var options = [];
            checkboxes.forEach(function(cb) {
                options.push({
                    id: cb.value,
                    basePrice: cb.getAttribute('data-base-price'),
                    proPrice: cb.getAttribute('data-pro-price'),
                    name: cb.getAttribute('data-name'),
                    isNumeric: cb.getAttribute('data-is-numeric') === 'true',
                    isChecked: cb.checked
                });
            });
            return options;
        }

        // ==========================================
        // АВТОМАТИЧЕСКИЙ ВЫБОР БАЗОВОЙ ЦЕНЫ
        // ==========================================

        function autoSelectBasePrice() {
            var radios = document.querySelectorAll('.base-price-radio');
            if (radios.length === 0) return;
            
            // Если уже есть выбранная, не трогаем
            var alreadyChecked = document.querySelector('.base-price-radio:checked');
            if (alreadyChecked) return;
            
            // Если только одна цена — выбираем её (даже если это "Без тюнинга")
            if (radios.length === 1) {
                radios[0].checked = true;
                handleBasePriceChange(radios[0]);
                return;
            }
            
            // Если несколько цен — выбираем первую, у которой цена НЕ равна 0
            for (var i = 0; i < radios.length; i++) {
                var isZero = radios[i].getAttribute('data-is-zero') === 'true';
                if (!isZero) {
                    radios[i].checked = true;
                    handleBasePriceChange(radios[i]);
                    return;
                }
            }
            
            // Если все цены равны 0 — выбираем первую
            if (radios.length > 0) {
                radios[0].checked = true;
                handleBasePriceChange(radios[0]);
            }
        }

        function updateTotalPrice() {
            var currency = getCurrency();
            var baseSelected = getSelectedBasePrice();
            var additionalOptions = getSelectedAdditionalOptions();
            
            var basePriceValue = 0;
            var totalPrice = 0;
            var priceControler = 0;
            var hasIncompatibleOption = false;
            var incompatibleOptionName = '';
            var incompatibleOptionId = null;
            
            if (baseSelected) {
                basePriceValue = parsePrice(baseSelected.price);
                priceControler = baseSelected.priceControler;
                totalPrice = basePriceValue;
            }
            
            // ===== ОСНОВНАЯ ЛОГИКА: price_controler определяет какие цены брать =====
            var useProPrices = priceControler === 1;
            var isExtended = priceControler === 2;
            var additionalTotal = 0;
            var textOptionsList = [];
            
            additionalOptions.forEach(function(opt) {
                var priceToUse = opt.basePrice;
                var optionId = parseInt(opt.id);
                
                if (isExtended && baseSelected) {
                    // ===== РАСШИРЕННЫЙ ВЫБОР (price_controler == 2) =====
                    var freeIds = baseSelected.freeIds || [];
                    var baseIds = baseSelected.baseIds || [];
                    var proIds = baseSelected.proIds || [];
                    var unselectedMode = baseSelected.unselectedMode || 0;
                    
                    if (freeIds.includes(optionId)) {
                        priceToUse = '0';
                    } else if (baseIds.includes(optionId)) {
                        priceToUse = opt.basePrice;
                    } else if (proIds.includes(optionId)) {
                        priceToUse = opt.proPrice;
                    } else {
                        if (unselectedMode === 1) {
                            priceToUse = opt.proPrice || opt.basePrice;
                        } else {
                            priceToUse = opt.basePrice;
                        }
                    }
                } else if (useProPrices) {
                    if (opt.proPrice && opt.proPrice.trim() !== '') {
                        priceToUse = opt.proPrice;
                    } else {
                        priceToUse = opt.basePrice;
                    }
                } else {
                    priceToUse = opt.basePrice;
                }
                
                // ===== ПРОВЕРКА: ЕСЛИ В ЦЕНЕ СТОИТ "-", ОПЦИЯ НЕСОВМЕСТИМА =====
                if (priceToUse && priceToUse.trim() === '-') {
                    hasIncompatibleOption = true;
                    incompatibleOptionName = opt.name;
                    incompatibleOptionId = opt.id;
                    return;
                }
                
                if (!priceToUse || priceToUse.trim() === '') {
                    priceToUse = opt.proPrice || opt.basePrice;
                }
                
                if (isZeroPriceValue(priceToUse)) {
                    return;
                }
                
                var isNumeric = isPriceNumeric(priceToUse);
                
                if (isNumeric) {
                    var priceValue = parsePrice(priceToUse);
                    additionalTotal += priceValue;
                } else {
                    if (priceToUse && priceToUse.trim() !== '') {
                        textOptionsList.push(opt.name);
                    }
                }
            });
            
            // ===== ПРОВЕРКА НА НЕСОВМЕСТИМЫЕ ОПЦИИ =====
            if (hasIncompatibleOption) {
                document.querySelectorAll('#optionsTable tbody tr').forEach(function(row) {
                    row.classList.remove('incompatible-row');
                });
                if (incompatibleOptionId) {
                    var incompatibleRow = document.getElementById('option-row-' + incompatibleOptionId);
                    if (incompatibleRow) {
                        incompatibleRow.classList.add('incompatible-row');
                    }
                }
                
                var lang = document.cookie.split('; ').find(function(row) { return row.startsWith('Language='); })?.split('=')[1] || 'ru';
                var errorMsg = '';
                if (lang === 'en') {
                    errorMsg = '⚠️ ' + incompatibleOptionName + ': Selected option is not compatible with the selected tuning';
                } else if (lang === 'de') {
                    errorMsg = '⚠️ ' + incompatibleOptionName + ': Ausgewählte Option ist nicht mit dem gewählten Tuning kompatibel';
                } else {
                    errorMsg = '⚠️ ' + incompatibleOptionName + ': Выбранная опция не совместима с выбранным тюнингом';
                }
                
                document.getElementById('finalTotalPrice').textContent = '—';
                document.getElementById('finalTotalPrice').className = 'price-result-value incompatible';
                document.getElementById('finalCurrency').textContent = '';
                
                var textSpan = document.getElementById('priceResultText');
                textSpan.className = 'price-result-text incompatible';
                textSpan.innerHTML = '<span style="font-size: 14px; font-weight: 600;">' + errorMsg + '</span>';
                textSpan.style.display = 'inline';
                return;
            }
            
            document.querySelectorAll('#optionsTable tbody tr').forEach(function(row) {
                row.classList.remove('incompatible-row');
            });
            
            document.getElementById('finalTotalPrice').className = 'price-result-value';
            document.getElementById('priceResultText').className = 'price-result-text';
            
            totalPrice = basePriceValue + additionalTotal;
            
            document.getElementById('finalTotalPrice').textContent = totalPrice.toLocaleString();
            document.getElementById('finalCurrency').textContent = currency;
            
            var textSpan = document.getElementById('priceResultText');
            if (textOptionsList.length > 0) {
                textSpan.innerHTML = ' <span style="font-weight: 600; color: var(--accent-color);">+</span> ' + textOptionsList.join(' + ');
                textSpan.style.display = 'inline';
            } else {
                textSpan.textContent = '';
                textSpan.style.display = 'none';
            }
        }

        function handleBasePriceChange(radio) {
            var selected = document.querySelector('.base-price-radio:checked');
            if (selected) {
                var packageId = parseInt(selected.value);
                
                var packageData = null;
                if (window.additionalPricesData) {
                    packageData = window.additionalPricesData.find(function(p) {
                        return p.id === packageId;
                    });
                }
                
                if (packageData && packageData.price_controler === 2) {
                    selected.dataset.freeIds = packageData.free_price_ids || '';
                    selected.dataset.baseIds = packageData.base_price_ids || '';
                    selected.dataset.proIds = packageData.pro_price_ids || '';
                    selected.dataset.unselectedMode = packageData.unselected_price_mode || 0;
                } else {
                    selected.dataset.freeIds = '';
                    selected.dataset.baseIds = '';
                    selected.dataset.proIds = '';
                    selected.dataset.unselectedMode = '0';
                }
            }
            updateTotalPrice();
        }

        function resetAllOptions() {
            document.querySelectorAll('.additional-option').forEach(function(cb) {
                cb.checked = false;
            });
            
            var firstNonZero = document.querySelector('.base-price-radio[data-is-zero="false"]');
            if (firstNonZero) {
                firstNonZero.checked = true;
                handleBasePriceChange(firstNonZero);
            } else {
                var zeroRadio = document.querySelector('.base-price-radio[data-is-zero="true"]');
                if (zeroRadio) {
                    zeroRadio.checked = true;
                    handleBasePriceChange(zeroRadio);
                }
            }
            updateTotalPrice();
        }

        function selectAllOptions() {
            document.querySelectorAll('.additional-option').forEach(function(cb) {
                cb.checked = true;
            });
            updateTotalPrice();
        }

        // ==========================================
        // ОСНОВНАЯ ЛОГИКА ДРОПДАУНОВ
        // ==========================================
        function normalizeString(str) {
            return str ? str.replace(/_/g, ' ') : '';
        }

        var modelBrand = normalizeString(@Html.Raw(Json.Serialize(Model.Brand)));
        var modelModel = normalizeString(@Html.Raw(Json.Serialize(Model.Model)));
        var modelGeneration = normalizeString(@Html.Raw(Json.Serialize(Model.Generation)));
        var modelEngine = normalizeString(@Html.Raw(Json.Serialize(Model.Engine)));

        var currentCar = {
            brand: modelBrand,
            model: modelModel,
            generation: modelGeneration,
            engine: modelEngine
        };

        var originalCar = {
            brand: modelBrand,
            model: modelModel,
            generation: modelGeneration,
            engine: modelEngine
        };

        function isCarChanged() {
            return currentCar.brand !== originalCar.brand ||
                   currentCar.model !== originalCar.model ||
                   currentCar.generation !== originalCar.generation ||
                   currentCar.engine !== originalCar.engine;
        }

        function isCarComplete() {
            return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine;
        }

        function getPlaceholder(fieldName) {
            var lang = document.cookie.split('; ').find(function(row) { return row.startsWith('Language='); })?.split('=')[1] || 'ru';
            var placeholders = {
                brand: { ru: 'Выберите бренд', en: 'Select brand', de: 'Marke wählen' },
                model: { ru: 'Выберите модель', en: 'Select model', de: 'Modell wählen' },
                generation: { ru: 'Выберите поколение', en: 'Select generation', de: 'Generation wählen' },
                engine: { ru: 'Выберите двигатель', en: 'Select engine', de: 'Motor wählen' }
            };
            return placeholders[fieldName]?.[lang] || 'Выберите';
        }

        function updateDropdown(fieldName, options) {
            var desktopId = fieldName + 'Dropdown';
            var currentValue = currentCar[fieldName];
            var dropdown = document.getElementById(desktopId);
            if (!dropdown) return;

            dropdown.innerHTML = '';
            var emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = getPlaceholder(fieldName);
            dropdown.appendChild(emptyOption);

            if (options && options.length > 0) {
                options.forEach(function(option) {
                    var opt = document.createElement('option');
                    opt.value = option;
                    opt.textContent = option;
                    dropdown.appendChild(opt);
                });
            }

            if (currentValue) {
                var searchValue = currentValue.replace(/_/g, ' ').trim();
                var found = false;
                
                for (var i = 0; i < dropdown.options.length; i++) {
                    var optionValue = dropdown.options[i].value.replace(/_/g, ' ').trim();
                    if (optionValue === searchValue) {
                        dropdown.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                
                if (!found) {
                    dropdown.value = currentValue;
                }
            }
            
            dropdown.disabled = false;
            dropdown.onchange = function() { 
                handleChange(fieldName, this.value); 
            };
        }

        function updateHeaderDropdowns(fieldName, options) {
            var headerId = fieldName + 'DropdownHeader';
            var currentValue = currentCar[fieldName];
            var dropdown = document.getElementById(headerId);
            if (!dropdown) return;

            dropdown.innerHTML = '';
            var emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = '--';
            dropdown.appendChild(emptyOption);

            if (options && options.length > 0) {
                options.forEach(function(option) {
                    var opt = document.createElement('option');
                    opt.value = option;
                    opt.textContent = option;
                    dropdown.appendChild(opt);
                });
            }

            if (currentValue) {
                var searchValue = currentValue.replace(/_/g, ' ').trim();
                var found = false;
                
                for (var i = 0; i < dropdown.options.length; i++) {
                    var optionValue = dropdown.options[i].value.replace(/_/g, ' ').trim();
                    if (optionValue === searchValue) {
                        dropdown.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                
                if (!found) {
                    dropdown.value = currentValue;
                }
            }
            
            dropdown.disabled = false;
            dropdown.onchange = function() { 
                handleChange(fieldName, this.value); 
            };
        }

        function syncAllDropdowns() {
            var fields = ['brand', 'model', 'generation', 'engine'];
            fields.forEach(function(field) {
                var value = currentCar[field];
                var mainDropdown = document.getElementById(field + 'Dropdown');
                var headerDropdown = document.getElementById(field + 'DropdownHeader');
                
                if (mainDropdown && value) {
                    var found = false;
                    for (var i = 0; i < mainDropdown.options.length; i++) {
                        if (mainDropdown.options[i].value === value) {
                            mainDropdown.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        mainDropdown.value = value;
                    }
                }
                if (headerDropdown && value) {
                    var found = false;
                    for (var i = 0; i < headerDropdown.options.length; i++) {
                        if (headerDropdown.options[i].value === value) {
                            headerDropdown.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        headerDropdown.value = value;
                    }
                }
            });
        }

        function resetDropdownsAfter(fieldName) {
            var fields = ['brand', 'model', 'generation', 'engine'];
            var startIndex = fields.indexOf(fieldName) + 1;
            for (var i = startIndex; i < fields.length; i++) {
                var desktop = document.getElementById(fields[i] + 'Dropdown');
                var header = document.getElementById(fields[i] + 'DropdownHeader');
                if (desktop && !currentCar[fields[i]]) {
                    desktop.innerHTML = '<option value="">-- ' + getPlaceholder(fields[i]) + ' --</option>';
                    desktop.disabled = true;
                    desktop.onchange = null;
                }
                if (header && !currentCar[fields[i]]) {
                    header.innerHTML = '<option value="">--</option>';
                    header.disabled = true;
                    header.onchange = null;
                }
                currentCar[fields[i]] = '';
            }
        }

        function resetHeaderDropdownsAfter(fieldName) {
            var fields = ['brand', 'model', 'generation', 'engine'];
            var startIndex = fields.indexOf(fieldName) + 1;
            for (var i = startIndex; i < fields.length; i++) {
                var dropdown = document.getElementById(fields[i] + 'DropdownHeader');
                if (dropdown && !currentCar[fields[i]]) {
                    dropdown.innerHTML = '<option value="">--</option>';
                    dropdown.disabled = true;
                    dropdown.onchange = null;
                }
            }
        }

        function updateAllDropdownValues() {
            var fields = ['brand', 'model', 'generation', 'engine'];
            fields.forEach(function(field) {
                var value = currentCar[field];
                var mainDropdown = document.getElementById(field + 'Dropdown');
                var headerDropdown = document.getElementById(field + 'DropdownHeader');
                
                if (mainDropdown && value) {
                    var found = false;
                    for (var i = 0; i < mainDropdown.options.length; i++) {
                        if (mainDropdown.options[i].value === value) {
                            mainDropdown.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                    if (!found && mainDropdown.value !== value) {
                        mainDropdown.value = value;
                    }
                }
                if (headerDropdown && value) {
                    var found = false;
                    for (var i = 0; i < headerDropdown.options.length; i++) {
                        if (headerDropdown.options[i].value === value) {
                            headerDropdown.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                    if (!found && headerDropdown.value !== value) {
                        headerDropdown.value = value;
                    }
                }
            });
        }

        function updateDropdownLabels() {
            var getCookie = function(name) {
                var value = '; ' + document.cookie;
                var parts = value.split('; ' + name + '=');
                if (parts.length === 2) return parts.pop().split(';').shift();
                return 'ru';
            };
            var lang = getCookie('Language');

            var labels = {
                brand: { ru: ' БРЕНД', en: ' BRAND', de: ' MARKE' },
                model: { ru: ' МОДЕЛЬ', en: ' MODEL', de: ' MODELL' },
                generation: { ru: ' ПОКОЛЕНИЕ', en: ' GENERATION', de: ' GENERATION' },
                engine: { ru: ' ДВИГАТЕЛЬ', en: ' ENGINE', de: ' MOTOR' }
            };

            var brandLabel = document.getElementById('brandLabel');
            var modelLabel = document.getElementById('modelLabel');
            var generationLabel = document.getElementById('generationLabel');
            var engineLabel = document.getElementById('engineLabel');

            if (brandLabel) brandLabel.textContent = labels.brand[lang] || ' БРЕНД';
            if (modelLabel) modelLabel.textContent = labels.model[lang] || ' МОДЕЛЬ';
            if (generationLabel) generationLabel.textContent = labels.generation[lang] || ' ПОКОЛЕНИЕ';
            if (engineLabel) engineLabel.textContent = labels.engine[lang] || ' ДВИГАТЕЛЬ';

            var brandLabelHeader = document.getElementById('brandLabelHeader');
            var modelLabelHeader = document.getElementById('modelLabelHeader');
            var generationLabelHeader = document.getElementById('generationLabelHeader');
            var engineLabelHeader = document.getElementById('engineLabelHeader');

            if (brandLabelHeader) brandLabelHeader.textContent = labels.brand[lang] || ' БРЕНД';
            if (modelLabelHeader) modelLabelHeader.textContent = labels.model[lang] || ' МОДЕЛЬ';
            if (generationLabelHeader) generationLabelHeader.textContent = labels.generation[lang] || ' ПОКОЛЕНИЕ';
            if (engineLabelHeader) engineLabelHeader.textContent = labels.engine[lang] || ' ДВИГАТЕЛЬ';
        }

        function showSuccessButton() {
            var btnDesktop = document.getElementById('successButton');
            var btnMobile = document.getElementById('successButtonMobile');
            
            if (isCarComplete() && isCarChanged()) {
                if (btnDesktop) btnDesktop.style.display = 'block';
                if (btnMobile) btnMobile.classList.add('show');
            } else {
                if (btnDesktop) btnDesktop.style.display = 'none';
                if (btnMobile) btnMobile.classList.remove('show');
            }
        }

        function hideSuccessButton() {
            var btnDesktop = document.getElementById('successButton');
            var btnMobile = document.getElementById('successButtonMobile');
            if (btnDesktop) btnDesktop.style.display = 'none';
            if (btnMobile) btnMobile.classList.remove('show');
        }

        function onSuccessButtonClick() {
            if (!isCarComplete()) {
                var lang = document.cookie.split('; ').find(function(row) { return row.startsWith('Language='); })?.split('=')[1] || 'ru';
                var msg = lang === 'ru' ? 'Заполните все поля' : (lang === 'en' ? 'Fill all fields' : 'Alle Felder ausfüllen');
                alert(msg);
                return;
            }
            
            function transliterate(text) {
                if (!text) return '';
                var map = {
                    'А': 'A', 'Б': 'B', 'В': 'V', 'Г': 'G', 'Д': 'D',
                    'Е': 'E', 'Ё': 'Yo', 'Ж': 'Zh', 'З': 'Z', 'И': 'I',
                    'Й': 'Y', 'К': 'K', 'Л': 'L', 'М': 'M', 'Н': 'N',
                    'О': 'O', 'П': 'P', 'Р': 'R', 'С': 'S', 'Т': 'T',
                    'У': 'U', 'Ф': 'F', 'Х': 'Kh', 'Ц': 'Ts', 'Ч': 'Ch',
                    'Ш': 'Sh', 'Щ': 'Sch', 'Ъ': '', 'Ы': 'Y', 'Ь': '',
                    'Э': 'E', 'Ю': 'Yu', 'Я': 'Ya',
                    'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd',
                    'е': 'e', 'ё': 'yo', 'ж': 'zh', 'з': 'z', 'и': 'i',
                    'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n',
                    'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't',
                    'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch',
                    'ш': 'sh', 'щ': 'sch', 'ъ': '', 'ы': 'y', 'ь': '',
                    'э': 'e', 'ю': 'yu', 'я': 'ya'
                };
                var result = '';
                for (var i = 0; i < text.length; i++) {
                    var ch = text[i];
                    result += map[ch] || ch;
                }
                return result;
            }
            
            var brand = transliterate(currentCar.brand).replace(/ /g, '_');
            var model = transliterate(currentCar.model).replace(/ /g, '_');
            var generation = transliterate(currentCar.generation).replace(/ /g, '_');
            var engine = transliterate(currentCar.engine).replace(/ /g, '_');
            
            window.location.href = '/' + encodeURIComponent(brand) + '/' + encodeURIComponent(model) + '/' + encodeURIComponent(generation) + '/' + encodeURIComponent(engine);
        }

        async function loadInitialData() {
            try {
                var response = await fetch('/Home/GetInitialData');
                var result = await response.json();
                
                function transliterate(text) {
                    if (!text) return '';
                    var map = {
                        'А': 'A', 'Б': 'B', 'В': 'V', 'Г': 'G', 'Д': 'D',
                        'Е': 'E', 'Ё': 'Yo', 'Ж': 'Zh', 'З': 'Z', 'И': 'I',
                        'Й': 'Y', 'К': 'K', 'Л': 'L', 'М': 'M', 'Н': 'N',
                        'О': 'O', 'П': 'P', 'Р': 'R', 'С': 'S', 'Т': 'T',
                        'У': 'U', 'Ф': 'F', 'Х': 'Kh', 'Ц': 'Ts', 'Ч': 'Ch',
                        'Ш': 'Sh', 'Щ': 'Sch', 'Ъ': '', 'Ы': 'Y', 'Ь': '',
                        'Э': 'E', 'Ю': 'Yu', 'Я': 'Ya',
                        'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd',
                        'е': 'e', 'ё': 'yo', 'ж': 'zh', 'з': 'z', 'и': 'i',
                        'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n',
                        'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't',
                        'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch',
                        'ш': 'sh', 'щ': 'sch', 'ъ': '', 'ы': 'y', 'ь': '',
                        'э': 'e', 'ю': 'yu', 'я': 'ya'
                    };
                    var result = '';
                    for (var i = 0; i < text.length; i++) {
                        var ch = text[i];
                        result += map[ch] || ch;
                    }
                    return result;
                }
                
                updateDropdown('brand', result.options);
                updateHeaderDropdowns('brand', result.options);
                
                ['brandDropdown', 'brandDropdownHeader'].forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el && modelBrand) {
                        el.value = modelBrand;
                        el.disabled = false;
                    }
                });

                if (modelBrand) {
                    var modelResponse = await fetch('/Home/ProcessSelection', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            car: { brand: modelBrand, model: '', generation: '', engine: '' },
                            changedField: 'brand',
                            newValue: modelBrand
                        })
                    });
                    var modelResult = await modelResponse.json();
                    
                    if (modelResult.nextField === 'model' && modelResult.options) {
                        updateDropdown('model', modelResult.options);
                        updateHeaderDropdowns('model', modelResult.options);
                        
                        ['modelDropdown', 'modelDropdownHeader'].forEach(function(id) {
                            var el = document.getElementById(id);
                            if (el && modelModel) {
                                var found = false;
                                var valueClean = modelModel.replace(/_/g, ' ').trim();
                                var valueTranslit = transliterate(valueClean);
                                
                                for (var i = 0; i < el.options.length; i++) {
                                    var optionClean = el.options[i].value.replace(/_/g, ' ').trim();
                                    var optionTranslit = transliterate(optionClean);
                                    if (optionTranslit === valueTranslit) {
                                        el.selectedIndex = i;
                                        found = true;
                                        break;
                                    }
                                }
                                if (!found) {
                                    el.value = modelModel;
                                }
                                el.disabled = false;
                            }
                        });
                    }

                    if (modelModel) {
                        var genResponse = await fetch('/Home/ProcessSelection', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                car: { brand: modelBrand, model: modelModel, generation: '', engine: '' },
                                changedField: 'model',
                                newValue: modelModel
                            })
                        });
                        var genResult = await genResponse.json();
                        
                        if (genResult.nextField === 'generation' && genResult.options) {
                            updateDropdown('generation', genResult.options);
                            updateHeaderDropdowns('generation', genResult.options);
                            
                            ['generationDropdown', 'generationDropdownHeader'].forEach(function(id) {
                                var el = document.getElementById(id);
                                if (el && modelGeneration) {
                                    var found = false;
                                    var valueClean = modelGeneration.replace(/_/g, ' ').trim();
                                    var valueTranslit = transliterate(valueClean);
                                    
                                    for (var i = 0; i < el.options.length; i++) {
                                        var optionClean = el.options[i].value.replace(/_/g, ' ').trim();
                                        var optionTranslit = transliterate(optionClean);
                                        if (optionTranslit === valueTranslit) {
                                            el.selectedIndex = i;
                                            found = true;
                                            break;
                                        }
                                    }
                                    if (!found) {
                                        el.value = modelGeneration;
                                    }
                                    el.disabled = false;
                                }
                            });
                        }

                        if (modelGeneration) {
                            var engineResponse = await fetch('/Home/ProcessSelection', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    car: { brand: modelBrand, model: modelModel, generation: modelGeneration, engine: '' },
                                    changedField: 'generation',
                                    newValue: modelGeneration
                                })
                            });
                            var engineResult = await engineResponse.json();
                            
                            if (engineResult.nextField === 'engine' && engineResult.options) {
                                updateDropdown('engine', engineResult.options);
                                updateHeaderDropdowns('engine', engineResult.options);
                                
                                setTimeout(function() {
                                    if (modelEngine) {
                                        var mainDD = document.getElementById('engineDropdown');
                                        if (mainDD) {
                                            var found = false;
                                            var valueClean = modelEngine.replace(/_/g, ' ').trim();
                                            var valueTranslit = transliterate(valueClean);
                                            
                                            for (var i = 0; i < mainDD.options.length; i++) {
                                                var optionClean = mainDD.options[i].value.replace(/_/g, ' ').trim();
                                                var optionTranslit = transliterate(optionClean);
                                                if (optionTranslit === valueTranslit) {
                                                    mainDD.selectedIndex = i;
                                                    found = true;
                                                    break;
                                                }
                                            }
                                            if (!found) {
                                                mainDD.value = modelEngine;
                                            }
                                            mainDD.disabled = false;
                                        }
                                        
                                        var headerDD = document.getElementById('engineDropdownHeader');
                                        if (headerDD) {
                                            var found = false;
                                            var valueClean = modelEngine.replace(/_/g, ' ').trim();
                                            var valueTranslit = transliterate(valueClean);
                                            
                                            for (var i = 0; i < headerDD.options.length; i++) {
                                                var optionClean = headerDD.options[i].value.replace(/_/g, ' ').trim();
                                                var optionTranslit = transliterate(optionClean);
                                                if (optionTranslit === valueTranslit) {
                                                    headerDD.selectedIndex = i;
                                                    found = true;
                                                    break;
                                                }
                                            }
                                            if (!found) {
                                                headerDD.value = modelEngine;
                                            }
                                            headerDD.disabled = false;
                                        }
                                    }
                                }, 100);
                            }
                        }
                    }
                }

                showSuccessButton();
                syncAllDropdowns();

            } catch (error) {
                console.error('Ошибка загрузки данных:', error);
            }
        }

        async function handleChange(fieldName, newValue) {
            try {
                var response = await fetch('/Home/ProcessSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        car: currentCar, 
                        changedField: fieldName, 
                        newValue: newValue 
                    })
                });
                var result = await response.json();
                updateCar(result.car);
                updateUI(result);
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        function updateCar(newCar) {
            currentCar = {
                brand: newCar.brand || '',
                model: newCar.model || '',
                generation: newCar.generation || '',
                engine: newCar.engine || ''
            };
        }

        function updateUI(result) {
            updateAllDropdownValues();
            
            if (result.nextField && result.nextField !== 'complete') {
                var fieldName = result.nextField;
                var options = result.options || [];
                
                updateDropdown(fieldName, options);
                updateHeaderDropdowns(fieldName, options);
            }
            
            showSuccessButton();
            
            if (result.nextField && result.nextField !== 'complete') {
                resetDropdownsAfter(result.nextField);
                resetHeaderDropdownsAfter(result.nextField);
            }
            
            syncAllDropdowns();
        }

        document.addEventListener('DOMContentLoaded', async function() {
            updateDropdownLabels();
            await loadInitialData();
            showSuccessButton();
            syncAllDropdowns();
            
            // ===== АВТОМАТИЧЕСКИЙ ВЫБОР БАЗОВОЙ ЦЕНЫ =====
            setTimeout(function() {
                autoSelectBasePrice();
                updateTotalPrice();
            }, 400);
        });
    </script>
</body>
