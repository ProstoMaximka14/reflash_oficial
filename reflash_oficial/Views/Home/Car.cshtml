@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "Автомобиль выбран!";

    // Читаем язык из URL или cookie
    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    // Получаем тему из cookie
    var currentTheme = Context.Request.Cookies["Theme"] ?? "dark";

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }
    string AddLineBreaks(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Replace("\n", "<br>").Replace("\r\n", "<br>");
    }
}

<!DOCTYPE html>
<html lang="@language" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — Performance Tuning</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ==========================================
                           CSS ПЕРЕМЕННЫЕ ДЛЯ ТЕМ
                           ========================================== */

        /* Светлая тема (по умолчанию) */
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-overlay: rgba(255, 255, 255, 0.9);
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --gradient-start: #f8f9fa;
            --gradient-end: #e9ecef;
            --slider-overlay: rgba(255, 255, 255, 0.4);
            --block-bg: #ffffff;
            --block-border: #e0e0e0;
            --frame-bg: rgba(255, 255, 255, 0.95);
            --frame-text: #1a1a2e;
            --price-bg-start: #2196F3;
            --price-bg-end: #1976D2;
            --price-text: #ffffff;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
        }

        /* Тёмная тема */
        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-overlay: rgba(10, 10, 15, 0.9);
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.5);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --gradient-start: #111118;
            --gradient-end: #0D0D14;
            --slider-overlay: rgba(0, 0, 0, 0.85);
            --block-bg: #111118;
            --block-border: #252530;
            --frame-bg: rgba(10, 10, 15, 0.85);
            --frame-text: #E8E8F0;
            --price-bg-start: #FF3A2F;
            --price-bg-end: #B8251A;
            --price-text: #ffffff;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
        }

        /* ==========================================
                           ОБЩИЕ СТИЛИ
                           ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.5;
            transition: background 0.3s ease, color 0.3s ease;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 10px;
        }

        /* ===== ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА ===== */
        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: var(--bg-overlay);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid var(--border-color);
            box-shadow: 0 8px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        .lang-btn:hover {
            color: var(--text-primary);
            background: rgba(255,58,47,0.1);
        }

        .lang-btn.active {
            background: var(--accent-color);
            color: white;
            box-shadow: 0 0 8px rgba(255,58,47,0.5);
        }

        .page-wrapper {
            display: flex;
            gap: 30px;
            
            width: 100%;
            margin: 0 auto;
            padding: 0 0 60px;
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .dropdowns-sidebar {
            flex: 0 0 280px;
            position: sticky;
            top: 100px;
            align-self: flex-start;
        }

        .dropdowns-mobile {
            display: none;
            margin-top: 30px;
        }

        .dropdowns-card {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 20px 35px -12px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .dropdown-section {
            margin-bottom: 20px;
        }

        .dropdown-section:last-of-type {
            margin-bottom: 0;
        }

        .dropdown-label {
            display: block;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--accent-color);
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .dropdown-select {
            width: 100%;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 500;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', monospace;
        }

        .dropdown-select:focus {
            border-color: var(--accent-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,58,47,0.2);
        }

        .dropdown-select:disabled {
            background: var(--bg-secondary);
            color: var(--text-muted);
            cursor: not-allowed;
            border-color: var(--border-color);
        }

        .btn-next {
            width: 100%;
            margin-top: 12px;
            padding: 12px 20px;
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            border: none;
            border-radius: 40px;
            color: white;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s;
            display: none;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(255,58,47,0.3);
        }

        .btn-next:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255,58,47,0.4);
        }

        .container {
            flex: 1;
            min-width: 0;
        }

        .car-header {
            background: var(--bg-card);
            border-radius: 28px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
            transition: background 0.3s ease, border-color 0.3s ease;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .car-header-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .car-image-container {
            background: var(--bg-secondary);
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .car-image {
            max-width: 100%;
            max-height: 280px;
            object-fit: contain;
            border-radius: 12px;
        }

        .specs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            background: var(--bg-secondary);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid var(--border-color);
        }

        .spec-item {
            background: var(--bg-card);
            padding: 16px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid var(--border-color);
            transition: all 0.2s;
        }

        .spec-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }

        .spec-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 8px;
        }

        .spec-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .info-block {
            background: var(--bg-card);
            border-radius: 24px;
            padding: 28px 32px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
            transition: all 0.25s;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .info-block:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
        }

        .info-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
            letter-spacing: -0.3px;
            color: var(--text-primary);
        }

        .info-content {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.7;
        }

        .info-content-item {
            margin-bottom: 15px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 12px;
        }

        .info-content-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .price-block {
            background: linear-gradient(135deg, var(--price-bg-start), var(--price-bg-end));
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 24px;
            text-align: center;
            color: var(--price-text);
        }

        .price-label {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            opacity: 0.85;
            margin-bottom: 8px;
        }

        .price-value {
            font-size: 42px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 8px;
        }

        .price-note {
            font-size: 12px;
            opacity: 0.7;
        }

        /* ===== СТИЛИ ДЛЯ ТАБЛИЦЫ ЦЕН (с переменными) ===== */
        .price-table-wrapper {
            margin-top: 15px;
            overflow-x: auto;
            border-radius: 12px;
            padding: 4px;
        }

        .price-table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 10px;
            overflow: hidden;
        }

        .price-table thead th {
            padding: 14px 20px;
            text-align: left;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-primary);
            border-bottom: 2px solid var(--accent-color);
        }

        .price-table thead th:not(:first-child) {
            text-align: center;
        }

        .price-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background 0.2s ease;
        }

        .price-table tbody tr:last-child {
            border-bottom: none;
        }

        .price-table tbody tr:hover {
            background: var(--bg-secondary);
        }

        .price-table tbody td {
            padding: 14px 20px;
            text-align: left;
            font-weight: 500;
            color: var(--text-primary);
        }

        .price-table tbody td:not(:first-child) {
            text-align: center;
            font-weight: 700;
            font-size: 18px;
            color: var(--text-secondary);
        }

        .price-name-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .price-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            background: var(--accent-color);
            border-radius: 50%;
            flex-shrink: 0;
        }

        .price-empty {
            font-size: 18px;
            color: var(--text-muted);
        }

        .actions-bottom {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 32px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 0.8px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            border: none;
            font-family: 'Inter', sans-serif;
        }

        .btn-primary {
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(255,58,47,0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255,58,47,0.4);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
            transform: translateY(-2px);
        }

        .highlight {
            border-left: 3px solid var(--accent-color);
        }

        /* ==========================================
        СТИЛИ ДЛЯ ГРАФИКОВ (МИНИ-КАРТОЧКИ)
        ========================================== */
        .grafic-section {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .grafic-section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
            letter-spacing: -0.3px;
            color: var(--text-primary);
        }

        .grafic-mini-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .grafic-mini-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .grafic-mini-item:hover {
            transform: translateY(-4px);
            border-color: var(--accent-color);
            box-shadow: 0 8px 25px var(--shadow-hover);
        }

        .grafic-mini-item .mini-image {
            width: 100%;
            height: 120px;
            object-fit: contain;
            border-radius: 8px;
            background: var(--bg-secondary);
            transition: transform 0.3s ease;
        }

        .grafic-mini-item:hover .mini-image {
            transform: scale(1.05);
        }

        .grafic-mini-item .mini-name {
            margin-top: 10px;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-primary);
        }

        .grafic-mini-item .mini-icon {
            font-size: 32px;
            color: var(--accent-color);
            margin-bottom: 8px;
            display: block;
        }

        .grafic-mini-item .click-hint {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 6px;
        }

        /* ==========================================
            МОДАЛЬНОЕ ОКНО ДЛЯ ГРАФИКОВ (ОДИН ГРАФИК)
         ========================================== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(8px);
            animation: fadeIn 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background: var(--bg-card);
            border-radius: 24px;
            padding: 35px;
            max-width: 900px;
            width: 95%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            position: relative;
            animation: slideUp 0.3s ease;
        }

        .modal-close {
            position: sticky;
            top: 0;
            float: right;
            background: var(--accent-color);
            border: none;
            color: white;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            font-size: 22px;
            cursor: pointer;
            z-index: 10;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(255, 58, 47, 0.3);
        }

        .modal-close:hover {
            transform: rotate(90deg);
            box-shadow: 0 6px 25px rgba(255, 58, 47, 0.5);
        }

        .modal-title {
            color: var(--text-primary);
            margin-bottom: 25px;
            font-size: 28px;
            font-weight: 700;
            margin-top: 0;
        }

        .modal-title i {
            color: var(--accent-color);
            margin-right: 12px;
        }

        .modal-title span {
            font-size: 16px;
            font-weight: 400;
            color: var(--text-muted);
            margin-left: 12px;
        }

        .modal-grafic-container {
            text-align: center;
            padding: 20px 0;
        }

        .modal-grafic-container img {
            max-width: 100%;
            max-height: 70vh;
            object-fit: contain;
            border-radius: 8px;
        }

        .modal-grafic-container .no-image {
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
        }

        .modal-grafic-container .no-image i {
            font-size: 64px;
            opacity: 0.3;
        }

        .modal-footer {
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
        }

        .modal-footer i {
            margin-right: 8px;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @@keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-content::-webkit-scrollbar {
            width: 6px;
        }

        .modal-content::-webkit-scrollbar-track {
            background: var(--bg-secondary);
            border-radius: 10px;
        }

        .modal-content::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 10px;
        }

        /* ==========================================
                           АДАПТИВНОСТЬ
                           ========================================== */
        @@media (max-width: 1024px) {
            .page-wrapper {
                width: 95%;
                gap: 24px;
            }
            .dropdowns-sidebar {
                flex: 0 0 260px;
            }
        }

        @@media (max-width: 900px) {
            .page-wrapper {
                flex-direction: column;
            }
            .dropdowns-sidebar {
                display: none;
            }
            .dropdowns-mobile {
                display: block;
            }
            .car-header-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            .price-value {
                font-size: 32px;
            }
            .price-table tbody td:not(:first-child) {
                font-size: 16px;
            }
        }

        @@media (max-width: 768px) {
            body {
                padding: 0;
            }
            .page-wrapper {
                width: 100%;
                padding: 80px 16px 40px;
            }
            .language-switcher {
                top: 12px;
                right: 12px;
                padding: 4px 10px;
            }
            .lang-btn {
                padding: 4px 10px;
                font-size: 11px;
            }
            .car-header {
                padding: 20px;
            }
            .info-block {
                padding: 20px;
            }
            .info-title {
                font-size: 18px;
            }
            .specs-grid {
                gap: 12px;
                padding: 16px;
            }
            .spec-item {
                padding: 12px;
            }
            .actions-bottom {
                flex-direction: column;
                align-items: center;
            }
            .btn {
                width: 100%;
                max-width: 280px;
            }
            .price-table thead th,
            .price-table tbody td {
                padding: 10px 12px;
                font-size: 13px;
            }
            .price-table tbody td:not(:first-child) {
                font-size: 15px;
            }
            .info-content-item {
                margin-bottom: 10px;
                padding-bottom: 10px;
            }

            .grafic-mini-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .grafic-mini-item .mini-image {
                height: 100px;
            }

            .modal-content {
                padding: 20px;
                max-height: 95vh;
                border-radius: 16px;
                width: 98%;
            }
            .modal-title {
                font-size: 22px;
            }
            .modal-close {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }
            .modal-grafic-container img {
                max-height: 50vh;
            }
        }

        @@media (max-width: 480px) {
            .specs-grid {
                grid-template-columns: 1fr;
            }
            .price-value {
                font-size: 28px;
            }
            .price-table thead th,
            .price-table tbody td {
                padding: 8px 10px;
                font-size: 12px;
            }
            .price-table tbody td:not(:first-child) {
                font-size: 14px;
            }
            .price-name-cell span {
                font-size: 13px;
            }

            .grafic-mini-grid {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .grafic-mini-item {
                padding: 12px;
            }

            .grafic-mini-item .mini-image {
                height: 80px;
            }

            .grafic-mini-item .mini-name {
                font-size: 12px;
            }

            .modal-content {
                padding: 16px;
            }
            .modal-title {
                font-size: 18px;
            }
            .btn {
                padding: 12px 25px;
                font-size: 14px;
            }
            .modal-close {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }
            .modal-grafic-container img {
                max-height: 40vh;
            }
        }

        /* ==========================================
           ОПТИМИЗАЦИЯ ДЛЯ ПК - ВСЁ ПОМЕЩАЕТСЯ БЕЗ СКРОЛА
           ========================================== */
        
        /* Для ПК (ширина >= 1024px и высота >= 800px) */
        @@media (min-width: 1024px) and (min-height: 800px) {
            /* Уменьшаем отступы */
            .page-wrapper { padding: 0 0 20px !important; gap: 20px !important; }
            
            /* Шапка с авто */
            .car-header { padding: 12px 20px !important; margin-bottom: 10px !important; }
            .car-image { max-height: 160px !important; }
            .specs-grid { gap: 10px !important; padding: 12px !important; }
            .spec-item { padding: 10px 14px !important; }
            .spec-value { font-size: 14px !important; }
            .spec-label { font-size: 10px !important; }
            
            /* Инфо-блоки */
            .info-block { padding: 12px 20px !important; margin-bottom: 8px !important; }
            .info-title { font-size: 15px !important; margin-bottom: 6px !important; padding-bottom: 4px !important; }
            .info-content { font-size: 13px !important; line-height: 1.4 !important; }
            .info-content-item { margin-bottom: 6px !important; padding-bottom: 6px !important; }
            
            /* Цены */
            .price-label { font-size: 11px !important; margin-bottom: 4px !important; }
            .price-value { font-size: 30px !important; }
            .price-table-wrapper { margin-top: 8px !important; }
            .price-table thead th { padding: 6px 14px !important; font-size: 11px !important; }
            .price-table tbody td { padding: 6px 14px !important; font-size: 12px !important; }
            .price-table tbody td:not(:first-child) { font-size: 15px !important; }
            
            /* Графики */
            .grafic-section { margin-top: 8px !important; margin-bottom: 8px !important; }
            .grafic-section-title { font-size: 15px !important; margin-bottom: 8px !important; padding-bottom: 4px !important; }
            .grafic-mini-grid { gap: 10px !important; }
            .grafic-mini-item { padding: 8px !important; }
            .grafic-mini-item .mini-image { height: 70px !important; }
            .grafic-mini-item .click-hint { font-size: 9px !important; margin-top: 4px !important; }
            
            /* Кнопки */
            .actions-bottom { margin-top: 6px !important; gap: 12px !important; }
            .btn { padding: 8px 24px !important; font-size: 13px !important; }
            
            /* Сайдбар */
            .dropdowns-sidebar { flex: 0 0 240px !important; top: 70px !important; }
            .dropdowns-card { padding: 16px !important; }
            .dropdown-section { margin-bottom: 10px !important; }
            .dropdown-select { padding: 8px 12px !important; font-size: 13px !important; }
            .btn-next { padding: 8px 16px !important; font-size: 12px !important; margin-top: 4px !important; }
            .dropdown-label { font-size: 10px !important; margin-bottom: 4px !important; }
            
            /* Переключатель языка */
            .language-switcher { top: 12px !important; right: 12px !important; padding: 4px 10px !important; }
            .lang-btn { padding: 4px 10px !important; font-size: 12px !important; }
        }

        /* Для больших ПК мониторов (27"+) */
        @@media (min-width: 1400px) and (min-height: 900px) {
            .car-image { max-height: 200px !important; }
            .info-content { font-size: 14px !important; }
            .grafic-mini-item .mini-image { height: 90px !important; }
        }

        /* Дополнительное сжатие для ПК с маленьким экраном (высота < 800px) */
        @@media (min-width: 1024px) and (max-height: 799px) {
            .page-wrapper { padding: 0 0 10px !important; gap: 10px !important; }
            .car-header { padding: 8px 12px !important; margin-bottom: 6px !important; }
            .car-image { max-height: 120px !important; }
            .specs-grid { gap: 6px !important; padding: 8px !important; }
            .spec-item { padding: 6px 10px !important; }
            .spec-value { font-size: 12px !important; }
            .spec-label { font-size: 9px !important; margin-bottom: 2px !important; }
            .info-block { padding: 8px 14px !important; margin-bottom: 6px !important; }
            .info-title { font-size: 13px !important; margin-bottom: 4px !important; padding-bottom: 3px !important; }
            .info-content { font-size: 12px !important; line-height: 1.3 !important; }
            .info-content-item { margin-bottom: 4px !important; padding-bottom: 4px !important; }
            .price-value { font-size: 24px !important; }
            .price-table thead th { padding: 4px 10px !important; font-size: 10px !important; }
            .price-table tbody td { padding: 4px 10px !important; font-size: 11px !important; }
            .price-table tbody td:not(:first-child) { font-size: 13px !important; }
            .grafic-section { margin-top: 6px !important; margin-bottom: 6px !important; }
            .grafic-section-title { font-size: 13px !important; margin-bottom: 4px !important; padding-bottom: 3px !important; }
            .grafic-mini-grid { gap: 6px !important; }
            .grafic-mini-item { padding: 6px !important; }
            .grafic-mini-item .mini-image { height: 50px !important; }
            .grafic-mini-item .click-hint { font-size: 8px !important; }
            .actions-bottom { margin-top: 4px !important; gap: 8px !important; }
            .btn { padding: 6px 16px !important; font-size: 11px !important; }
            .dropdowns-sidebar { flex: 0 0 200px !important; top: 60px !important; }
            .dropdowns-card { padding: 10px !important; }
            .dropdown-section { margin-bottom: 6px !important; }
            .dropdown-select { padding: 6px 10px !important; font-size: 11px !important; }
            .btn-next { padding: 6px 12px !important; font-size: 11px !important; margin-top: 2px !important; }
            .dropdown-label { font-size: 9px !important; margin-bottom: 2px !important; }
            .language-switcher { top: 8px !important; right: 8px !important; padding: 3px 8px !important; }
            .lang-btn { padding: 3px 8px !important; font-size: 10px !important; }
        }
    </style>
</head>
<body>

    
    <div class="page-wrapper">
        <div class="dropdowns-sidebar">
            <div class="dropdowns-card">
                <div class="dropdown-section">
                    <label class="dropdown-label" id="brandLabel">⚡ БРЕНД</label>
                    <select class="dropdown-select" id="brandDropdown" disabled>
                        <option value="">-- Загрузка... --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="modelLabel">🔧 МОДЕЛЬ</label>
                    <select class="dropdown-select" id="modelDropdown" disabled>
                        <option value="">-- Сначала бренд --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="generationLabel">📅 ПОКОЛЕНИЕ</label>
                    <select class="dropdown-select" id="generationDropdown" disabled>
                        <option value="">-- Сначала модель --</option>
                    </select>
                </div>
                <div class="dropdown-section">
                    <label class="dropdown-label" id="engineLabel">🔥 ДВИГАТЕЛЬ</label>
                    <select class="dropdown-select" id="engineDropdown" disabled>
                        <option value="">-- Сначала поколение --</option>
                    </select>
                </div>
                <button class="btn-next" id="successButton" onclick="onSuccessButtonClick()">
                    ПЕРЕЙТИ →
                </button>
            </div>
        </div>

        <div class="container">
            <div class="car-header">
                <div class="car-header-grid">
                    <div class="car-image-container">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Brand @Model.Model" class="car-image" />
                        }
                        else
                        {
                            <div style="color: var(--text-muted); padding: 40px; text-align: center;">
                                <i class="fas fa-car" style="font-size: 48px; margin-bottom: 12px; display: block;"></i>
                                @GetLocalized("Нет изображения", "No image", "Kein Bild")
                            </div>
                        }
                    </div>
                    <div class="specs-grid">
                        <div class="spec-item">
                            <span class="spec-label">БРЕНД</span>
                            <span class="spec-value">@Model.Brand</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">МОДЕЛЬ</span>
                            <span class="spec-value">@Model.Model</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">ПОКОЛЕНИЕ</span>
                            <span class="spec-value">@Model.Generation</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">ДВИГАТЕЛЬ</span>
                            <span class="spec-value">@Model.Engine</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== ABOUT (О автомобиле) ===== -->
            <div class="info-block highlight">
                <div class="info-title">ℹ️ @GetLocalized("О автомобиле", "About the Car", "Über das Auto")</div>
                <div class="info-content">
                    @if (Model.Abouts != null && Model.Abouts.Any())
                    {
                        var items = Model.Abouts.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger));
                        <text>@string.Join(" ", items)</text>
                    }
                    else
                    {
                        <text>@Model.AboutRu</text>
                    }
                </div>
            </div>

            <!-- ===== RESULT (Результаты чип-тюнинга) ===== -->
            <div class="info-block">
                <div class="info-title">📈 @GetLocalized("Результаты чип-тюнинга", "Chip Tuning Results", "Chip-Tuning Ergebnisse")</div>
                <div class="info-content">
                    @if (Model.PriResults != null && Model.PriResults.Any())
                    {
                        var items = Model.PriResults.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger));
                        <text>@string.Join(" ", items)</text>
                    }
                    else
                    {
                        <text>@Html.Raw(AddLineBreaks(Model.ResultRu))</text>
                    }
                </div>
            </div>

            <!-- ===== ENGINE CONTROL (Управление двигателем) ===== -->
            <div class="info-block">
                <div class="info-title">⚙️ @GetLocalized("Управление двигателем", "Engine Control", "Motorsteuerung")</div>
                 <div class="info-content">
                    @if (Model.Engine_controlers != null && Model.Engine_controlers.Any())
                    {
                        var items = Model.Engine_controlers.Select(item => GetLocalized(item.text_ru, item.text_eng, item.text_ger));
                        <text>@string.Join(" ", items)</text>
                    }
                    else
                    {
                        <text>@Html.Raw(AddLineBreaks(Model.EngineControlRu))</text>
                    }
                </div>
            </div>

            <!-- ===== PRICE (Цены) ===== -->
            <div class="info-block">
                <div class="price-label">💰 @GetLocalized("СТОИМОСТЬ", "PRICE", "PREIS")</div>

                @if (Model.Prices != null && Model.Prices.Any())
                {
                    <div class="price-table-wrapper">
                        <table class="price-table">
                            <thead>
                                <tr>
                                    <th>@GetLocalized("Название опции", "Option Name", "Optionsbezeichnung")</th>
                                    <th>@GetLocalized("Цена на стоке", "Stock Price", "Aktienkurs")</th>
                                    <th>@GetLocalized("Доплата при тюнинге", "Tuning Surcharge", "Tuning-Aufpreis")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var priceItem in Model.Prices)
                                {
                                    <tr>
                                        <td>
                                            <div class="price-name-cell">
                                                <span class="price-dot"></span>
                                                <span>@GetLocalized(priceItem.name_ru, priceItem.name_eng, priceItem.name_ger)</span>
                                            </div>
                                        </td>
                                        <td class="price-base">
                                            @if (string.IsNullOrEmpty(priceItem.base_price))
                                            {
                                                <text>—</text>
                                            }
                                            else if (int.TryParse(priceItem.base_price, out int baseNum))
                                            {
                                                @baseNum.ToString("N0") <text>₽</text>
                                            }
                                            else
                                            {
                                                @priceItem.base_price
                                            }
                                        </td>
                                        <td class="price-pro">
                                            @if (string.IsNullOrEmpty(priceItem.pro_price))
                                            {
                                                <text>—</text>
                                            }
                                            else if (int.TryParse(priceItem.pro_price, out int proNum))
                                            {
                                                @proNum.ToString("N0") <text>₽</text>
                                            }
                                            else
                                            {
                                                @priceItem.pro_price
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="price-empty">
                        @if (!string.IsNullOrEmpty(Model.PriceRu))
                        {
                            @Model.PriceRu
                        }
                        else
                        {
                            @GetLocalized("Цены не указаны", "No prices available", "Keine Preise verfügbar")
                        }
                    </div>
                }

                <div class="price-note" style="margin-top: 15px; text-align: center; font-size: 13px; color: var(--text-muted);">
                    *@GetLocalized("включая все работы и настройки", "including all works and tuning", "inklusive aller Arbeiten")
                </div>
            </div>

            <!-- ===== GRAFIC (Графики - ВНИЗУ) ===== -->
            @if (Model.Grafics != null && Model.Grafics.Any())
            {
                <div class="grafic-section">
                    <div class="grafic-section-title">📊 @GetLocalized("Графики", "Graphs", "Grafiken")</div>
                    <div class="grafic-mini-grid">
                        @foreach (var grafic in Model.Grafics)
                        {
                            <div class="grafic-mini-item" onclick="openGraficModal(@grafic.id)">
                                @if (!string.IsNullOrEmpty(grafic.image))
                                {
                                    <img src="@grafic.image" alt="@grafic.Name" class="mini-image" loading="lazy" />
                                }
                                else
                                {
                                    <span class="mini-icon"><i class="fas fa-chart-line"></i></span>
                                }
                                
                                <div class="click-hint">@GetLocalized("Нажмите для увеличения", "Click to enlarge", "Zum Vergrößern klicken")</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="actions-bottom">
                <a href="/" class="btn btn-secondary">← @GetLocalized("Вернуться к выбору", "Back to Selection", "Zurück zur Auswahl")</a>
                <button class="btn btn-primary" onclick="alert('@GetLocalized("Функция заказа временно недоступна", "Order function temporarily unavailable", "Bestellfunktion vorübergehend nicht verfügbar")')">
                    @GetLocalized("ЗАКАЗАТЬ ЧИП-ТЮНИНГ", "ORDER CHIP TUNING", "CHIP-TUNING BESTELLEN")
                </button>
            </div>

            <div class="dropdowns-mobile">
                <div class="dropdowns-card">
                    <div class="dropdown-section">
                        <label class="dropdown-label" id="brandLabelMobile">⚡ БРЕНД</label>
                        <select class="dropdown-select" id="brandDropdownMobile" disabled>
                            <option value="">-- Загрузка... --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label" id="modelLabelMobile">🔧 МОДЕЛЬ</label>
                        <select class="dropdown-select" id="modelDropdownMobile" disabled>
                            <option value="">-- Сначала бренд --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label" id="generationLabelMobile">📅 ПОКОЛЕНИЕ</label>
                        <select class="dropdown-select" id="generationDropdownMobile" disabled>
                            <option value="">-- Сначала модель --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label" id="engineLabelMobile">🔥 ДВИГАТЕЛЬ</label>
                        <select class="dropdown-select" id="engineDropdownMobile" disabled>
                            <option value="">-- Сначала поколение --</option>
                        </select>
                    </div>
                    <button class="btn-next" id="successButtonMobile" onclick="onSuccessButtonClickMobile()">
                        ПЕРЕЙТИ →
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== МОДАЛЬНОЕ ОКНО ДЛЯ ГРАФИКОВ (ОДИН ГРАФИК) ===== -->
    <div class="modal-overlay" id="graficModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeGraficModal()">
                <i class="fas fa-times"></i>
            </button>

            <h2 class="modal-title">
                <i class="fas fa-chart-line"></i>
                <span id="modalGraficName">@GetLocalized("График", "Graph", "Grafik")</span>
                <span style="font-size: 16px; font-weight: 400; color: var(--text-muted); margin-left: 12px;">@Model.Brand @Model.Model</span>
            </h2>

            <div class="modal-grafic-container">
                <img id="modalGraficImage" src="" alt="" style="display: none;" />
                <div id="modalGraficNoImage" class="no-image" style="display: none;">
                    <i class="fas fa-image"></i>
                </div>
            </div>

            <div class="modal-footer">
                <i class="fas fa-info-circle"></i>
                @GetLocalized("Нажмите на изображение для увеличения", "Click on image to enlarge", "Klicken Sie auf das Bild zum Vergrößern")
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА
        // ==========================================
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ==========================================
        // МОДАЛЬНОЕ ОКНО ГРАФИКОВ (ОДИН ГРАФИК)
        // ==========================================

        // Получаем список графиков из модели
        var graficList = @Json.Serialize(Model.Grafics);

        function openGraficModal(graficId) {
            const modal = document.getElementById('graficModal');
            if (!modal) return;

            // Находим график по ID
            const selected = graficList.find(g => g.id === graficId);

            if (!selected) {
                console.warn('График с ID ' + graficId + ' не найден');
                return;
            }

            // Обновляем содержимое модального окна
            const imageEl = document.getElementById('modalGraficImage');
            const nameEl = document.getElementById('modalGraficName');
            const noImageEl = document.getElementById('modalGraficNoImage');

            // Обновляем изображение
            if (selected.image && selected.image !== '') {
                imageEl.src = selected.image;
                imageEl.alt = selected.name || 'График';
                imageEl.style.display = 'block';
                noImageEl.style.display = 'none';
            } else {
                imageEl.style.display = 'none';
                noImageEl.style.display = 'flex';
            }

            // 🔥 Обновляем название графика в модальном окне
            nameEl.textContent = selected.name || '@Html.Raw(GetLocalized("График", "Graph", "Grafik"))';

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeGraficModal() {
            const modal = document.getElementById('graficModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        // Закрытие по клику на фон
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('graficModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        closeGraficModal();
                    }
                });
            }

            // Закрытие по ESC
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeGraficModal();
                }
            });
        });

        // ==========================================
        // ДРОПДАУНЫ
        // ==========================================
        function updateDropdownLabels() {
            const getCookie = (name) => {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return 'ru';
            };
            const lang = getCookie('Language');

            const labels = {
                brand: { ru: '⚡ БРЕНД', en: '⚡ BRAND', de: '⚡ MARKE' },
                model: { ru: '🔧 МОДЕЛЬ', en: '🔧 MODEL', de: '🔧 MODELL' },
                generation: { ru: '📅 ПОКОЛЕНИЕ', en: '📅 GENERATION', de: '📅 GENERATION' },
                engine: { ru: '🔥 ДВИГАТЕЛЬ', en: '🔥 ENGINE', de: '🔥 MOTOR' }
            };

            document.getElementById('brandLabel').textContent = labels.brand[lang] || '⚡ БРЕНД';
            document.getElementById('modelLabel').textContent = labels.model[lang] || '🔧 МОДЕЛЬ';
            document.getElementById('generationLabel').textContent = labels.generation[lang] || '📅 ПОКОЛЕНИЕ';
            document.getElementById('engineLabel').textContent = labels.engine[lang] || '🔥 ДВИГАТЕЛЬ';

            document.getElementById('brandLabelMobile').textContent = labels.brand[lang] || '⚡ БРЕНД';
            document.getElementById('modelLabelMobile').textContent = labels.model[lang] || '🔧 МОДЕЛЬ';
            document.getElementById('generationLabelMobile').textContent = labels.generation[lang] || '📅 ПОКОЛЕНИЕ';
            document.getElementById('engineLabelMobile').textContent = labels.engine[lang] || '🔥 ДВИГАТЕЛЬ';
        }

        let currentCar = {
            brand: '@Model.Brand',
            model: '@Model.Model',
            generation: '@Model.Generation',
            engine: '@Model.Engine'
        };

        function syncDropdowns() {
            const brandDesktop = document.getElementById('brandDropdown');
            const brandMobile = document.getElementById('brandDropdownMobile');
            const modelDesktop = document.getElementById('modelDropdown');
            const modelMobile = document.getElementById('modelDropdownMobile');
            const genDesktop = document.getElementById('generationDropdown');
            const genMobile = document.getElementById('generationDropdownMobile');
            const engineDesktop = document.getElementById('engineDropdown');
            const engineMobile = document.getElementById('engineDropdownMobile');

            if (brandDesktop && brandMobile && brandDesktop.value !== brandMobile.value) brandMobile.value = brandDesktop.value;
            if (modelDesktop && modelMobile && modelDesktop.value !== modelMobile.value) modelMobile.value = modelDesktop.value;
            if (genDesktop && genMobile && genDesktop.value !== genMobile.value) genMobile.value = genDesktop.value;
            if (engineDesktop && engineMobile && engineDesktop.value !== engineMobile.value) engineMobile.value = engineDesktop.value;
        }

        function isCarComplete() {
            return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine;
        }

        function showSuccessButton() {
            const btnDesktop = document.getElementById('successButton');
            const btnMobile = document.getElementById('successButtonMobile');
            if (btnDesktop) btnDesktop.style.display = 'block';
            if (btnMobile) btnMobile.style.display = 'block';
        }

        function hideSuccessButton() {
            const btnDesktop = document.getElementById('successButton');
            const btnMobile = document.getElementById('successButtonMobile');
            if (btnDesktop) btnDesktop.style.display = 'none';
            if (btnMobile) btnMobile.style.display = 'none';
        }

        function onSuccessButtonClick() {
            if (!isCarComplete()) {
                const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
                const msg = lang === 'ru' ? 'Заполните все поля' : (lang === 'en' ? 'Fill all fields' : 'Alle Felder ausfüllen');
                alert(msg);
                return;
            }
            const brand = encodeURIComponent(currentCar.brand);
            const model = encodeURIComponent(currentCar.model);
            const generation = encodeURIComponent(currentCar.generation);
            const engine = encodeURIComponent(currentCar.engine);
            window.location.href = `/Home/Car/${brand}/${model}/${generation}/${engine}`;
        }

        function onSuccessButtonClickMobile() {
            onSuccessButtonClick();
        }

        async function loadInitialData() {
            try {
                const response = await fetch('/Home/GetInitialData');
                const result = await response.json();
                updateCar(result.car);
                if (result.nextField === 'brand') {
                    const placeholder = getPlaceholder('brand');
                    ['brandDropdown', 'brandDropdownMobile'].forEach(id => {
                        const dropdown = document.getElementById(id);
                        if (dropdown) {
                            dropdown.innerHTML = `<option value="">-- ${placeholder} --</option>`;
                            if (result.options && result.options.length > 0) {
                                result.options.forEach(option => {
                                    const opt = document.createElement('option');
                                    opt.value = option;
                                    opt.textContent = option;
                                    dropdown.appendChild(opt);
                                });
                            }
                            dropdown.disabled = false;
                            dropdown.onchange = function() { handleChange('brand', this.value); };
                        }
                    });
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function handleChange(fieldName, newValue) {
            try {
                const response = await fetch('/Home/ProcessSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ car: currentCar, changedField: fieldName, newValue: newValue })
                });
                const result = await response.json();
                updateCar(result.car);
                updateUI(result);
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        function updateCar(newCar) {
            currentCar = {
                brand: newCar.brand || '',
                model: newCar.model || '',
                generation: newCar.generation || '',
                engine: newCar.engine || ''
            };
        }

        function updateUI(result) {
            updateDropdownValues();
            if (result.nextField && result.nextField !== 'complete') updateDropdown(result.nextField, result.options);
            if (result.nextField === 'complete') showSuccessButton(); else hideSuccessButton();
            if (result.nextField && result.nextField !== 'complete') resetDropdownsAfter(result.nextField);
            syncDropdowns();
        }

        function updateDropdownValues() {
            const fields = ['brand', 'model', 'generation', 'engine'];
            fields.forEach(field => {
                const value = currentCar[field];
                const desktop = document.getElementById(field + 'Dropdown');
                const mobile = document.getElementById(field + 'DropdownMobile');
                if (desktop && value) desktop.value = value;
                if (mobile && value) mobile.value = value;
            });
        }

        function updateDropdown(fieldName, options) {
            const desktopId = fieldName + 'Dropdown';
            const mobileId = fieldName + 'DropdownMobile';
            const currentValue = currentCar[fieldName];

            [desktopId, mobileId].forEach(id => {
                const dropdown = document.getElementById(id);
                if (!dropdown) return;

                dropdown.innerHTML = '';
                const emptyOption = document.createElement('option');
                emptyOption.value = '';
                emptyOption.textContent = getPlaceholder(fieldName);
                dropdown.appendChild(emptyOption);

                if (options && options.length > 0) {
                    options.forEach(option => {
                        const opt = document.createElement('option');
                        opt.value = option;
                        opt.textContent = option;
                        dropdown.appendChild(opt);
                    });
                }

                if (currentValue && options && options.includes(currentValue)) {
                    dropdown.value = currentValue;
                } else {
                    dropdown.value = currentCar[fieldName] || '';
                }
                dropdown.disabled = false;
                dropdown.onchange = function() { handleChange(fieldName, this.value); };
            });
        }

        function resetDropdownsAfter(fieldName) {
            const fields = ['brand', 'model', 'generation', 'engine'];
            const startIndex = fields.indexOf(fieldName) + 1;
            for (let i = startIndex; i < fields.length; i++) {
                const desktop = document.getElementById(fields[i] + 'Dropdown');
                const mobile = document.getElementById(fields[i] + 'DropdownMobile');
                if (desktop && !currentCar[fields[i]]) {
                    desktop.innerHTML = `<option value="">-- ${getPlaceholder(fields[i])} --</option>`;
                    desktop.disabled = true;
                    desktop.onchange = null;
                }
                if (mobile && !currentCar[fields[i]]) {
                    mobile.innerHTML = `<option value="">-- ${getPlaceholder(fields[i])} --</option>`;
                    mobile.disabled = true;
                    mobile.onchange = null;
                }
                currentCar[fields[i]] = '';
            }
        }

        function getPlaceholder(fieldName) {
            const getCookie = (name) => {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return 'ru';
            };
            const lang = getCookie('Language');

            const placeholders = {
                brand: { ru: 'Выберите бренд', en: 'Select brand', de: 'Marke wählen' },
                model: { ru: 'Выберите модель', en: 'Select model', de: 'Modell wählen' },
                generation: { ru: 'Выберите поколение', en: 'Select generation', de: 'Generation wählen' },
                engine: { ru: 'Выберите двигатель', en: 'Select engine', de: 'Motor wählen' }
            };
            return placeholders[fieldName]?.[lang] || 'Выберите';
        }

        document.addEventListener('DOMContentLoaded', async function () {
            updateDropdownLabels();
            await loadInitialData();
            if (isCarComplete()) showSuccessButton();
            syncDropdowns();
        });
    </script>
</body>
</html>