        /* На ПК столбик сжат до нуля, но ячейка остаётся в таблице —
           иначе colspan/скрытые td ломают выравнивание колонок */
        .price-table .info-col {
            width: 0;
            max-width: 0;
            min-width: 0;
            white-space: nowrap;
            padding: 0 !important;
            border: none;
            overflow: hidden;
