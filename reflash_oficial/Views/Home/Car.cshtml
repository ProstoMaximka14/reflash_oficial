@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "ReflashTeam";

    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    var currentTheme = Context.Request.Cookies["Theme"] ?? "dark";

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }

    string AddLineBreaks(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Replace("\n", "<br>").Replace("\r\n", "<br>");
    }

    List<string> SplitTextBySeparator(string text)
    {
        if (string.IsNullOrEmpty(text)) return new List<string>();
        var parts = text.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Select(p => p.Trim()).ToList();
    }

    string GetCarImagePath(string imageName)
    {
        if (string.IsNullOrEmpty(imageName)) return "";
        if (imageName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            imageName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return imageName;
        if (imageName.StartsWith("/"))
            return imageName;
        return "/shared-fotos/cars/" + imageName;
    }

    string GetGraficImagePath(string imageName)
    {
        if (string.IsNullOrEmpty(imageName)) return "";
        if (imageName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            imageName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return imageName;
        if (imageName.StartsWith("/"))
            return imageName;
        return "/shared-fotos/grafics/" + imageName;
    }

    string GetCurrency()
    {
        return language switch
        {
            "en" => "$",
            "de" => "€",
            _ => "₽"
        };
    }

    bool IsPriceNumeric(string price)
    {
        if (string.IsNullOrEmpty(price)) return false;
        var cleaned = price.Trim();
        if (cleaned.Length == 0) return false;
        var firstChar = cleaned[0];
        return char.IsDigit(firstChar) || firstChar == '.' || firstChar == ',' || firstChar == '0';
    }
}

<!DOCTYPE html>
<html lang="@language" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — Performance Tuning</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ================================================================
           CSS ПЕРЕМЕННЫЕ ДЛЯ ТЕМ
           ================================================================ */

        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-overlay: rgba(255, 255, 255, 0.9);
            --text-primary: #1a1a2e;
            --text-secondary: #1a1a2e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --gradient-start: #f8f9fa;
            --gradient-end: #e9ecef;
            --slider-overlay: rgba(255, 255, 255, 0.4);
            --block-bg: #ffffff;
            --block-border: #e0e0e0;
            --frame-bg: rgba(255, 255, 255, 0.95);
            --frame-text: #1a1a2e;
            --price-bg-start: #2196F3;
            --price-bg-end: #1976D2;
            --price-text: #ffffff;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
            --list-marker-color: var(--accent-color);
            --order-title-color: #2196F3;
            --star-color: #2196F3;
            --incompatible-color: #dc3545;
            --incompatible-bg: rgba(220, 53, 69, 0.1);
        }

        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-overlay: rgba(10, 10, 15, 0.9);
            --text-primary: #E8E8F0;
            --text-secondary: #E8E8F0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.5);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --gradient-start: #111118;
            --gradient-end: #0D0D14;
            --slider-overlay: rgba(0, 0, 0, 0.85);
            --block-bg: #111118;
            --block-border: #252530;
            --frame-bg: rgba(10, 10, 15, 0.85);
            --frame-text: #E8E8F0;
            --price-bg-start: #FF3A2F;
            --price-bg-end: #B8251A;
            --price-text: #ffffff;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
            --list-marker-color: var(--accent-color);
            --order-title-color: #FF3A2F;
            --star-color: #FF3A2F;
            --incompatible-color: #ff6b6b;
            --incompatible-bg: rgba(255, 107, 107, 0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.5;
            transition: background 0.3s ease, color 0.3s ease;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-secondary); }
        ::-webkit-scrollbar-thumb { background: var(--accent-color); border-radius: 10px; }

        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: var(--bg-overlay);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid var(--border-color);
            box-shadow: 0 8px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        .lang-btn:hover {
            color: var(--text-primary);
            background: rgba(255,58,47,0.1);
        }

        .lang-btn.active {
            background: var(--accent-color);
            color: white;
            box-shadow: 0 0 8px rgba(255,58,47,0.5);
        }

        .page-wrapper {
            display: flex;
            gap: 30px;
            width: 100%;
            margin: 0 auto;
            padding: 0 5% 60px 10%;
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .dropdowns-sidebar {
            flex: 0 0 280px;
            position: sticky;
            top: 100px;
            align-self: flex-start;
        }

        .dropdowns-card {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 20px 35px -12px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .dropdown-section {
            margin-bottom: 20px;
        }
        .dropdown-section:last-of-type { margin-bottom: 0; }

        .dropdown-label {
            display: block;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--accent-color);
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .dropdown-select {
            width: 100%;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 500;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', monospace;
        }

        .dropdown-select:focus {
            border-color: var(--accent-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,58,47,0.2);
        }

        .dropdown-select:disabled {
            background: var(--bg-secondary);
            color: var(--text-muted);
            cursor: not-allowed;
            border-color: var(--border-color);
        }

        .btn-next {
            width: 100%;
            margin-top: 12px;
            padding: 12px 20px;
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            border: none;
            border-radius: 40px;
            color: white;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s;
            display: none;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(255,58,47,0.3);
        }

        .btn-next:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255,58,47,0.4);
        }

        .btn-next-mobile {
            width: 100%;
            margin-top: 8px;
            padding: 10px 16px;
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            border: none;
            border-radius: 40px;
            color: white;
            font-weight: 700;
            font-size: 13px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s;
            display: none;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(255,58,47,0.3);
        }

        .btn-next-mobile:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255,58,47,0.4);
        }

        .container { flex: 1; min-width: 0; }

        .car-header {
            background: var(--bg-card);
            border-radius: 28px;
            padding: 24px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
            width: 100%;
            max-width: 800px;
        }

        .specs-container {
            background: var(--bg-secondary);
            border-radius: 20px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            transition: all 0.3s ease;
        }

        .specs-container:hover {
            border-color: var(--accent-color);
            box-shadow: 0 8px 25px var(--shadow-color);
        }

        .spec-item {
            text-align: center;
            padding: 8px 4px;
        }

        .spec-label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 4px;
        }

        .spec-value {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .header-dropdowns {
            display: none;
            background: var(--bg-secondary);
            border-radius: 20px;
            margin-bottom: 16px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            padding: 8px 6px;
        }

        .header-dropdowns .dropdown-select {
            padding: 6px 10px;
            font-size: 11px;
            border-radius: 12px;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            text-align: center;
            width: 100%;
        }

        .header-dropdowns .dropdown-select:disabled {
            background: var(--bg-secondary);
            color: var(--text-muted);
            cursor: not-allowed;
        }

        .header-dropdowns .spec-item {
            padding: 6px 8px;
        }

        .header-dropdowns .spec-label {
            font-size: 8px;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }

        .header-dropdowns-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 4px;
        }

        .car-info-wrapper {
            display: flex;
            gap: 20px;
            align-items: stretch;
        }

        .car-image-full {
            flex: 1;
            background: var(--bg-secondary);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        .car-image-full:hover {
            border-color: var(--accent-color);
            box-shadow: 0 8px 30px var(--shadow-hover);
        }

        .car-image {
            max-width: 100%;
            max-height: 250px;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 12px;
            transition: transform 0.3s ease;
            display: block;
        }

        .car-image:hover {
            transform: scale(1.02);
        }

        .no-image-placeholder {
            color: var(--text-muted);
            padding: 60px 20px;
            text-align: center;
        }

        .no-image-placeholder i {
            font-size: 64px;
            opacity: 0.3;
            display: block;
            margin-bottom: 16px;
        }

        .car-order-block {
            flex: 0 0 240px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .car-order-block:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px var(--shadow-hover);
        }

        .order-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 16px;
            width: 100%;
        }

        .order-text {
            display: flex;
            flex-direction: column;
            gap: 4px;
            width: 100%;
        }

        .order-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--order-title-color);
            letter-spacing: 0.3px;
            text-align: center;
        }

        .order-price {
            font-size: 22px;
            font-weight: 800;
            color: var(--accent-color);
        }

        .order-button {
            display: inline-block;
            padding: 12px 32px;
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            border: none;
            border-radius: 40px;
            color: #ffffff;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            box-shadow: 0 4px 15px rgba(255, 58, 47, 0.3);
            width: 100%;
            text-align: center;
            cursor: pointer;
        }

        .order-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 58, 47, 0.4);
        }

        #prices-section { 
            scroll-margin-top: 20px;
        }

        .info-block {
            background: var(--bg-card);
            border-radius: 24px;
            padding: 28px 32px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
            transition: all 0.25s;
            box-shadow: 0 4px 20px var(--shadow-color);
            width: 100%;
        }

        .info-block:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
        }

        .info-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
            letter-spacing: -0.3px;
            color: var(--text-primary);
        }

        .info-content {
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
        }

        .info-list-plain {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .info-list-plain li {
            position: relative;
            padding: 8px 0 8px 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
            transition: color 0.2s ease;
            border-bottom: 1px solid var(--border-color);
        }

        .info-list-plain li:last-child { border-bottom: none; }
        .info-list-plain li:hover { color: var(--text-primary); }

        .info-list-star {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .info-list-star li {
            position: relative;
            padding: 8px 0 8px 32px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
            transition: color 0.2s ease;
            border-bottom: 1px solid var(--border-color);
        }

        .info-list-star li:last-child { border-bottom: none; }

        .info-list-star li::before {
            content: "★";
            position: absolute;
            left: 0;
            top: 8px;
            color: var(--star-color);
            font-weight: 700;
            font-size: 15px;
            transition: transform 0.3s ease;
        }

        .info-list-star li:hover::before {
            transform: scale(1.2) rotate(10deg);
        }

        .info-list-star li:hover { color: var(--text-primary); }

        /* ===== КОНСТРУКТОР ЦЕН ===== */
        .price-result {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 2px solid var(--border-color);
        }

        .price-result-row {
            display: flex;
            align-items: baseline;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .price-result-label {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .price-result-value {
            font-size: 24px;
            font-weight: 800;
            color: var(--accent-color);
        }

        .price-result-value.incompatible {
            color: var(--incompatible-color);
        }

        .price-result-currency {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .price-result-text {
            font-size: 16px;
            font-weight: 600;
            color: var(--accent-color);
            margin-left: 4px;
        }

        .price-result-text.incompatible {
            color: var(--incompatible-color);
        }

        .price-actions {
            display: flex;
            gap: 10px;
            margin-top: 12px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .price-actions button {
            padding: 6px 16px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
            background: var(--bg-input);
            color: var(--text-secondary);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .price-actions button:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
            background: var(--bg-secondary);
        }

        .price-option-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
            background: var(--accent-color);
            color: white;
            text-transform: uppercase;
            margin-left: 6px;
        }

        .price-option-badge.pro {
            background: #4CAF50;
        }

        .price-option-badge.from {
            background: #FF9800;
        }

        .price-option-badge.text {
            background: #9C27B0;
        }

        .price-option-badge.zero {
            background: #757575;
        }

        .price-option-badge.incompatible-badge {
            background: var(--incompatible-color);
            color: white;
        }

        .price-label {
            font-size: 17px;
            font-weight: 700;
            text-transform: none;
            letter-spacing: -0.3px;
            color: var(--text-primary);
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent-color);
            display: inline-block;
        }

        .price-table-wrapper {
            margin-top: 15px;
            overflow-x: auto;
            border-radius: 12px;
            padding: 4px;
        }

        .price-table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 10px;
            overflow: hidden;
        }

        .price-table thead th {
            padding: 10px 16px;
            text-align: left;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-primary);
            border-bottom: 1px solid var(--border-color);
        }

        .price-table thead th:not(:first-child) { text-align: center; }

        .price-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background 0.2s ease;
        }

        .price-table tbody tr:last-child { border-bottom: none; }
        .price-table tbody tr:hover { background: var(--bg-secondary); }

        .price-table tbody td {
            padding: 10px 16px;
            text-align: left;
            font-weight: 500;
            font-size: 13px;
            color: var(--text-primary);
        }

        .price-table tbody td:not(:first-child) {
            text-align: center;
            font-weight: 700;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .price-name-cell {
            display: flex;
            align-items: center;
            gap: 0px;
            flex-wrap: wrap;
        }

        .price-name-cell .info-btn {
            background: none;
            border: none;
            color: var(--accent-color);
            cursor: pointer;
            font-size: 15px;
            padding: 0 2px;
            transition: all 0.2s ease;
            opacity: 0.7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            margin-left: 2px;
        }

        .price-name-cell .info-btn:hover {
            opacity: 1;
            transform: scale(1.2);
            color: var(--accent-hover);
        }

        .price-name-cell .info-btn i {
            font-size: 15px;
            pointer-events: none;
        }

        .price-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            background: var(--accent-color);
            border-radius: 50%;
            flex-shrink: 0;
        }

        .price-dot.zero-dot {
            background: #757575;
        }

        .price-dot.incompatible-dot {
            background: var(--incompatible-color);
        }

        .price-empty {
            font-size: 13px;
            color: var(--text-muted);
        }


        /* ===== ПК / МОБИЛКА: название + инфо ===== */
        .price-name-desktop { display: block; }

        .price-name-mobile,
        .price-name-mobile-wrap {
