        /* ===== СТИЛИ ДЛЯ КНОПКИ ИНФОРМАЦИИ ===== */
        .info-btn {
            background: none;
            border: none;
            color: var(--accent-color);
            cursor: pointer;
            font-size: 16px;
            padding: 0 4px;
            transition: all 0.2s ease;
            opacity: 0.7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
