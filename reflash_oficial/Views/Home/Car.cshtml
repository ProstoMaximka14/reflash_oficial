@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "Автомобиль выбран!";
    var language = Context.Request.Query["lang"].ToString();
    if (string.IsNullOrEmpty(language))
    {
        language = "ru";
    }

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "eng" => eng,
            "ger" => ger,
            _ => ru
        };
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background: #f5f5f5;
            color: #333;
            line-height: 1.6;
        }

        .container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Шапка с языком и заголовком */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #4CAF50;
        }

        .title-section h1 {
            margin: 0;
            color: #2c3e50;
            font-size: 28px;
        }

        .success-icon {
            font-size: 36px;
            color: #4CAF50;
            margin-right: 15px;
        }

        /* Переключатель языка */
        .language-switcher {
            display: flex;
            gap: 8px;
        }

        .lang-btn {
            padding: 8px 16px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
        }

            .lang-btn.active {
                background: #4CAF50;
                color: white;
                border-color: #4CAF50;
            }

            .lang-btn:hover:not(.active) {
                background: #f8f9fa;
                border-color: #4CAF50;
            }

        /* Основной контент в две колонки */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        /* Левая колонка - основная информация */
        .left-column {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Правая колонка - описание и детали */
        .right-column {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Изображение автомобиля */
        .car-image-container {
            text-align: center;
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }

        .car-image {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            max-height: 300px;
            object-fit: cover;
        }

        /* Основные характеристики */
        .basic-info {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #4CAF50;
        }

        .basic-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .info-item {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .info-label {
            font-weight: 600;
            color: #555;
            display: block;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .info-value {
            color: #2c3e50;
            font-size: 16px;
        }

        /* Блоки с описанием */
        .info-block {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
            border: 1px solid #eaeaea;
            transition: transform 0.3s;
        }

            .info-block:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            }

        .info-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
            font-size: 18px;
            display: flex;
            align-items: center;
        }

            .info-title:before {
                content: "•";
                color: #4CAF50;
                font-size: 24px;
                margin-right: 10px;
            }

        .info-content {
            color: #444;
            line-height: 1.7;
        }

        /* Блок с ценой */
        .price-block {
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
            border-radius: 10px;
            padding: 25px;
            text-align: center;
            margin-top: 10px;
        }

        .price-label {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 10px;
        }

        .price-value {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .price-note {
            font-size: 12px;
            opacity: 0.8;
            font-style: italic;
        }

        /* Кнопки действий */
        .actions {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid #eee;
        }

        .btn {
            padding: 14px 32px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            min-width: 180px;
        }

            .btn:hover {
                background: #45a049;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
            }

        .btn-back {
            background: #6c757d;
        }

            .btn-back:hover {
                background: #5a6268;
                box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
            }

        /* Специальные стили для блоков */
        .highlight {
            background: #e8f5e9 !important;
            border-color: #4CAF50 !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Шапка -->
        <div class="header">
            <div class="title-section">
                <h1>
                    <span class="success-icon">✅</span>
                    @GetLocalized("Автомобиль успешно выбран!", "Car successfully selected!", "Auto erfolgreich ausgewählt!")
                </h1>
            </div>

            <div class="language-switcher">
                <button class="lang-btn @(language == "ru" ? "active" : "")" onclick="switchLanguage('ru')">RU</button>
                <button class="lang-btn @(language == "eng" ? "active" : "")" onclick="switchLanguage('eng')">EN</button>
                <button class="lang-btn @(language == "ger" ? "active" : "")" onclick="switchLanguage('ger')">DE</button>
            </div>
        </div>

        <!-- Основной контент в две колонки -->
        <div class="content-grid">
            <!-- Левая колонка -->
            <div class="left-column">
                <!-- Изображение автомобиля -->
                <div class="car-image-container">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Brand @Model.Model" class="car-image" />
                    }
                    else
                    {
                        <div style="padding: 40px; color: #777; text-align: center;">
                            @GetLocalized("Изображение автомобиля", "Car image", "Auto Bild")
                        </div>
                    }
                </div>

                <!-- Основные характеристики -->
                <div class="basic-info">
                    <div class="basic-info-grid">
                        <div class="info-item">
                            <span class="info-label">@GetLocalized("Бренд", "Brand", "Marke")</span>
                            <span class="info-value">@Model.Brand</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@GetLocalized("Модель", "Model", "Modell")</span>
                            <span class="info-value">@Model.Model</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@GetLocalized("Поколение", "Generation", "Generation")</span>
                            <span class="info-value">@Model.Generation</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@GetLocalized("Двигатель", "Engine", "Motor")</span>
                            <span class="info-value">@Model.Engine</span>
                        </div>
                    </div>
                </div>

                <!-- Блок с описанием -->
                <div class="info-block highlight">
                    <div class="info-title">@GetLocalized("О автомобиле", "About the car", "Über das Auto")</div>
                    <div class="info-content">@GetLocalized(Model.AboutRu, Model.AboutEng, Model.AboutGer)</div>
                </div>
            </div>

            <!-- Правая колонка -->
            <div class="right-column">
                <!-- Результаты чип-тюнинга -->
                <div class="info-block">
                    <div class="info-title">@GetLocalized("Результаты чип-тюнинга", "Chip tuning results", "Chip-Tuning-Ergebnisse")</div>
                    <div class="info-content">@GetLocalized(Model.ResultRu, Model.ResultEng, Model.ResultGer)</div>
                </div>

                <!-- Управление двигателем -->
                <div class="info-block">
                    <div class="info-title">@GetLocalized("Управление двигателем", "Engine control", "Motorsteuerung")</div>
                    <div class="info-content">@GetLocalized(Model.EngineControlRu, Model.EngineControlEng, Model.EngineControlGer)</div>
                </div>

                <!-- Опции -->
                <div class="info-block">
                    <div class="info-title">@GetLocalized("Дополнительные опции", "Additional options", "Zusätzliche Optionen")</div>
                    <div class="info-content">@GetLocalized(Model.OptionsRu, Model.OptionsEng, Model.OptionsGer)</div>
                </div>

                <!-- Цена -->
                <div class="price-block">
                    <div class="price-label">@GetLocalized("Стоимость", "Price", "Preis")</div>
                    <div class="price-value">@GetLocalized(Model.PriceRu, Model.PriceEng, Model.PriceGer)</div>
                    <div class="price-note">@GetLocalized("*включая все работы и настройки", "*including all works and tuning", "*inklusive aller Arbeiten und Einstellungen")</div>
                </div>
            </div>
        </div>

        <!-- Кнопки действий -->
        <div class="actions">
            <a href="/" class="btn btn-back">← @GetLocalized("Вернуться к выбору", "Back to selection", "Zurück zur Auswahl")</a>
            <button class="btn" onclick="alert('@GetLocalized("Функция заказа временно недоступна", "Order function temporarily unavailable", "Bestellfunktion vorübergehend nicht verfügbar")')">
                @GetLocalized("Заказать чип-тюнинг", "Order chip tuning", "Chip-Tuning bestellen")
            </button>
        </div>
    </div>

    <script>
        function switchLanguage(lang) {
            const url = new URL(window.location.href);
            url.searchParams.set('lang', lang);
            window.location.href = url.toString();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const savedLang = localStorage.getItem('preferredLanguage');
            if (savedLang && !window.location.search.includes('lang=')) {
                switchLanguage(savedLang);
            }

            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const lang = this.getAttribute('onclick').match(/'([^']+)'/)[1];
                    localStorage.setItem('preferredLanguage', lang);
                });
            });

            // Плавная прокрутка для якорных ссылок (если понадобится)
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    if(targetId === '#') return;

                    const targetElement = document.querySelector(targetId);
                    if(targetElement) {
                        targetElement.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>