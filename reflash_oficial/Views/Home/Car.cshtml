@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "Автомобиль выбран!";
    
    // Читаем язык из URL или cookie
    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 2%;
        background: #f5f5f5;
        color: #333;
        line-height: 1.6;
    }

    /* Новый контейнер для всей страницы с флексом */
    .page-wrapper {
        display: flex;
        gap: 3%;
        max-width: 90%;
        width: 1400px;
        margin: 0 auto;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    /* Левая колонка с дропдаунами (вне основного контейнера) */
    .dropdowns-sidebar {
        flex: 0 0 25%;
        min-width: 250px;
        position: static;
        top: 2%;
        align-self: flex-start;
    }

    /* Контейнер с дропдаунами */
    .dropdowns-row {
        display: flex;
        flex-direction: column;
        gap: 4%;
        background: rgba(255, 255, 255, 0.95);
        padding: 7%;
        border-radius: 1.2%;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.15);
        backdrop-filter: blur(5px);
        border: 1px solid rgba(76, 175, 80, 0.3);
    }

    .dropdown-section {
        width: 100%;
    }

    .dropdown-label {
        display: block;
        font-weight: 600;
        margin-bottom: 2%;
        font-size: 0.9rem;
        color: #2c3e50;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .dropdown-select {
        width: 100%;
        padding: 4% 3%;
        font-size: 0.9rem;
        border: 2px solid #e0e0e0;
        border-radius: 0.6rem;
        background-color: white;
        transition: all 0.3s ease;
        cursor: pointer;
        font-weight: 500;
        box-sizing: border-box;
    }

        .dropdown-select:hover:not(:disabled) {
            border-color: #4CAF50;
            box-shadow: 0 0.2rem 0.8rem rgba(76, 175, 80, 0.2);
        }

        .dropdown-select:focus {
            outline: none;
            border-color: #4CAF50;
            box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.2);
        }

        .dropdown-select:disabled {
            background-color: #f5f5f5;
            opacity: 0.7;
            cursor: not-allowed;
            border-color: #ddd;
        }

    /* Кнопка в сайдбаре */
    .dropdowns-sidebar .actions {
        margin-top: 3%;
        text-align: left;
    }

    .btn-success {
        padding: 4% 8%;
        background: linear-gradient(135deg, #4CAF50, #45a049);
        color: white;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: none;
        opacity: 0;
        transform: scale(0.9);
        width: 100%;
        text-transform: uppercase;
        letter-spacing: 0.06rem;
        box-shadow: 0 0.25rem 1rem rgba(76, 175, 80, 0.3);
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #45a049, #3d8b40);
            transform: translateY(-0.125rem) scale(1.02);
            box-shadow: 0 0.4rem 1.3rem rgba(76, 175, 80, 0.4);
        }

        .btn-success:active {
            transform: translateY(0) scale(1);
            box-shadow: 0 0.125rem 0.7rem rgba(76, 175, 80, 0.3);
        }

    /* Основной контейнер (справа) */
    .container {
        flex: 1;
        background: white;
        border-radius: 1.2%;
        padding: 5%;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08);
        min-width: 0;
    }

    /* Шапка с языком и заголовком */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5%;
        padding-bottom: 3%;
        border-bottom: 0.125rem solid #4CAF50;
        flex-wrap: wrap;
        gap: 5%;
    }

    .title-section h1 {
        margin: 0;
        color: #2c3e50;
        font-size: clamp(1.5rem, 5vw, 2.2rem);
    }

    .success-icon {
        font-size: 2.2rem;
        color: #4CAF50;
        margin-right: 3%;
    }

    /* Переключатель языка */
    .language-switcher {
        display: flex;
        gap: 3%;
    }

    .lang-btn {
        padding: 5% 10%;
        border: 1px solid #ddd;
        background: white;
        border-radius: 0.3rem;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.3s;
    }

        .lang-btn.active {
            background: #4CAF50;
            color: white;
            border-color: #4CAF50;
        }

        .lang-btn:hover:not(.active) {
            background: #f8f9fa;
            border-color: #4CAF50;
        }

    /* Основной контент в две колонки внутри контейнера */
    .content-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 5%;
        margin-bottom: 5%;
    }

    /* Левая колонка - основная информация */
    .left-column {
        display: flex;
        flex-direction: column;
        gap: 5%;
    }

    /* Правая колонка - описание и детали */
    .right-column {
        display: flex;
        flex-direction: column;
        gap: 5%;
    }

    /* Изображение автомобиля */
    .car-image-container {
        text-align: center;
        background: #f8f9fa;
        border-radius: 0.8rem;
        padding: 5%;
        box-shadow: 0 0.2rem 0.7rem rgba(0,0,0,0.05);
    }

    .car-image {
        max-width: 100%;
        height: auto;
        border-radius: 0.6rem;
        max-height: 300px;
        object-fit: cover;
    }

    /* Основные характеристики */
    .basic-info {
        background: #f8f9fa;
        border-radius: 0.8rem;
        padding: 7%;
        border-left: 0.25rem solid #4CAF50;
    }

    .basic-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 5%;
    }

    .info-item {
        padding: 3% 0;
        border-bottom: 1px solid #eee;
    }

    .info-label {
        font-weight: 600;
        color: #555;
        display: block;
        font-size: 0.85rem;
        margin-bottom: 2%;
    }

    .info-value {
        color: #2c3e50;
        font-size: 1rem;
    }

    /* Блоки с описанием */
    .info-block {
        background: white;
        border-radius: 0.8rem;
        padding: 7%;
        box-shadow: 0 0.2rem 1rem rgba(0,0,0,0.05);
        border: 1px solid #eaeaea;
        transition: transform 0.3s;
    }

        .info-block:hover {
            transform: translateY(-0.125rem);
            box-shadow: 0 0.3rem 1.3rem rgba(0,0,0,0.1);
        }

    .info-title {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5%;
        padding-bottom: 3%;
        border-bottom: 0.125rem solid #f0f0f0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
    }

        .info-title:before {
            content: "•";
            color: #4CAF50;
            font-size: 1.5rem;
            margin-right: 3%;
        }

    .info-content {
        color: #444;
        line-height: 1.7;
    }

    /* Блок с ценой */
    .price-block {
        background: linear-gradient(135deg, #4CAF50, #45a049);
        color: white;
        border-radius: 0.8rem;
        padding: 8%;
        text-align: center;
        margin-top: 3%;
    }

    .price-label {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 3%;
    }

    .price-value {
        font-size: clamp(1.3rem, 4vw, 1.8rem);
        font-weight: bold;
        margin-bottom: 4%;
    }

    .price-note {
        font-size: 0.75rem;
        opacity: 0.8;
        font-style: italic;
    }

    /* Кнопки действий */
    .actions-bottom {
        display: flex;
        justify-content: center;
        gap: 5%;
        margin-top: 8%;
        padding-top: 5%;
        border-top: 1px solid #eee;
        flex-wrap: wrap;
    }

    .btn {
        padding: 4% 8%;
        background: #4CAF50;
        color: white;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        min-width: 150px;
    }

        .btn:hover {
            background: #45a049;
            transform: translateY(-0.125rem);
            box-shadow: 0 0.3rem 1rem rgba(76, 175, 80, 0.3);
        }

    .btn-back {
        background: #6c757d;
    }

        .btn-back:hover {
            background: #5a6268;
            box-shadow: 0 0.3rem 1rem rgba(108, 117, 125, 0.3);
        }

    /* Специальные стили для блоков */
    .highlight {
        background: #e8f5e9 !important;
        border-color: #4CAF50 !important;
    }

    /* Адаптация для мобильных устройств (телефонов) */
    @@media (max-width: 768px)
{
    

    .page-wrapper {
        flex-direction: column;
        gap: 5%;
    }
        
    /* На телефонах дропдауны идут после информации */
    .dropdowns-sidebar {
        flex: 0 0 auto;
        width: 100%;
        position: static;
        order: 2; /* Дропдауны будут после контейнера */
    }
        
    .container {
        order: 1; /* Информация будет первой */
    }
        
    .dropdowns-row {
        flex-direction: row; /* На телефонах дропдауны в строку */
        flex-wrap: wrap;
        gap: 3%;
    }
        
    .dropdown-section {
        flex: 1;
        min-width: 150px;
    }
        
    .content-grid {
        grid-template-columns: 1fr;
        gap: 8%;
    }
        
    .basic-info-grid {
        grid-template-columns: 1fr;
        gap: 2%;
    }

    .price-block {
        margin-bottom: 45%; /* Отступ после цены */
        margin-top: 5%;
    }
 
    .actions-bottom {
        flex-direction: column;
        align-items: center;
        gap: 3%;
        
    }
        
    .btn {
        width: 100%;
        max-width: 300px;
    }
        
    .language-switcher {
        margin-top: 3%;
    }
        
    .header {
        flex-direction: column;
        align-items: flex-start;
    }
        
    .title-section {
        display: flex;
        align-items: center;
        width: 100%;
    }
}
</style>
</head>
<body>
    <div class="page-wrapper">
        <!-- Левая колонка с дропдаунами (ВНЕ основного контейнера) -->
        <div class="dropdowns-sidebar">
            <div class="dropdowns-row">
                <!-- Бренд -->
                <div class="dropdown-section">
                    <label class="dropdown-label">Бренд:</label>
                    <select class="dropdown-select" id="brandDropdown" disabled>
                        <option value="">-- Загрузка... --</option>
                    </select>
                </div>

                <!-- Модель -->
                <div class="dropdown-section">
                    <label class="dropdown-label">Модель:</label>
                    <select class="dropdown-select" id="modelDropdown" disabled>
                        <option value="">-- Сначала бренд --</option>
                    </select>
                </div>

                <!-- Поколение -->
                <div class="dropdown-section">
                    <label class="dropdown-label">Поколение:</label>
                    <select class="dropdown-select" id="generationDropdown" disabled>
                        <option value="">-- Сначала модель --</option>
                    </select>
                </div>

                <!-- Двигатель -->
                <div class="dropdown-section">
                    <label class="dropdown-label">Двигатель:</label>
                    <select class="dropdown-select" id="engineDropdown" disabled>
                        <option value="">-- Сначала поколение --</option>
                    </select>
                </div>

                <!-- Кнопка -->
                <div class="actions">
                    <button class="btn-success" id="successButton" onclick="onSuccessButtonClick()">
                        Перейти
                    </button>
                </div>
            </div>
        </div>

        <!-- Основной контейнер с контентом автомобиля (справа) -->
        <div class="container">
            <!-- Шапка -->
            <div class="header">
                <div class="language-switcher">
                    <button class="lang-btn @(language == "ru" ? "active" : "")" onclick="switchLanguage('ru')">RU</button>
                    <button class="lang-btn @(language == "en" ? "active" : "")" onclick="switchLanguage('en')">EN</button>
                    <button class="lang-btn @(language == "de" ? "active" : "")" onclick="switchLanguage('de')">DE</button>
                </div>
            </div>

            <!-- Основной контент в две колонки -->
            <div class="content-grid">
                <!-- Левая колонка контента -->
                <div class="left-column">
                    <!-- Изображение автомобиля -->
                    <div class="car-image-container">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Brand @Model.Model" class="car-image" />
                        }
                        else
                        {
                            <div style="padding: 40px; color: #777; text-align: center;">
                                @GetLocalized("Изображение автомобиля", "Car image", "Auto Bild")
                            </div>
                        }
                    </div>

                    <!-- Основные характеристики -->
                    <div class="basic-info">
                        <div class="basic-info-grid">
                            <div class="info-item">
                                <span class="info-label">@GetLocalized("Бренд", "Brand", "Marke")</span>
                                <span class="info-value">@Model.Brand</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">@GetLocalized("Модель", "Model", "Modell")</span>
                                <span class="info-value">@Model.Model</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">@GetLocalized("Поколение", "Generation", "Generation")</span>
                                <span class="info-value">@Model.Generation</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">@GetLocalized("Двигатель", "Engine", "Motor")</span>
                                <span class="info-value">@Model.Engine</span>
                            </div>
                        </div>
                    </div>

                    <!-- Блок с описанием -->
                    <div class="info-block highlight">
                        <div class="info-title">@GetLocalized("О автомобиле", "About the car", "Über das Auto")</div>
                        <div class="info-content">@GetLocalized(Model.AboutRu, Model.AboutEng, Model.AboutGer)</div>
                    </div>
                </div>

                <!-- Правая колонка контента -->
                <div class="right-column">
                    <!-- Результаты чип-тюнинга -->
                    <div class="info-block">
                        <div class="info-title">@GetLocalized("Результаты чип-тюнинга", "Chip tuning results", "Chip-Tuning-Ergebnisse")</div>
                        <div class="info-content">@GetLocalized(Model.ResultRu, Model.ResultEng, Model.ResultGer)</div>
                    </div>

                    <!-- Управление двигателем -->
                    <div class="info-block">
                        <div class="info-title">@GetLocalized("Управление двигателем", "Engine control", "Motorsteuerung")</div>
                        <div class="info-content">@GetLocalized(Model.EngineControlRu, Model.EngineControlEng, Model.EngineControlGer)</div>
                    </div>

                    <!-- Опции -->
                    <div class="info-block">
                        <div class="info-title">@GetLocalized("Дополнительные опции", "Additional options", "Zusätzliche Optionen")</div>
                        <div class="info-content">@GetLocalized(Model.OptionsRu, Model.OptionsEng, Model.OptionsGer)</div>
                    </div>

                    <!-- Цена -->
                    <div class="price-block">
                        <div class="price-label">@GetLocalized("Стоимость", "Price", "Preis")</div>
                        <div class="price-value">@GetLocalized(Model.PriceRu, Model.PriceEng, Model.PriceGer)</div>
                        <div class="price-note">@GetLocalized("*включая все работы и настройки", "*including all works and tuning", "*inklusive aller Arbeiten und Einstellungen")</div>
                    </div>
                </div>
            </div>

            <!-- Кнопки действий внизу -->
            <div class="actions-bottom">
                <a href="/" class="btn btn-back">← @GetLocalized("Вернуться к выбору", "Back to selection", "Zurück zur Auswahl")</a>
                <button class="btn" onclick="alert('@GetLocalized("Функция заказа временно недоступна", "Order function temporarily unavailable", "Bestellfunktion vorübergehend nicht verfügbar")')">
                    @GetLocalized("Заказать чип-тюнинг", "Order chip tuning", "Chip-Tuning bestellen")
                </button>
            </div>
        </div>
    </div>

    <script>
    // ========== ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА ==========
    function switchLanguage(lang) {
        // Сохраняем язык в cookie (на 365 дней)
        document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
        console.log("Язык сохранён:", lang);
        // Перезагружаем страницу
        location.reload();
    }

    // ========== ДРОПДАУНЫ ==========
    let currentCar = {
        brand: '@Model.Brand',
        model: '@Model.Model',
        generation: '@Model.Generation',
        engine: '@Model.Engine'
    };

    document.addEventListener('DOMContentLoaded', async function () {
        await loadInitialData();
        if (isCarComplete()) {
            showSuccessButton();
        }
    });

    function isCarComplete() {
        return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine;
    }

    function showSuccessButton() {
        const successButton = document.getElementById('successButton');
        if (successButton) {
            successButton.style.display = 'inline-block';
            setTimeout(() => {
                successButton.style.opacity = '1';
                successButton.style.transform = 'scale(1)';
            }, 10);
        }
    }

    function hideSuccessButton() {
        const successButton = document.getElementById('successButton');
        if (successButton) {
            successButton.style.display = 'none';
        }
    }

    function onSuccessButtonClick() {
    if (!isCarComplete()) {
        alert('Пожалуйста, заполните все поля перед продолжением.');
        return;
    }

    // Получаем текущий язык из cookie (просто для информации, но в URL не добавляем)
    const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return 'ru';
    };
    
    const currentLang = getCookie('Language');
    console.log("Язык из cookie:", currentLang); // Только для лога

    // Формируем ЧПУ-ссылку БЕЗ параметра языка
    const brand = encodeURIComponent(currentCar.brand);
    const model = encodeURIComponent(currentCar.model);
    const generation = encodeURIComponent(currentCar.generation);
    const engine = encodeURIComponent(currentCar.engine);
    
    // ✅ Без ?lang= - язык только из cookie
    window.location.href = `/Home/Car/${brand}/${model}/${generation}/${engine}`;
}

    async function loadInitialData() {
        try {
            const response = await fetch('/Home/GetInitialData');
            const result = await response.json();
            updateCar(result.car);
            if (result.nextField === 'brand') {
                const dropdown = document.getElementById('brandDropdown');
                const placeholder = getPlaceholder('brand');
                dropdown.innerHTML = `<option value="">-- ${placeholder} --</option>`;
                if (result.options && result.options.length > 0) {
                    result.options.forEach(option => {
                        const opt = document.createElement('option');
                        opt.value = option;
                        opt.textContent = option;
                        dropdown.appendChild(opt);
                    });
                }
                dropdown.disabled = false;
                dropdown.onchange = function() {
                    handleChange('brand', this.value);
                };
            }
        } catch (error) {
            console.error('Ошибка загрузки:', error);
        }
    }

    async function handleChange(fieldName, newValue) {
        try {
            const response = await fetch('/Home/ProcessSelection', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    car: currentCar,
                    changedField: fieldName,
                    newValue: newValue
                })
            });
            const result = await response.json();
            updateCar(result.car);
            updateUI(result);
        } catch (error) {
            console.error('Ошибка:', error);
        }
    }

    function updateCar(newCar) {
        currentCar = {
            brand: newCar.brand || '',
            model: newCar.model || '',
            generation: newCar.generation || '',
            engine: newCar.engine || ''
        };
        console.log('Машина обновлена:', currentCar);
    }

    function updateUI(result) {
        updateDropdownValues();
        if (result.nextField && result.nextField !== 'complete') {
            updateDropdown(result.nextField, result.options);
        }
        if (result.nextField === 'complete') {
            showSuccessButton();
        } else {
            hideSuccessButton();
        }
        if (result.nextField && result.nextField !== 'complete') {
            resetDropdownsAfter(result.nextField);
        }
    }

    function updateDropdownValues() {
        if (currentCar.brand) document.getElementById('brandDropdown').value = currentCar.brand;
        if (currentCar.model) document.getElementById('modelDropdown').value = currentCar.model;
        if (currentCar.generation) document.getElementById('generationDropdown').value = currentCar.generation;
        if (currentCar.engine) document.getElementById('engineDropdown').value = currentCar.engine;
    }

    function updateDropdown(fieldName, options) {
        const dropdownId = fieldName + 'Dropdown';
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        const currentValue = dropdown.value;
        dropdown.innerHTML = '';
        const emptyOption = document.createElement('option');
        emptyOption.value = '';
        emptyOption.textContent = getPlaceholder(fieldName);
        dropdown.appendChild(emptyOption);
        if (options && options.length > 0) {
            options.forEach(option => {
                const opt = document.createElement('option');
                opt.value = option;
                opt.textContent = option;
                dropdown.appendChild(opt);
            });
        }
        if (currentValue && options && options.includes(currentValue)) {
            dropdown.value = currentValue;
        } else {
            dropdown.value = currentCar[fieldName] || '';
        }
        dropdown.disabled = false;
        dropdown.onchange = function() { handleChange(fieldName, this.value); };
        setTimeout(() => dropdown.focus(), 50);
    }

    function resetDropdownsAfter(fieldName) {
        const fields = ['brand', 'model', 'generation', 'engine'];
        const startIndex = fields.indexOf(fieldName) + 1;
        for (let i = startIndex; i < fields.length; i++) {
            const dropdownId = fields[i] + 'Dropdown';
            const dropdown = document.getElementById(dropdownId);
            if (dropdown && !currentCar[fields[i]]) {
                const placeholder = getPlaceholder(fields[i]);
                dropdown.innerHTML = `<option value="">-- ${placeholder} --</option>`;
                dropdown.disabled = true;
                dropdown.onchange = null;
                currentCar[fields[i]] = '';
            }
        }
    }

    function getPlaceholder(fieldName) {
    // Получаем язык из cookie
    const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return 'ru';
    };
    const lang = getCookie('Language');
    
    const placeholders = {
        'brand': {
            'ru': 'Выберите бренд',
            'en': 'Select brand',
            'de': 'Marke wählen'
        },
        'model': {
            'ru': 'Выберите модель',
            'en': 'Select model',
            'de': 'Modell wählen'
        },
        'generation': {
            'ru': 'Выберите поколение',
            'en': 'Select generation',
            'de': 'Generation wählen'
        },
        'engine': {
            'ru': 'Выберите двигатель',
            'en': 'Select engine',
            'de': 'Motor wählen'
        }
    };
    
    return placeholders[fieldName]?.[lang] || 'Выберите';
}
    </script>
</body>
</html>