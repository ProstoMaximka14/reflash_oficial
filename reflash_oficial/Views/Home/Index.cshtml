    </style>
</head>
<body>

    <div class="hero-section" id="heroSection">
        <div class="slider-container">
            <div class="slider">
                @{
                    // Функция для получения стиля слайда с правильным путём
                    string GetSlideStyle(string imageName)
                    {
                        if (!string.IsNullOrEmpty(imageName))
                        {
                            var path = GetImagePath(imageName, "furst");
                            return $"background-image: url('{path}'); background-size: cover; background-position: center;";
                        }
                        else
                            return $"background: linear-gradient(45deg, #1A0B0E, #0F0F1A);";
                    }
                }
                <div class="slide active" style="@GetSlideStyle(furstPage?.image_1)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_2)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_3)"></div>
            </div>
            <div class="slider-dots">
                <span class="dot active" onclick="currentSlide(0)"></span>
                <span class="dot" onclick="currentSlide(1)"></span>
                <span class="dot" onclick="currentSlide(2)"></span>
            </div>
        </div>
        <div class="overlay"></div>

        @if (furstPage != null)
        {
            string head1 = currentLang == "ru" ? furstPage.head_1_ru :
            (currentLang == "en" ? furstPage.head_1_eng :
            (currentLang == "de" ? furstPage.head_1_ger : furstPage.head_1_ru));
