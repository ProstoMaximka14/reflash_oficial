            {
                <div class="main-title-bottom">@head1</div>
            }
        }

        <div class="content-wrapper">
            <div class="dropdowns-container">
                <!-- ===== ДЕСКТОПНЫЕ ДРОПДАУНЫ ===== -->
                <div class="dropdowns-row">
                    <div class="dropdown-section">
                        <label class="dropdown-label"> @(currentLang == "ru" ? "БРЕНД" : (currentLang == "en" ? "BRAND" : "MARKE"))</label>
                        <select class="dropdown-select" id="brandDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Загрузка..." : (currentLang == "en" ? "Loading..." : "Laden...")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label"> @(currentLang == "ru" ? "МОДЕЛЬ" : (currentLang == "en" ? "MODEL" : "MODELL"))</label>
                        <select class="dropdown-select" id="modelDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала бренд" : (currentLang == "en" ? "Select brand first" : "Marke zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label"> @(currentLang == "ru" ? "ПОКОЛЕНИЕ" : (currentLang == "en" ? "GENERATION" : "GENERATION"))</label>
                        <select class="dropdown-select" id="generationDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала модель" : (currentLang == "en" ? "Select model first" : "Modell zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label"> @(currentLang == "ru" ? "ДВИГАТЕЛЬ" : (currentLang == "en" ? "ENGINE" : "MOTOR"))</label>
                        <select class="dropdown-select" id="engineDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала поколение" : (currentLang == "en" ? "Select generation first" : "Generation zuerst")) --</option>
                        </select>
                    </div>
                </div>

                <!-- ===== МОБИЛЬНЫЕ ДРОПДАУНЫ ===== -->
                <div class="header-dropdowns">
                    <div class="header-dropdowns-grid">
                        <div class="spec-item">
                            <span class="spec-label">@(currentLang == "ru" ? "БРЕНД" : (currentLang == "en" ? "BRAND" : "MARKE"))</span>
                            <select class="dropdown-select" id="brandDropdownMobile" disabled>
                                <option value="">@(currentLang == "ru" ? "Нажмите" : (currentLang == "en" ? "Tap" : "Tippen"))</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">@(currentLang == "ru" ? "МОДЕЛЬ" : (currentLang == "en" ? "MODEL" : "MODELL"))</span>
                            <select class="dropdown-select" id="modelDropdownMobile" disabled>
                                <option value="">@(currentLang == "ru" ? "Нажмите" : (currentLang == "en" ? "Tap" : "Tippen"))</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">@(currentLang == "ru" ? "ПОКОЛЕНИЕ" : (currentLang == "en" ? "GENERATION" : "GENERATION"))</span>
                            <select class="dropdown-select" id="generationDropdownMobile" disabled>
                                <option value="">@(currentLang == "ru" ? "Нажмите" : (currentLang == "en" ? "Tap" : "Tippen"))</option>
                            </select>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label">@(currentLang == "ru" ? "ДВИГАТЕЛЬ" : (currentLang == "en" ? "ENGINE" : "MOTOR"))</span>
                            <select class="dropdown-select" id="engineDropdownMobile" disabled>
                                <option value="">@(currentLang == "ru" ? "Нажмите" : (currentLang == "en" ? "Tap" : "Tippen"))</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn-next-mobile" id="successButtonMobile" onclick="onSuccessButtonClick()">
                        @(currentLang == "ru" ? "ДАЛЕЕ →" : (currentLang == "en" ? "NEXT →" : "WEITER →"))
                    </button>
                </div>

                <div style="text-align: center;">
                    <button class="btn-next" id="successButton" onclick="onSuccessButtonClick()">
                        @(currentLang == "ru" ? "ДАЛЕЕ →" : (currentLang == "en" ? "NEXT →" : "WEITER →"))
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- БЛОКИ 1-6 С ЗАГОЛОВКАМИ ИЗ БД -->
    <!-- ============================================================ -->
    @if (furstPage != null)
    {
        // Получаем тексты и заголовки блоков на текущем языке
        var blocks = new List<string>();
        var blockTitles = new List<string>();
        
        if (currentLang == "ru")
        {
            blocks = new List<string> { furstPage.block_1_ru, furstPage.block_2_ru, furstPage.block_3_ru, furstPage.block_4_ru, furstPage.block_5_ru, furstPage.block_6_ru };
            blockTitles = new List<string> { furstPage.block_1_title_ru, furstPage.block_2_title_ru, furstPage.block_3_title_ru, furstPage.block_4_title_ru, furstPage.block_5_title_ru, furstPage.block_6_title_ru };
        }
        else if (currentLang == "en")
        {
            blocks = new List<string> { furstPage.block_1_eng, furstPage.block_2_eng, furstPage.block_3_eng, furstPage.block_4_eng, furstPage.block_5_eng, furstPage.block_6_eng };
            blockTitles = new List<string> { furstPage.block_1_title_eng, furstPage.block_2_title_eng, furstPage.block_3_title_eng, furstPage.block_4_title_eng, furstPage.block_5_title_eng, furstPage.block_6_title_eng };
        }
        else
        {
            blocks = new List<string> { furstPage.block_1_ger, furstPage.block_2_ger, furstPage.block_3_ger, furstPage.block_4_ger, furstPage.block_5_ger, furstPage.block_6_ger };
            blockTitles = new List<string> { furstPage.block_1_title_ger, furstPage.block_2_title_ger, furstPage.block_3_title_ger, furstPage.block_4_title_ger, furstPage.block_5_title_ger, furstPage.block_6_title_ger };
        }

        bool hasAnyBlock = blocks.Any(b => !string.IsNullOrEmpty(b));
        if (hasAnyBlock)
        {
            <div class="blocks-section">
                <div class="blocks-container">
                    @for (int i = 0; i < blocks.Count; i++)
                    {
                        if (!string.IsNullOrEmpty(blocks[i]))
                        {
                            // Если заголовок пустой, показываем STAGE 0X
                            var title = !string.IsNullOrEmpty(blockTitles[i]) ? blockTitles[i] : $"STAGE 0{i + 1}";
                            <div class="block-card">
                                <div class="block-title">@title</div>
                                <div class="block-text">@blocks[i]</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }

    @if (furstPage != null)
    {
        string head2 = "";
        if (currentLang == "ru") head2 = furstPage.head_2_ru;
        else if (currentLang == "en") head2 = furstPage.head_2_eng;
        else if (currentLang == "de") head2 = furstPage.head_2_ger;
        else head2 = furstPage.head_2_ru;

        string text = "";
        if (currentLang == "ru") text = furstPage.text_ru;
        else if (currentLang == "en") text = furstPage.text_eng;
        else if (currentLang == "de") text = furstPage.text_ger;
        else text = furstPage.text_ru;

        <div class="info-section">
            <div class="info-container">
                @if (!string.IsNullOrEmpty(head2))
                {
                    <div class="section-title">@head2</div>
                }
                <div class="image-frame-container" style="background-image: url('@(GetImagePath(furstPage.image_4, "furst") ?? "/images/default-bg.jpg")');">
                    <div class="frame-content">
                        @if (!string.IsNullOrEmpty(text))
                        {
                            <div class="info-text">@Html.Raw(text.Replace("\n", "<br/>"))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="brands-section-bottom">
        <div class="brands-title-bottom">
            @(currentLang == "ru" ? "Список автомобилей по бренду" : (currentLang == "en" ? "Choose brand" : "Marke wählen"))
        </div>
        <div class="brands-grid-bottom">
            <a href="@Url.Action("CarsByBrand", "Home", new { brand = "Honda" })" class="brand-card-bottom honda">
                <span class="brand-logo">
                    <img src="/shared-fotos/logo/honda_logo_black.png" 
                        alt="Honda"
                        class="logo-light"
                        width="180" 
                        height="180"
                        style="display: block; margin: 0 auto;">
                    <img src="/shared-fotos/logo/honda_logo_white.png" 
                        alt="Honda"
                        class="logo-dark"
                        width="180" 
                        height="180"
                        style="display: none; margin: 0 auto;">
                </span>
            </a>

            <a href="@Url.Action("CarsByBrand", "Home", new { brand = "Acura" })" class="brand-card-bottom honda">
                <span class="brand-logo">
                    <img src="/shared-fotos/logo/acura_logo_black.png" 
                        alt="Acura" 
                        width="180" 
                        height="180"
                        style="display: block; margin: 0 auto;">
                    <img src="/shared-fotos/logo/acura_logo_black_negate.png" 
                        alt="Acura"
                        class="logo-dark"
                        width="180" 
                        height="180"
                        style="display: none; margin: 0 auto;">
                </span>
            </a>
        </div>
    </div>

    <script>
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        let currentSlideIndex = 0;
        let slideInterval;

        function showSlide(index) {
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('.dot');
            if (!slides.length) return;
            if (index >= slides.length) currentSlideIndex = 0;
            if (index < 0) currentSlideIndex = slides.length - 1;
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            slides[currentSlideIndex].classList.add('active');
            if (dots[currentSlideIndex]) dots[currentSlideIndex].classList.add('active');
        }

        function nextSlide() { currentSlideIndex++; showSlide(currentSlideIndex); resetInterval(); }
        function prevSlide() { currentSlideIndex--; showSlide(currentSlideIndex); resetInterval(); }
        function currentSlide(index) { currentSlideIndex = index; showSlide(currentSlideIndex); resetInterval(); }

        function resetInterval() {
            if (slideInterval) clearInterval(slideInterval);
            if (document.querySelectorAll('.slide').length > 1) {
                slideInterval = setInterval(() => { currentSlideIndex++; showSlide(currentSlideIndex); }, 60000);
            }
        }

        let currentCar = {
            brand: '@Model.Brand',
            model: '@Model.Model',
            generation: '@Model.Generation',
            engine: '@Model.Engine'
        };

        document.addEventListener('DOMContentLoaded', async function () {
            await loadInitialData();
            if (isCarComplete()) showSuccessButton();
            if (document.querySelectorAll('.slide').length > 1) resetInterval();
        });

        function isCarComplete() {
            return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine;
        }

        function showSuccessButton() {
            const btn = document.getElementById('successButton');
            const btnMobile = document.getElementById('successButtonMobile');
            if (btn) btn.style.display = 'inline-block';
            if (btnMobile) btnMobile.classList.add('show');
        }

        function hideSuccessButton() {
            const btn = document.getElementById('successButton');
            const btnMobile = document.getElementById('successButtonMobile');
            if (btn) btn.style.display = 'none';
            if (btnMobile) btnMobile.classList.remove('show');
        }

        function onSuccessButtonClick() {
    if (!isCarComplete()) {
        const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
        const msg = lang === 'ru' ? 'Заполните все поля для расчета Stage' : (lang === 'en' ? 'Please fill all fields' : 'Bitte füllen Sie alle Felder');
        alert(msg);
        return;
    }
    
    // ===== ФУНКЦИЯ ТРАНСЛИТЕРАЦИИ =====
    function transliterate(text) {
        if (!text) return '';
        var map = {
            'А': 'A', 'Б': 'B', 'В': 'V', 'Г': 'G', 'Д': 'D',
            'Е': 'E', 'Ё': 'Yo', 'Ж': 'Zh', 'З': 'Z', 'И': 'I',
            'Й': 'Y', 'К': 'K', 'Л': 'L', 'М': 'M', 'Н': 'N',
            'О': 'O', 'П': 'P', 'Р': 'R', 'С': 'S', 'Т': 'T',
            'У': 'U', 'Ф': 'F', 'Х': 'Kh', 'Ц': 'Ts', 'Ч': 'Ch',
            'Ш': 'Sh', 'Щ': 'Sch', 'Ъ': '', 'Ы': 'Y', 'Ь': '',
            'Э': 'E', 'Ю': 'Yu', 'Я': 'Ya',
            'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd',
            'е': 'e', 'ё': 'yo', 'ж': 'zh', 'з': 'z', 'и': 'i',
            'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n',
            'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't',
            'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch',
            'ш': 'sh', 'щ': 'sch', 'ъ': '', 'ы': 'y', 'ь': '',
            'э': 'e', 'ю': 'yu', 'я': 'ya'
        };
        var result = '';
        for (var i = 0; i < text.length; i++) {
            var ch = text[i];
            result += map[ch] || ch;
        }
        return result;
    }
    
    // Транслитерируем и заменяем пробелы на _
    var brand = transliterate(currentCar.brand).replace(/ /g, '_');
    var model = transliterate(currentCar.model).replace(/ /g, '_');
    var generation = transliterate(currentCar.generation).replace(/ /g, '_');
    var engine = transliterate(currentCar.engine).replace(/ /g, '_');
    
    // Кодируем для безопасности (но после транслитерации там только латиница)
    window.location.href = '/' + encodeURIComponent(brand) + '/' + encodeURIComponent(model) + '/' + encodeURIComponent(generation) + '/' + encodeURIComponent(engine);
}

        // ===== ПЛЕЙСХОЛДЕРЫ ДЛЯ МОБИЛЬНЫХ ДРОПДАУНОВ =====
        function getMobilePlaceholders() {
            const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
            return {
                brand: { ru: 'Нажмите', en: 'Tap', de: 'Tippen' },
                model: { ru: 'Нажмите', en: 'Tap', de: 'Tippen' },
                generation: { ru: 'Нажмите', en: 'Tap', de: 'Tippen' },
                engine: { ru: 'Нажмите', en: 'Tap', de: 'Tippen' }
            };
        }

        async function loadInitialData() {
    try {
        const response = await fetch('/Home/GetInitialData');
        const result = await response.json();
        updateCar(result.car);
        updateDropdown('brand', result.options);
        updateMobileDropdown('brand', result.options);
        
        // ===== ВОССТАНАВЛИВАЕМ ЗНАЧЕНИЯ ИЗ URL (если есть) =====
        var urlParams = new URLSearchParams(window.location.search);
        var brandParam = urlParams.get('brand');
        if (brandParam) {
            // Если есть параметр brand, устанавливаем его
            document.getElementById('brandDropdown').value = brandParam;
            document.getElementById('brandDropdownMobile').value = brandParam;
            // Триггерим событие изменения
            handleChange('brand', brandParam);
        }
    } catch (error) {
        console.error(error);
    }
}

        async function handleChange(fieldName, newValue) {
            try {
                const response = await fetch('/Home/ProcessSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ car: currentCar, changedField: fieldName, newValue: newValue })
                });
                const result = await response.json();
                updateCar(result.car);
                updateUI(result);
            } catch (error) {
                console.error(error);
            }
        }

        function updateCar(newCar) {
            currentCar = {
                brand: newCar.brand || '',
                model: newCar.model || '',
                generation: newCar.generation || '',
                engine: newCar.engine || ''
            };
        }

        function updateUI(result) {
            updateDropdownValues();
            updateMobileDropdownValues();
            
            if (result.nextField && result.nextField !== 'complete') {
                updateDropdown(result.nextField, result.options);
                updateMobileDropdown(result.nextField, result.options);
            }
            
            if (result.nextField === 'complete') {
                showSuccessButton();
            } else {
                hideSuccessButton();
            }
            
            if (result.nextField && result.nextField !== 'complete') {
                resetDropdownsAfter(result.nextField);
                resetMobileDropdownsAfter(result.nextField);
            }
        }

        function updateDropdownValues() {
            if (currentCar.brand) document.getElementById('brandDropdown').value = currentCar.brand;
            if (currentCar.model) document.getElementById('modelDropdown').value = currentCar.model;
            if (currentCar.generation) document.getElementById('generationDropdown').value = currentCar.generation;
            if (currentCar.engine) document.getElementById('engineDropdown').value = currentCar.engine;
        }

        function updateMobileDropdownValues() {
            if (currentCar.brand) document.getElementById('brandDropdownMobile').value = currentCar.brand;
            if (currentCar.model) document.getElementById('modelDropdownMobile').value = currentCar.model;
            if (currentCar.generation) document.getElementById('generationDropdownMobile').value = currentCar.generation;
            if (currentCar.engine) document.getElementById('engineDropdownMobile').value = currentCar.engine;
        }

        function updateDropdown(fieldName, options) {
            const dropdown = document.getElementById(fieldName + 'Dropdown');
            if (!dropdown) return;

            const currentValue = dropdown.value;
            dropdown.innerHTML = '';

            const emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = getPlaceholder(fieldName);
            dropdown.appendChild(emptyOption);

            if (options && options.length > 0) {
                options.forEach(opt => {
                    const op = document.createElement('option');
                    op.value = opt;
                    op.textContent = opt;
                    dropdown.appendChild(op);
                });
            }

            if (currentValue && options && options.includes(currentValue)) {
                dropdown.value = currentValue;
            } else {
                dropdown.value = currentCar[fieldName] || '';
            }

            dropdown.disabled = false;
            dropdown.onchange = function() {
                handleChange(fieldName, this.value);
            };
        }

        function updateMobileDropdown(fieldName, options) {
            const dropdown = document.getElementById(fieldName + 'DropdownMobile');
            if (!dropdown) return;

            const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
            const placeholders = getMobilePlaceholders();
            
            const currentValue = dropdown.value;
            dropdown.innerHTML = '';

            const emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = placeholders[fieldName]?.[lang] || 'Нажмите';
            dropdown.appendChild(emptyOption);

            if (options && options.length > 0) {
                options.forEach(opt => {
                    const op = document.createElement('option');
                    op.value = opt;
                    op.textContent = opt;
                    dropdown.appendChild(op);
                });
            }

            if (currentValue && options && options.includes(currentValue)) {
                dropdown.value = currentValue;
            } else {
                dropdown.value = currentCar[fieldName] || '';
            }

            dropdown.disabled = false;
            dropdown.onchange = function() {
                handleChange(fieldName, this.value);
            };
        }

        function resetDropdownsAfter(fieldName) {
            const fields = ['brand', 'model', 'generation', 'engine'];
            const start = fields.indexOf(fieldName) + 1;
            for (let i = start; i < fields.length; i++) {
                const d = document.getElementById(fields[i] + 'Dropdown');
                if (d && !currentCar[fields[i]]) {
                    d.innerHTML = `<option value="">-- ${getPlaceholder(fields[i])} --</option>`;
                    d.disabled = true;
                    d.onchange = null;
                    currentCar[fields[i]] = '';
                }
            }
        }

        function resetMobileDropdownsAfter(fieldName) {
            const fields = ['brand', 'model', 'generation', 'engine'];
            const start = fields.indexOf(fieldName) + 1;
            const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
            const placeholders = getMobilePlaceholders();
            
            for (let i = start; i < fields.length; i++) {
                const d = document.getElementById(fields[i] + 'DropdownMobile');
                if (d && !currentCar[fields[i]]) {
                    d.innerHTML = `<option value="">${placeholders[fields[i]]?.[lang] || 'Нажмите'}</option>`;
                    d.disabled = true;
                    d.onchange = null;
                }
            }
        }

        function getPlaceholder(fieldName) {
            const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
            const p = {
                brand: { ru: 'Выберите бренд', en: 'Select brand', de: 'Marke wählen' },
                model: { ru: 'Выберите модель', en: 'Select model', de: 'Modell wählen' },
                generation: { ru: 'Выберите поколение', en: 'Select generation', de: 'Generation wählen' },
                engine: { ru: 'Выберите двигатель', en: 'Select engine', de: 'Motor wählen' }
            };
            return p[fieldName]?.[lang] || 'Выберите';
        }
    </script>
</body>
</html>
