@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "Выбор автомобиля";

    // Получаем текущий язык из сессии или cookies
    var currentLang = Context.Request.Cookies["Language"] ?? "ru";

    // Получаем данные главной страницы из ViewBag
    var furstPage = ViewBag.FurstPage as reflash_oficial.Models.FurstPageModel;
}

<!DOCTYPE html>
<html lang="@currentLang" data-theme="@(Context.Request.Cookies["Theme"] ?? "dark")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — Performance Tuning</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ==========================================
                                   CSS ПЕРЕМЕННЫЕ ДЛЯ ТЕМ
                                   ========================================== */

        /* Светлая тема (по умолчанию) */
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-overlay: rgba(255, 255, 255, 0.9);
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --gradient-start: #f8f9fa;
            --gradient-end: #e9ecef;
            --slider-overlay: rgba(255, 255, 255, 0.4);
            --block-bg: #ffffff;
            --block-border: #e0e0e0;
            --frame-bg: rgba(255, 255, 255, 0.95);
            --frame-text: #1a1a2e;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
        }

        /* Тёмная тема */
        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-overlay: rgba(10, 10, 15, 0.9);
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.5);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --gradient-start: #111118;
            --gradient-end: #0D0D14;
            --slider-overlay: rgba(0, 0, 0, 0.85);
            --block-bg: #111118;
            --block-border: #252530;
            --frame-bg: rgba(10, 10, 15, 0.85);
            --frame-text: #E8E8F0;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
        }

        /* ==========================================
                                   ОБЩИЕ СТИЛИ
                                   ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* Кастомный скролл */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 10px;
        }

        /* ========== ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА ========== */
        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: var(--bg-overlay);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid var(--border-color);
            box-shadow: 0 8px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

            .lang-btn:hover {
                color: var(--text-primary);
                background: rgba(255,58,47,0.1);
            }

            .lang-btn.active {
                background: var(--accent-color);
                color: white;
                box-shadow: 0 0 8px rgba(255,58,47,0.5);
            }

        /* ========== HERO SLIDER ========== */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .slider-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .slider {
            width: 100%;
            height: 100%;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
            transform: scale(1.05);
        }

            .slide.active {
                opacity: 1;
                transform: scale(1);
            }

        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: var(--bg-overlay);
            backdrop-filter: blur(8px);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            width: 44px;
            height: 44px;
            cursor: pointer;
            font-size: 20px;
            border-radius: 50%;
            transition: all 0.2s;
            z-index: 15;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .slider-btn:hover {
                background: var(--accent-color);
                border-color: var(--accent-color);
                color: white;
            }

        .prev {
            left: 30px;
        }

        .next {
            right: 30px;
        }

        .slider-dots {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            z-index: 15;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
            opacity: 0.5;
        }

            .dot.active {
                background: var(--accent-color);
                width: 28px;
                border-radius: 10px;
                box-shadow: 0 0 8px var(--accent-color);
                opacity: 1;
            }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, rgba(0,0,0,0.3) 0%, var(--slider-overlay) 100%);
            z-index: 1;
            transition: background 0.3s ease;
        }

        /* ========== ОСНОВНОЙ КОНТЕНТ ========== */
        .content-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            padding: 40px 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* ===== ДРОПДАУНЫ ===== */
        .dropdowns-container {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            border-radius: 32px;
            padding: 40px 36px;
            max-width: 1300px;
            width: 90%;
            margin: 0 auto;
            border: 1px solid var(--border-color);
            box-shadow: 0 25px 45px -12px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .dropdowns-row {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .dropdown-section {
            flex: 1;
            min-width: 200px;
        }

        .dropdown-label {
            display: block;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--accent-color);
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .dropdown-select {
            width: 100%;
            padding: 14px 18px;
            font-size: 15px;
            font-weight: 500;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', monospace;
        }

            .dropdown-select:focus {
                border-color: var(--accent-color);
                outline: none;
                box-shadow: 0 0 0 3px rgba(255,58,47,0.2);
            }

            .dropdown-select:disabled {
                background: var(--bg-secondary);
                color: var(--text-muted);
                cursor: not-allowed;
                border-color: var(--border-color);
            }

        .btn-next {
            margin-top: 40px;
            padding: 14px 42px;
            background: linear-gradient(95deg, var(--accent-color) 0%, var(--accent-hover) 100%);
            border: none;
            border-radius: 60px;
            color: white;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 1.2px;
            cursor: pointer;
            transition: all 0.2s;
            display: none;
            text-transform: uppercase;
            box-shadow: 0 8px 20px rgba(255,58,47,0.3);
        }

            .btn-next:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 28px rgba(255,58,47,0.5);
            }

        /* Заголовок head_1 */
        .main-title-bottom {
            position: absolute;
            bottom: 90px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            background: linear-gradient(135deg, #FFFFFF 0%, #FFB5A0 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            max-width: 80%;
            margin: 0 auto;
            letter-spacing: -0.2px;
            z-index: 20;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            pointer-events: none;
        }

        /* ========== БЛОКИ 1-6 ========== */
        .blocks-section {
            padding: 80px 24px;
            background: var(--bg-secondary);
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .blocks-container {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 28px;
        }

        .block-card {
            background: var(--block-bg);
            padding: 32px 28px;
            border-radius: 28px;
            border: 1px solid var(--block-border);
            transition: all 0.25s;
            text-align: left;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

            .block-card:hover {
                transform: translateY(-8px);
                border-color: var(--accent-color);
                box-shadow: 0 20px 30px -12px rgba(255,58,47,0.2);
            }

        .block-number {
            font-size: 14px;
            font-weight: 700;
            color: var(--accent-color);
            margin-bottom: 16px;
            letter-spacing: 2px;
        }

        .block-text {
            font-size: 16px;
            line-height: 1.5;
            color: var(--text-secondary);
            font-weight: 400;
        }

        /* ========== СЕКЦИЯ С РАМКОЙ ========== */
        .info-section {
            padding: 80px 24px;
            background: var(--bg-primary);
            transition: background 0.3s ease;
        }

        .section-title {
            text-align: center;
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 48px;
            letter-spacing: -0.5px;
            background: linear-gradient(120deg, var(--text-primary), var(--accent-color));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .image-frame-container {
            position: relative;
            background-size: cover;
            background-position: center;
            border-radius: 36px;
            padding: 80px 40px;
            min-height: 520px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            box-shadow: 0 30px 40px -20px var(--shadow-color);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .image-frame-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(ellipse at center, rgba(0,0,0,0.3) 0%, var(--slider-overlay) 100%);
                border-radius: 36px;
                z-index: 1;
                transition: background 0.3s ease;
            }

        .frame-content {
            position: relative;
            z-index: 2;
            background: var(--frame-bg);
            backdrop-filter: blur(12px);
            border-radius: 32px;
            padding: 48px 52px;
            max-width: 900px;
            width: 100%;
            text-align: center;
            border: 1px solid var(--border-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .info-text {
            font-size: 18px;
            line-height: 1.6;
            color: var(--frame-text);
            font-weight: 400;
            transition: color 0.3s ease;
        }

        /* ========== БЛОК С КНОПКАМИ БРЕНДОВ (ВНИЗУ) ========== */
        .brands-section-bottom {
            padding: 60px 24px 40px;
            background: var(--bg-primary);
            border-top: 1px solid var(--border-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .brands-title-bottom {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 30px;
            color: var(--text-primary);
        }

            .brands-title-bottom i {
                color: var(--accent-color);
                margin-right: 10px;
            }

        .brands-grid-bottom {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            max-width: 800px;
            margin: 0 auto;
        }

        .brand-card-bottom {
            background: var(--bg-card);
            border: 2px solid var(--border-color);
            border-radius: 24px;
            padding: 40px 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            color: var(--text-primary);
            box-shadow: 0 4px 20px var(--shadow-color);
        }

            .brand-card-bottom:hover {
                transform: translateY(-8px);
                border-color: var(--accent-color);
                box-shadow: 0 20px 30px -12px var(--shadow-hover);
            }

            .brand-card-bottom .brand-logo {
                font-size: 64px;
                display: block;
                margin-bottom: 12px;
            }

            .brand-card-bottom .brand-name {
                font-size: 28px;
                font-weight: 800;
                display: block;
                margin-bottom: 4px;
            }

            .brand-card-bottom .brand-count {
                font-size: 14px;
                color: var(--text-muted);
            }

            /* Специфичные цвета для брендов */
            .brand-card-bottom.honda:hover {
                border-color: #E63946;
            }

            .brand-card-bottom.acura:hover {
                border-color: #1A1A2E;
            }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .language-switcher {
                top: 16px;
                right: 16px;
                padding: 4px 10px;
                gap: 4px;
            }

            .lang-btn {
                padding: 4px 10px;
                font-size: 10px;
            }

            .brands-grid-bottom {
                grid-template-columns: 1fr;
                max-width: 400px;
                gap: 16px;
            }

            .brand-card-bottom {
                padding: 30px 20px;
            }

                .brand-card-bottom .brand-logo {
                    font-size: 48px;
                }

                .brand-card-bottom .brand-name {
                    font-size: 22px;
                }

            .brands-title-bottom {
                font-size: 22px;
            }

            .dropdowns-container {
                padding: 28px 20px;
                width: 95%;
            }

            .blocks-container {
                grid-template-columns: 1fr;
            }

            .image-frame-container {
                padding: 30px 20px;
                min-height: 350px;
            }

            .frame-content {
                padding: 28px 20px;
            }

            .info-text {
                font-size: 15px;
            }

            .section-title {
                font-size: 28px;
            }

            .slider-btn {
                width: 36px;
                height: 36px;
                font-size: 16px;
            }

            .prev {
                left: 12px;
            }

            .next {
                right: 12px;
            }

            .block-card {
                padding: 24px;
            }

            .main-title-bottom {
                font-size: 18px;
                bottom: 75px;
                max-width: 90%;
            }
        }

        @@media (max-width: 480px) {
            .language-switcher {
                top: 12px;
                right: 12px;
                padding: 3px 8px;
                gap: 4px;
            }

            .lang-btn {
                padding: 3px 8px;
                font-size: 9px;
            }

            .brand-card-bottom .brand-logo {
                font-size: 36px;
            }

            .brand-card-bottom .brand-name {
                font-size: 18px;
            }

            .brands-title-bottom {
                font-size: 18px;
            }

            .dropdowns-row {
                flex-direction: column;
                gap: 16px;
            }

            .dropdown-section {
                min-width: auto;
            }

            .btn-next {
                width: 100%;
            }

            .main-title-bottom {
                font-size: 14px;
                bottom: 65px;
                max-width: 95%;
            }
        }
    </style>
</head>
<body>

    <!-- ===== ПЕРЕКЛЮЧАТЕЛЬ ЯЗЫКА ===== -->
    <div class="language-switcher">
        <button class="lang-btn lang-ru @(currentLang == "ru" ? "active" : "")" onclick="switchLanguage('ru')">
            RU
        </button>
        <button class="lang-btn lang-en @(currentLang == "en" ? "active" : "")" onclick="switchLanguage('en')">
            EN
        </button>
        <button class="lang-btn lang-de @(currentLang == "de" ? "active" : "")" onclick="switchLanguage('de')">
            DE
        </button>
    </div>

    <div class="hero-section" id="heroSection">
        <div class="slider-container">
            <div class="slider">
                @{
                    string GetSlideStyle(string imageUrl, int index)
                    {
                        if (!string.IsNullOrEmpty(imageUrl))
                            return $"background-image: url('{imageUrl}'); background-size: cover; background-position: center;";
                        else
                            return $"background: linear-gradient(45deg, #1A0B0E, #0F0F1A);";
                    }
                }
                <div class="slide active" style="@GetSlideStyle(furstPage?.image_1, 0)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_2, 1)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_3, 2)"></div>
            </div>
            <div class="slider-dots">
                <span class="dot active" onclick="currentSlide(0)"></span>
                <span class="dot" onclick="currentSlide(1)"></span>
                <span class="dot" onclick="currentSlide(2)"></span>
            </div>
        </div>
        <div class="overlay"></div>

        <!-- ЗАГОЛОВОК head_1 -->
        @if (furstPage != null)
        {
            string head1 = currentLang == "ru" ? furstPage.head_1_ru :
            (currentLang == "en" ? furstPage.head_1_eng :
            (currentLang == "de" ? furstPage.head_1_ger : furstPage.head_1_ru));
            if (!string.IsNullOrEmpty(head1))
            {
                <div class="main-title-bottom">@head1</div>
            }
        }

        <div class="content-wrapper">
            <!-- Дропдауны -->
            <div class="dropdowns-container">
                <div class="dropdowns-row">
                    <div class="dropdown-section">
                        <label class="dropdown-label">⚡ @(currentLang == "ru" ? "БРЕНД" : (currentLang == "en" ? "BRAND" : "MARKE"))</label>
                        <select class="dropdown-select" id="brandDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Загрузка..." : (currentLang == "en" ? "Loading..." : "Laden...")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">🔧 @(currentLang == "ru" ? "МОДЕЛЬ" : (currentLang == "en" ? "MODEL" : "MODELL"))</label>
                        <select class="dropdown-select" id="modelDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала бренд" : (currentLang == "en" ? "Select brand first" : "Marke zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">📅 @(currentLang == "ru" ? "ПОКОЛЕНИЕ" : (currentLang == "en" ? "GENERATION" : "GENERATION"))</label>
                        <select class="dropdown-select" id="generationDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала модель" : (currentLang == "en" ? "Select model first" : "Modell zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">🔥 @(currentLang == "ru" ? "ДВИГАТЕЛЬ" : (currentLang == "en" ? "ENGINE" : "MOTOR"))</label>
                        <select class="dropdown-select" id="engineDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала поколение" : (currentLang == "en" ? "Select generation first" : "Generation zuerst")) --</option>
                        </select>
                    </div>
                </div>
                <div style="text-align: center;">
                    <button class="btn-next" id="successButton" onclick="onSuccessButtonClick()">
                        @(currentLang == "ru" ? "ДАЛЕЕ →" : (currentLang == "en" ? "NEXT →" : "WEITER →"))
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Блоки 1-6 -->
    @if (furstPage != null)
    {
        var blocks = new List<string>();
        if (currentLang == "ru") blocks = new List<string> { furstPage.block_1_ru, furstPage.block_2_ru, furstPage.block_3_ru, furstPage.block_4_ru, furstPage.block_5_ru, furstPage.block_6_ru };
        else if (currentLang == "en") blocks = new List<string> { furstPage.block_1_eng, furstPage.block_2_eng, furstPage.block_3_eng, furstPage.block_4_eng, furstPage.block_5_eng, furstPage.block_6_eng };
        else blocks = new List<string> { furstPage.block_1_ger, furstPage.block_2_ger, furstPage.block_3_ger, furstPage.block_4_ger, furstPage.block_5_ger, furstPage.block_6_ger };

        bool hasAnyBlock = blocks.Any(b => !string.IsNullOrEmpty(b));
        if (hasAnyBlock)
        {
            <div class="blocks-section">
                <div class="blocks-container">
                    @for (int i = 0; i < blocks.Count; i++)
                    {
                        if (!string.IsNullOrEmpty(blocks[i]))
                        {
                            <div class="block-card">
                                <div class="block-number">STAGE 0@(i + 1)</div>
                                <div class="block-text">@blocks[i]</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }

    <!-- Секция с рамкой -->
    @if (furstPage != null)
    {
        string head2 = "";
        if (currentLang == "ru") head2 = furstPage.head_2_ru;
        else if (currentLang == "en") head2 = furstPage.head_2_eng;
        else if (currentLang == "de") head2 = furstPage.head_2_ger;
        else head2 = furstPage.head_2_ru;

        string text = "";
        if (currentLang == "ru") text = furstPage.text_ru;
        else if (currentLang == "en") text = furstPage.text_eng;
        else if (currentLang == "de") text = furstPage.text_ger;
        else text = furstPage.text_ru;

        <div class="info-section">
            <div class="info-container">
                @if (!string.IsNullOrEmpty(head2))
                {
                    <div class="section-title">@head2</div>
                }
                <div class="image-frame-container" style="background-image: url('@(furstPage.image_4 ?? "/images/default-bg.jpg")');">
                    <div class="frame-content">
                        @if (!string.IsNullOrEmpty(text))
                        {
                            <div class="info-text">@Html.Raw(text.Replace("\n", "<br/>"))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ===== КНОПКИ ВЫБОРА БРЕНДА (ВНИЗУ) ===== -->
    <div class="brands-section-bottom">
        <div class="brands-title-bottom">
            
            @(currentLang == "ru" ? "Список автомобилей по бренду" : (currentLang == "en" ? "Choose brand" : "Marke wählen"))
        </div>
        <div class="brands-grid-bottom">
            <!-- Honda -->
            <a href="@Url.Action("CarsByBrand", "Home", new { brand = "Honda" })" class="brand-card-bottom honda">
                <span class="brand-logo">🏎️</span>
                <span class="brand-name">Honda</span>
                
            </a>

            <!-- Acura -->
            <a href="@Url.Action("CarsByBrand", "Home", new { brand = "Acura" })" class="brand-card-bottom acura">
                <span class="brand-logo">⭐</span>
                <span class="brand-name">Acura</span>
                
            </a>
        </div>
    </div>

    <script>
        // ==========================================
        // ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА
        // ==========================================
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ==========================================
        // СЛАЙДЕР
        // ==========================================
        let currentSlideIndex = 0;
        let slideInterval;

        function showSlide(index) {
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('.dot');
            if (!slides.length) return;
            if (index >= slides.length) currentSlideIndex = 0;
            if (index < 0) currentSlideIndex = slides.length - 1;
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            slides[currentSlideIndex].classList.add('active');
            if (dots[currentSlideIndex]) dots[currentSlideIndex].classList.add('active');
        }

        function nextSlide() { currentSlideIndex++; showSlide(currentSlideIndex); resetInterval(); }
        function prevSlide() { currentSlideIndex--; showSlide(currentSlideIndex); resetInterval(); }
        function currentSlide(index) { currentSlideIndex = index; showSlide(currentSlideIndex); resetInterval(); }

        function resetInterval() {
            if (slideInterval) clearInterval(slideInterval);
            if (document.querySelectorAll('.slide').length > 1) {
                slideInterval = setInterval(() => { currentSlideIndex++; showSlide(currentSlideIndex); }, 60000);
            }
        }

        // ==========================================
        // ДРОПДАУНЫ
        // ==========================================
        let currentCar = {
            brand: '@Model.Brand',
            model: '@Model.Model',
            generation: '@Model.Generation',
            engine: '@Model.Engine'
        };

        document.addEventListener('DOMContentLoaded', async function () {
            await loadInitialData();
            if (isCarComplete()) showSuccessButton();
            if (document.querySelectorAll('.slide').length > 1) resetInterval();
        });

        function isCarComplete() { return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine; }
        function showSuccessButton() { const btn = document.getElementById('successButton'); if (btn) btn.style.display = 'inline-block'; }
        function hideSuccessButton() { const btn = document.getElementById('successButton'); if (btn) btn.style.display = 'none'; }

        function onSuccessButtonClick() {
            if (!isCarComplete()) {
                const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
                const msg = lang === 'ru' ? 'Заполните все поля для расчета Stage' : (lang === 'en' ? 'Please fill all fields' : 'Bitte füllen Sie alle Felder');
                alert(msg);
                return;
            }
            const brand = encodeURIComponent(currentCar.brand);
            const model = encodeURIComponent(currentCar.model);
            const generation = encodeURIComponent(currentCar.generation);
            const engine = encodeURIComponent(currentCar.engine);
            window.location.href = `/${brand}/${model}/${generation}/${engine}`;
        }

        async function loadInitialData() {
            try {
                const response = await fetch('/Home/GetInitialData');
                const result = await response.json();
                updateCar(result.car);
                updateDropdown(result.nextField, result.options);
            } catch (error) { console.error(error); }
        }

        async function handleChange(fieldName, newValue) {
            try {
                const response = await fetch('/Home/ProcessSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ car: currentCar, changedField: fieldName, newValue: newValue })
                });
                const result = await response.json();
                updateCar(result.car);
                updateUI(result);
            } catch (error) { console.error(error); }
        }

        function updateCar(newCar) { currentCar = { brand: newCar.brand || '', model: newCar.model || '', generation: newCar.generation || '', engine: newCar.engine || '' }; }
        function updateUI(result) {
            updateDropdownValues();
            if (result.nextField && result.nextField !== 'complete') updateDropdown(result.nextField, result.options);
            if (result.nextField === 'complete') showSuccessButton(); else hideSuccessButton();
            if (result.nextField && result.nextField !== 'complete') resetDropdownsAfter(result.nextField);
        }
        function updateDropdownValues() { if (currentCar.brand) document.getElementById('brandDropdown').value = currentCar.brand; if (currentCar.model) document.getElementById('modelDropdown').value = currentCar.model; if (currentCar.generation) document.getElementById('generationDropdown').value = currentCar.generation; if (currentCar.engine) document.getElementById('engineDropdown').value = currentCar.engine; }
        function updateDropdown(fieldName, options) {
            const dropdown = document.getElementById(fieldName + 'Dropdown');
            if (!dropdown) return;
            const currentValue = dropdown.value;
            dropdown.innerHTML = '';
            const emptyOption = document.createElement('option'); emptyOption.value = ''; emptyOption.textContent = getPlaceholder(fieldName); dropdown.appendChild(emptyOption);
            if (options && options.length > 0) options.forEach(opt => { const op = document.createElement('option'); op.value = opt; op.textContent = opt; dropdown.appendChild(op); });
            if (currentValue && options && options.includes(currentValue)) dropdown.value = currentValue; else dropdown.value = currentCar[fieldName] || '';
            dropdown.disabled = false;
            dropdown.onchange = function() { handleChange(fieldName, this.value); };
        }
        function resetDropdownsAfter(fieldName) { const fields = ['brand','model','generation','engine']; const start = fields.indexOf(fieldName)+1; for(let i=start; i<fields.length; i++) { const d = document.getElementById(fields[i]+'Dropdown'); if(d && !currentCar[fields[i]]) { d.innerHTML = `<option value="">-- ${getPlaceholder(fields[i])} --</option>`; d.disabled = true; d.onchange = null; currentCar[fields[i]] = ''; } } }
        function getPlaceholder(fieldName) { const lang = document.cookie.split('; ').find(row=>row.startsWith('Language='))?.split('=')[1]||'ru'; const p = { brand:{ru:'Выберите бренд',en:'Select brand',de:'Marke wählen'}, model:{ru:'Выберите модель',en:'Select model',de:'Modell wählen'}, generation:{ru:'Выберите поколение',en:'Select generation',de:'Generation wählen'}, engine:{ru:'Выберите двигатель',en:'Select engine',de:'Motor wählen'} }; return p[fieldName]?.[lang]||'Выберите'; }
    </script>
</body>
</html>