@model reflash_oficial.Models.ReflashCarModel
@{
    ViewData["Title"] = "Выбор автомобиля";
    
    // Получаем текущий язык из сессии или cookies
    var currentLang = Context.Request.Cookies["Language"] ?? "ru";
    
    // Получаем данные главной страницы из ViewBag
    var furstPage = ViewBag.FurstPage as reflash_oficial.Models.FurstPageModel;
}

<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — Performance Tuning</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0A0A0F;
            color: #E8E8F0;
            overflow-x: hidden;
        }

        /* Кастомный скролл */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #14141C;
        }
        ::-webkit-scrollbar-thumb {
            background: #FF3A2F;
            border-radius: 10px;
        }

        /* ========== ЯЗЫКОВОЙ СВИТЧЕР (ТЕМНЫЙ) ========== */
        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: rgba(10, 10, 15, 0.8);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid rgba(255, 58, 47, 0.3);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: #A0A0B0;
            letter-spacing: 0.3px;
        }

        .lang-btn:hover {
            color: white;
            background: rgba(255,58,47,0.2);
        }

        .lang-btn.active {
            background: #FF3A2F;
            color: white;
            box-shadow: 0 0 8px rgba(255,58,47,0.5);
        }

        /* ========== HERO SLIDER ========== */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .slider-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .slider {
            width: 100%;
            height: 100%;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
            transform: scale(1.05);
        }

        .slide.active {
            opacity: 1;
            transform: scale(1);
        }

        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(8px);
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
            width: 44px;
            height: 44px;
            cursor: pointer;
            font-size: 20px;
            border-radius: 50%;
            transition: all 0.2s;
            z-index: 15;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .slider-btn:hover {
            background: #FF3A2F;
            border-color: #FF3A2F;
        }

        .prev { left: 30px; }
        .next { right: 30px; }

        .slider-dots {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            z-index: 15;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.4);
            cursor: pointer;
            transition: all 0.2s;
        }

        .dot.active {
            background: #FF3A2F;
            width: 28px;
            border-radius: 10px;
            box-shadow: 0 0 8px #FF3A2F;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.85) 100%);
            z-index: 1;
        }

        /* ========== ОСНОВНОЙ КОНТЕНТ ========== */
        .content-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            padding: 40px 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Glassmorph карточка для дропдаунов */
        .dropdowns-container {
            background: rgba(15, 15, 25, 0.85);
            backdrop-filter: blur(20px);
            border-radius: 32px;
            padding: 40px 36px;
            max-width: 1300px;
            width: 90%;
            margin: 0 auto;
            border: 1px solid rgba(255, 58, 47, 0.3);
            box-shadow: 0 25px 45px -12px rgba(0,0,0,0.6);
            transition: transform 0.3s ease;
        }

        .dropdowns-row {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .dropdown-section {
            flex: 1;
            min-width: 200px;
        }

        .dropdown-label {
            display: block;
            font-weight: 600;
            margin-bottom: 10px;
            color: #FF3A2F;
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .dropdown-select {
            width: 100%;
            padding: 14px 18px;
            font-size: 15px;
            font-weight: 500;
            background: #0C0C14;
            border: 1px solid #2A2A35;
            border-radius: 20px;
            color: #F0F0F8;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Inter', monospace;
        }

        .dropdown-select:focus {
            border-color: #FF3A2F;
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,58,47,0.2);
        }

        .dropdown-select:disabled {
            background: #0A0A0F;
            color: #5A5A6E;
            cursor: not-allowed;
            border-color: #22222B;
        }

        /* Кнопка NEXT — неоновая */
        .btn-next {
            margin-top: 40px;
            padding: 14px 42px;
            background: linear-gradient(95deg, #FF3A2F 0%, #D62B1F 100%);
            border: none;
            border-radius: 60px;
            color: white;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 1.2px;
            cursor: pointer;
            transition: all 0.2s;
            display: none;
            text-transform: uppercase;
            box-shadow: 0 8px 20px rgba(255,58,47,0.3);
        }

        .btn-next:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(255,58,47,0.5);
            background: linear-gradient(95deg, #FF4A3F 0%, #E63528 100%);
        }

        /* Заголовок head_1 — в самом низу карусели, над точками */
        .main-title-bottom {
            position: absolute;
            bottom: 90px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            background: linear-gradient(135deg, #FFFFFF 0%, #FFB5A0 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            max-width: 80%;
            margin: 0 auto;
            letter-spacing: -0.2px;
            z-index: 20;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            pointer-events: none;
        }

        /* Адаптивность для заголовка */
        @@media (max-width: 768px) {
            .main-title-bottom {
                font-size: 18px;
                bottom: 75px;
                max-width: 90%;
            }
        }

        @@media (max-width: 480px) {
            .main-title-bottom {
                font-size: 14px;
                bottom: 65px;
                max-width: 95%;
            }
        }

        /* ========== БЛОКИ 1-6 ========== */
        .blocks-section {
            padding: 80px 24px;
            background: #0A0A0F;
            border-top: 1px solid #1E1E2A;
            border-bottom: 1px solid #1E1E2A;
        }

        .blocks-container {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 28px;
        }

        .block-card {
            background: #111118;
            padding: 32px 28px;
            border-radius: 28px;
            border: 1px solid #252530;
            transition: all 0.25s;
            text-align: left;
        }

        .block-card:hover {
            transform: translateY(-8px);
            border-color: #FF3A2F;
            box-shadow: 0 20px 30px -12px rgba(255,58,47,0.2);
        }

        .block-number {
            font-size: 14px;
            font-weight: 700;
            color: #FF3A2F;
            margin-bottom: 16px;
            letter-spacing: 2px;
        }

        .block-text {
            font-size: 16px;
            line-height: 1.5;
            color: #C0C0D0;
            font-weight: 400;
        }

        /* ========== СЕКЦИЯ С РАМКОЙ ========== */
        .info-section {
            padding: 80px 24px;
            background: #050508;
        }

        .section-title {
            text-align: center;
            font-size: 38px;
            font-weight: 800;
            margin-bottom: 48px;
            letter-spacing: -0.5px;
            background: linear-gradient(120deg, #FFF, #FF8A7A);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .image-frame-container {
            position: relative;
            background-size: cover;
            background-position: center;
            border-radius: 36px;
            padding: 80px 40px;
            min-height: 520px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,58,47,0.3);
            box-shadow: 0 30px 40px -20px black;
        }

        .image-frame-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(ellipse at center, rgba(0,0,0,0.4) 0%, #050508 90%);
            border-radius: 36px;
            z-index: 1;
        }

        .frame-content {
            position: relative;
            z-index: 2;
            background: rgba(10, 10, 15, 0.85);
            backdrop-filter: blur(12px);
            border-radius: 32px;
            padding: 48px 52px;
            max-width: 900px;
            width: 100%;
            text-align: center;
            border: 1px solid rgba(255,58,47,0.4);
        }

        .info-text {
            font-size: 18px;
            line-height: 1.6;
            color: #E8E8F0;
            font-weight: 400;
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .dropdowns-container { padding: 28px 20px; width: 95%; }
            .blocks-container { grid-template-columns: 1fr; }
            .image-frame-container { padding: 30px 20px; }
            .frame-content { padding: 28px 20px; }
            .info-text { font-size: 15px; }
            .section-title { font-size: 28px; }
            .slider-btn { width: 36px; height: 36px; font-size: 16px; }
            .prev { left: 12px; }
            .next { right: 12px; }
            .language-switcher { top: 16px; right: 16px; padding: 4px 10px; gap: 4px; }
            .lang-btn { padding: 4px 10px; font-size: 10px; }
            .block-card { padding: 24px; }
        }

        @@media (max-width: 480px) {
            .dropdowns-row { flex-direction: column; gap: 16px; }
            .dropdown-section { min-width: auto; }
            .btn-next { width: 100%; }
        }
    </style>
</head>
<body>

    <div class="language-switcher">
        <button class="lang-btn lang-ru @(currentLang == "ru" ? "active" : "")" onclick="switchLanguage('ru')">
            🇷🇺 RU
        </button>
        <button class="lang-btn lang-en @(currentLang == "en" ? "active" : "")" onclick="switchLanguage('en')">
            🇬🇧 EN
        </button>
        <button class="lang-btn lang-de @(currentLang == "de" ? "active" : "")" onclick="switchLanguage('de')">
            🇩🇪 DE
        </button>
    </div>

    <div class="hero-section" id="heroSection">
        <div class="slider-container">
            <div class="slider">
                @{
                    string GetSlideStyle(string imageUrl, int index)
                    {
                        if (!string.IsNullOrEmpty(imageUrl))
                            return $"background-image: url('{imageUrl}'); background-size: cover; background-position: center;";
                        else
                            return $"background: linear-gradient(45deg, #1A0B0E, #0F0F1A);";
                    }
                }
                <div class="slide active" style="@GetSlideStyle(furstPage?.image_1, 0)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_2, 1)"></div>
                <div class="slide" style="@GetSlideStyle(furstPage?.image_3, 2)"></div>
            </div>
            <div class="slider-dots">
                <span class="dot active" onclick="currentSlide(0)"></span>
                <span class="dot" onclick="currentSlide(1)"></span>
                <span class="dot" onclick="currentSlide(2)"></span>
            </div>
        </div>
        <div class="overlay"></div>

        <!-- ЗАГОЛОВОК head_1 — абсолютно внизу карусели, над точками -->
        @if (furstPage != null)
        {
            string head1 = currentLang == "ru" ? furstPage.head_1_ru :
                          (currentLang == "en" ? furstPage.head_1_eng :
                          (currentLang == "de" ? furstPage.head_1_ger : furstPage.head_1_ru));
            if (!string.IsNullOrEmpty(head1))
            {
                <div class="main-title-bottom">@head1</div>
            }
        }

        <div class="content-wrapper">
            <!-- Карточка с дропдаунами - по центру -->
            <div class="dropdowns-container">
                <div class="dropdowns-row">
                    <div class="dropdown-section">
                        <label class="dropdown-label">⚡ @(currentLang == "ru" ? "БРЕНД" : (currentLang == "en" ? "BRAND" : "MARKE"))</label>
                        <select class="dropdown-select" id="brandDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Загрузка..." : (currentLang == "en" ? "Loading..." : "Laden...")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">🔧 @(currentLang == "ru" ? "МОДЕЛЬ" : (currentLang == "en" ? "MODEL" : "MODELL"))</label>
                        <select class="dropdown-select" id="modelDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала бренд" : (currentLang == "en" ? "Select brand first" : "Marke zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">📅 @(currentLang == "ru" ? "ПОКОЛЕНИЕ" : (currentLang == "en" ? "GENERATION" : "GENERATION"))</label>
                        <select class="dropdown-select" id="generationDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала модель" : (currentLang == "en" ? "Select model first" : "Modell zuerst")) --</option>
                        </select>
                    </div>
                    <div class="dropdown-section">
                        <label class="dropdown-label">🔥 @(currentLang == "ru" ? "ДВИГАТЕЛЬ" : (currentLang == "en" ? "ENGINE" : "MOTOR"))</label>
                        <select class="dropdown-select" id="engineDropdown" disabled>
                            <option value="">-- @(currentLang == "ru" ? "Сначала поколение" : (currentLang == "en" ? "Select generation first" : "Generation zuerst")) --</option>
                        </select>
                    </div>
                </div>
                <div style="text-align: center;">
                    <button class="btn-next" id="successButton" onclick="onSuccessButtonClick()">
                        @(currentLang == "ru" ? "ДАЛЕЕ →" : (currentLang == "en" ? "NEXT →" : "WEITER →"))
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (furstPage != null)
    {
        var blocks = new List<string>();
        if (currentLang == "ru") blocks = new List<string> { furstPage.block_1_ru, furstPage.block_2_ru, furstPage.block_3_ru, furstPage.block_4_ru, furstPage.block_5_ru, furstPage.block_6_ru };
        else if (currentLang == "en") blocks = new List<string> { furstPage.block_1_eng, furstPage.block_2_eng, furstPage.block_3_eng, furstPage.block_4_eng, furstPage.block_5_eng, furstPage.block_6_eng };
        else blocks = new List<string> { furstPage.block_1_ger, furstPage.block_2_ger, furstPage.block_3_ger, furstPage.block_4_ger, furstPage.block_5_ger, furstPage.block_6_ger };

        bool hasAnyBlock = blocks.Any(b => !string.IsNullOrEmpty(b));
        if (hasAnyBlock)
        {
            <div class="blocks-section">
                <div class="blocks-container">
                    @for (int i = 0; i < blocks.Count; i++)
                    {
                        if (!string.IsNullOrEmpty(blocks[i]))
                        {
                            <div class="block-card">
                                <div class="block-number">STAGE 0@(i+1)</div>
                                <div class="block-text">@blocks[i]</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }

    @if (furstPage != null)
    {
        string head2 = "";
        if (currentLang == "ru") head2 = furstPage.head_2_ru;
        else if (currentLang == "en") head2 = furstPage.head_2_eng;
        else if (currentLang == "de") head2 = furstPage.head_2_ger;
        else head2 = furstPage.head_2_ru;

        string text = "";
        if (currentLang == "ru") text = furstPage.text_ru;
        else if (currentLang == "en") text = furstPage.text_eng;
        else if (currentLang == "de") text = furstPage.text_ger;
        else text = furstPage.text_ru;

        <div class="info-section">
            <div class="info-container">
                @if (!string.IsNullOrEmpty(head2))
                {
                    <div class="section-title">@head2</div>
                }
                <div class="image-frame-container" style="background-image: url('@(furstPage.image_4 ?? "/images/default-bg.jpg")');">
                    <div class="frame-content">
                        @if (!string.IsNullOrEmpty(text))
                        {
                            <div class="info-text">@Html.Raw(text.Replace("\n", "<br/>"))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <script>
        // ========== СЛАЙДЕР ==========
        let currentSlideIndex = 0;
        let slideInterval;

        function showSlide(index) {
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('.dot');
            if (!slides.length) return;
            if (index >= slides.length) currentSlideIndex = 0;
            if (index < 0) currentSlideIndex = slides.length - 1;
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            slides[currentSlideIndex].classList.add('active');
            if (dots[currentSlideIndex]) dots[currentSlideIndex].classList.add('active');
        }

        function nextSlide() { currentSlideIndex++; showSlide(currentSlideIndex); resetInterval(); }
        function prevSlide() { currentSlideIndex--; showSlide(currentSlideIndex); resetInterval(); }
        function currentSlide(index) { currentSlideIndex = index; showSlide(currentSlideIndex); resetInterval(); }

        function resetInterval() {
            if (slideInterval) clearInterval(slideInterval);
            if (document.querySelectorAll('.slide').length > 1) {
                slideInterval = setInterval(() => { currentSlideIndex++; showSlide(currentSlideIndex); }, 60000);
            }
        }

        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ========== ЛОГИКА ДРОПДАУНОВ ==========
        let currentCar = {
            brand: '@Model.Brand',
            model: '@Model.Model',
            generation: '@Model.Generation',
            engine: '@Model.Engine'
        };

        document.addEventListener('DOMContentLoaded', async function () {
            await loadInitialData();
            if (isCarComplete()) showSuccessButton();
            if (document.querySelectorAll('.slide').length > 1) resetInterval();
        });

        function isCarComplete() { return currentCar.brand && currentCar.model && currentCar.generation && currentCar.engine; }
        function showSuccessButton() { const btn = document.getElementById('successButton'); if (btn) btn.style.display = 'inline-block'; }
        function hideSuccessButton() { const btn = document.getElementById('successButton'); if (btn) btn.style.display = 'none'; }

        function onSuccessButtonClick() {
            if (!isCarComplete()) {
                const lang = document.cookie.split('; ').find(row => row.startsWith('Language='))?.split('=')[1] || 'ru';
                const msg = lang === 'ru' ? 'Заполните все поля для расчета Stage' : (lang === 'en' ? 'Please fill all fields' : 'Bitte füllen Sie alle Felder');
                alert(msg);
                return;
            }
            const getCookie = (name) => { const value = `; ${document.cookie}`; const parts = value.split(`; ${name}=`); if (parts.length === 2) return parts.pop().split(';').shift(); return 'ru'; };
            const currentLang = getCookie('Language');
            const brand = encodeURIComponent(currentCar.brand);
            const model = encodeURIComponent(currentCar.model);
            const generation = encodeURIComponent(currentCar.generation);
            const engine = encodeURIComponent(currentCar.engine);
            window.location.href = `/${brand}/${model}/${generation}/${engine}`;
        }

        async function loadInitialData() {
            try {
                const response = await fetch('/Home/GetInitialData');
                const result = await response.json();
                updateCar(result.car);
                updateDropdown(result.nextField, result.options);
            } catch (error) { console.error(error); }
        }

        async function handleChange(fieldName, newValue) {
            try {
                const response = await fetch('/Home/ProcessSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ car: currentCar, changedField: fieldName, newValue: newValue })
                });
                const result = await response.json();
                updateCar(result.car);
                updateUI(result);
            } catch (error) { console.error(error); }
        }

        function updateCar(newCar) { currentCar = { brand: newCar.brand || '', model: newCar.model || '', generation: newCar.generation || '', engine: newCar.engine || '' }; }
        function updateUI(result) {
            updateDropdownValues();
            if (result.nextField && result.nextField !== 'complete') updateDropdown(result.nextField, result.options);
            if (result.nextField === 'complete') showSuccessButton(); else hideSuccessButton();
            if (result.nextField && result.nextField !== 'complete') resetDropdownsAfter(result.nextField);
        }
        function updateDropdownValues() { if (currentCar.brand) document.getElementById('brandDropdown').value = currentCar.brand; if (currentCar.model) document.getElementById('modelDropdown').value = currentCar.model; if (currentCar.generation) document.getElementById('generationDropdown').value = currentCar.generation; if (currentCar.engine) document.getElementById('engineDropdown').value = currentCar.engine; }
        function updateDropdown(fieldName, options) {
            const dropdown = document.getElementById(fieldName + 'Dropdown');
            if (!dropdown) return;
            const currentValue = dropdown.value;
            dropdown.innerHTML = '';
            const emptyOption = document.createElement('option'); emptyOption.value = ''; emptyOption.textContent = getPlaceholder(fieldName); dropdown.appendChild(emptyOption);
            if (options && options.length > 0) options.forEach(opt => { const op = document.createElement('option'); op.value = opt; op.textContent = opt; dropdown.appendChild(op); });
            if (currentValue && options && options.includes(currentValue)) dropdown.value = currentValue; else dropdown.value = currentCar[fieldName] || '';
            dropdown.disabled = false;
            dropdown.onchange = function() { handleChange(fieldName, this.value); };
        }
        function resetDropdownsAfter(fieldName) { const fields = ['brand','model','generation','engine']; const start = fields.indexOf(fieldName)+1; for(let i=start; i<fields.length; i++) { const d = document.getElementById(fields[i]+'Dropdown'); if(d && !currentCar[fields[i]]) { d.innerHTML = `<option value="">-- ${getPlaceholder(fields[i])} --</option>`; d.disabled = true; d.onchange = null; currentCar[fields[i]] = ''; } } }
        function getPlaceholder(fieldName) { const lang = document.cookie.split('; ').find(row=>row.startsWith('Language='))?.split('=')[1]||'ru'; const p = { brand:{ru:'Выберите бренд',en:'Select brand',de:'Marke wählen'}, model:{ru:'Выберите модель',en:'Select model',de:'Modell wählen'}, generation:{ru:'Выберите поколение',en:'Select generation',de:'Generation wählen'}, engine:{ru:'Выберите двигатель',en:'Select engine',de:'Motor wählen'} }; return p[fieldName]?.[lang]||'Выберите'; }
    </script>
</body>
</html>