            .header-dropdowns .dropdown-select {
                padding: 6px 4px;
                font-size: 9px;
                border-radius: 6px;
                min-height: 28px;
                border-width: 1px;
            }

            .header-dropdowns .dropdown-select:disabled {
                padding-left: 16px;
                padding-right: 2px;
                background-size: 10px 10px;
                background-position: 3px center;
            }

            .header-dropdowns .dropdown-select:not(:disabled) {
                background-size: 10px 10px;
                background-position: right 4px center;
                padding-right: 18px;
            }

            .header-dropdowns .dropdown-select option {
                font-size: 9px;
                padding: 4px;
            }

            .btn-next-mobile {
                font-size: 11px;
                padding: 8px 12px;
                margin-top: 6px;
            }
