@model List<reflash_oficial.Models.PartnersModel>
@{
    ViewData["Title"] = "Список партнеров";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .partner-input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 14px;
            background-color: #f8f9fa;
            pointer-events: none;
        }

        .photo-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }

        .table th {
            vertical-align: middle;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .url-cell {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .static-photo-container {
            width: 100px;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            border: 1px solid #dee2e6;
            overflow: hidden;
            margin: 0 auto;
        }
        
        .static-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .no-photo-placeholder {
            font-size: 24px;
            color: #6c757d;
        }
        
        .info-label {
            font-size: 12px;
            color: #6c757d;
            display: block;
            margin-top: 5px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <h1 class="mb-4">
            <i class="bi bi-handshake text-primary"></i>
            Представители
        </h1>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th style="width: 120px;">Фото</th>
                            <th>Имя</th>
                            <th>Телефон</th>
                            <th>ВКонтакте</th>
                            <th>Сайт</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var partner = Model[i];
                            <tr>
                                <td class="fw-bold text-center">@(i + 1)</td>

                                <td>
                                    <div class="static-photo-container">
                                        @if (!string.IsNullOrEmpty(partner.photo))
                                        {
                                            <img src="@partner.photo" class="static-photo" alt="Фото партнера">
                                        }
                                        else
                                        {
                                            <div class="no-photo-placeholder">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                        }
                                    </div>
                                    <span class="info-label">Фото партнера</span>
                                </td>

                                <td>
                                    <div class="partner-input">@partner.name</div>
                                    <span class="info-label">Имя</span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(partner.phone))
                                    {
                                        <div class="partner-input">@partner.phone</div>
                                    }
                                    else
                                    {
                                        <div class="partner-input text-muted">Не указан</div>
                                    }
                                    <span class="info-label">Телефон</span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div class="partner-input url-cell">
                                            <a href="@partner.vk" target="_blank" class="text-decoration-none">
                                                @partner.vk
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="partner-input text-muted">Не указан</div>
                                    }
                                    <span class="info-label">ВКонтакте</span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(partner.website))
                                    {
                                        <div class="partner-input url-cell">
                                            <a href="@partner.website" target="_blank" class="text-decoration-none">
                                                @partner.website
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="partner-input text-muted">Не указан</div>
                                    }
                                    <span class="info-label">Сайт</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Список партнеров пуст.
            </div>
        }

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>