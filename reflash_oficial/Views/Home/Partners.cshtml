@model List<reflash_oficial.Models.PartnersModel>
@{
    ViewData["Title"] = "Партнеры";

    // Читаем язык из cookie
    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    // Получаем тему из cookie
    var currentTheme = Context.Request.Cookies["Theme"] ?? "dark";

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }
}

<!DOCTYPE html>
<html lang="@language" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — ReFlash Official</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU" type="text/javascript"></script>
    <style>
        /* ==========================================
                           CSS ПЕРЕМЕННЫЕ ДЛЯ ТЕМ
                           ========================================== */

        /* Светлая тема */
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-overlay: rgba(255, 255, 255, 0.9);
            --bg-map-control: rgba(255, 255, 255, 0.95);
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --gradient-start: #f8f9fa;
            --gradient-end: #e9ecef;
            --map-header-start: #2196F3;
            --map-header-end: #1976D2;
            --partner-border: #e0e0e0;
            --partner-bg: #ffffff;
            --partner-hover-border: #2196F3;
            --partner-address-bg: #f5f5f5;
            --empty-bg: #ffffff;
            --empty-border: #e0e0e0;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
        }

        /* Тёмная тема */
        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-overlay: rgba(10, 10, 15, 0.9);
            --bg-map-control: rgba(18, 18, 26, 0.95);
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.5);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --gradient-start: #111118;
            --gradient-end: #0D0D14;
            --map-header-start: #FF3A2F;
            --map-header-end: #B8251A;
            --partner-border: #252530;
            --partner-bg: #111118;
            --partner-hover-border: #FF3A2F;
            --partner-address-bg: #0C0C14;
            --empty-bg: #111118;
            --empty-border: #252530;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
        }

        /* ========== ОБЩИЕ СТИЛИ ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.5;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* Кастомный скролл */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 10px;
        }

        /* ========== ЯЗЫКОВОЙ СВИТЧЕР ========== */
        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: var(--bg-overlay);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid var(--border-color);
            box-shadow: 0 8px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

            .lang-btn:hover {
                color: var(--text-primary);
                background: rgba(255,58,47,0.1);
            }

            .lang-btn.active {
                background: var(--accent-color);
                color: white;
                box-shadow: 0 0 8px rgba(255,58,47,0.5);
            }

        /* ========== ОСНОВНОЙ КОНТЕЙНЕР ========== */
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 100px 24px 60px;
        }

        /* Заголовок страницы */
        .page-header {
            margin-bottom: 40px;
            text-align: center;
        }

        .page-title {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--logo-color-start) 0%, var(--logo-color-end) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -1px;
            transition: background 0.3s ease;
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 16px;
            margin-top: 12px;
        }

        /* ========== КАРТА ========== */
        .map-section {
            margin-bottom: 50px;
        }

        .map-card {
            background: var(--bg-card);
            border-radius: 28px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            transition: all 0.25s;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        .map-header {
            padding: 20px 28px;
            background: linear-gradient(135deg, var(--map-header-start), var(--map-header-end));
            border-bottom: none;
            transition: background 0.3s ease;
        }

            .map-header h3 {
                font-size: 18px;
                font-weight: 600;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 10px;
                color: #ffffff;
            }

                .map-header h3 i {
                    font-size: 20px;
                }

        .map-container {
            position: relative;
            height: 450px;
            width: 100%;
        }

        #map {
            height: 100%;
            width: 100%;
        }

        /* Кастомные кнопки управления картой */
        .yandex-map-controls {
            position: absolute;
            bottom: 20px;
            right: 20px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .map-control-btn {
            width: 44px;
            height: 44px;
            background: var(--bg-map-control);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 20px;
            color: var(--text-primary);
            transition: all 0.2s;
        }

            .map-control-btn:hover {
                background: var(--accent-color);
                border-color: var(--accent-color);
                color: white;
                transform: scale(1.05);
            }

        .map-footer {
            padding: 14px 28px;
            background: var(--bg-secondary);
            border-top: 1px solid var(--border-color);
            font-size: 13px;
            color: var(--text-muted);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        /* ========== СЕТКА ПАРТНЕРОВ ========== */
        .partners-section {
            margin-top: 20px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .section-title {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-primary);
        }

            .section-title i {
                color: var(--accent-color);
                font-size: 28px;
            }

        .partners-count {
            background: rgba(255, 58, 47, 0.15);
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            color: var(--accent-color);
        }

        .partners-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 28px;
        }

        /* Карточка партнера */
        .partner-card {
            background: var(--partner-bg);
            border-radius: 24px;
            border: 1px solid var(--partner-border);
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

            .partner-card:hover {
                transform: translateY(-6px);
                border-color: var(--partner-hover-border);
                box-shadow: 0 20px 30px -12px var(--shadow-hover);
            }

            .partner-card.highlight {
                box-shadow: 0 0 0 2px var(--accent-color), 0 10px 30px -10px var(--shadow-hover);
                transform: translateY(-2px);
            }

        /* Фото */
        .partner-photo-container {
            width: 100%;
            height: 240px;
            overflow: hidden;
            background: var(--bg-secondary);
            position: relative;
        }

        .partner-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .partner-card:hover .partner-photo {
            transform: scale(1.05);
        }

        .no-photo-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-secondary);
        }

        .no-photo-icon {
            font-size: 64px;
            color: var(--text-muted);
        }

        /* Информация */
        .partner-info {
            padding: 22px;
        }

        .partner-name {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
            text-align: center;
        }

            .partner-name a {
                color: var(--text-primary);
                text-decoration: none;
                transition: color 0.2s;
            }

                .partner-name a:hover {
                    color: var(--accent-color);
                }

        /* Контакты */
        .contact-info {
            margin-bottom: 16px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
        }

            .contact-item:last-child {
                border-bottom: none;
            }

        .contact-icon {
            width: 28px;
            color: var(--accent-color);
            text-align: center;
            font-size: 14px;
        }

        .contact-text {
            flex: 1;
            color: var(--text-secondary);
        }

        .contact-link {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.2s;
        }

            .contact-link:hover {
                color: var(--accent-color);
            }

        .no-contact {
            color: var(--text-muted);
            font-style: italic;
        }

        /* Адрес */
        .partner-address {
            padding: 14px 22px;
            background: var(--partner-address-bg);
            border-top: 1px solid var(--border-color);
            font-size: 13px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

            .partner-address i {
                color: var(--accent-color);
                font-size: 14px;
            }

        /* Пустое состояние */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: var(--empty-bg);
            border-radius: 28px;
            border: 1px solid var(--empty-border);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .empty-icon {
            font-size: 64px;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .empty-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--accent-color);
        }

        .empty-text {
            color: var(--text-muted);
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .main-container {
                padding: 80px 16px 40px;
            }

            .language-switcher {
                top: 12px;
                right: 12px;
                padding: 4px 10px;
            }

            .lang-btn {
                padding: 4px 10px;
                font-size: 11px;
            }

            .page-title {
                font-size: 32px;
            }

            .page-subtitle {
                font-size: 14px;
            }

            .map-container {
                height: 320px;
            }

            .map-header h3 {
                font-size: 16px;
            }

            .map-header {
                padding: 15px 20px;
            }

            .map-footer {
                padding: 10px 20px;
                font-size: 11px;
            }

            .section-title {
                font-size: 24px;
            }

            .partners-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .partner-photo-container {
                height: 200px;
            }

            .partner-info {
                padding: 18px;
            }

            .partner-address {
                padding: 12px 18px;
            }

            .yandex-map-controls {
                bottom: 12px;
                right: 12px;
                gap: 6px;
            }

            .map-control-btn {
                width: 38px;
                height: 38px;
                font-size: 16px;
            }
        }

        @@media (max-width: 480px) {
            .page-title {
                font-size: 28px;
            }

            .section-title {
                font-size: 20px;
            }

            .partner-name {
                font-size: 16px;
            }

            .contact-item {
                font-size: 13px;
                padding: 6px 0;
            }
        }
    </style>
</head>
<body>

    <div class="language-switcher">
        <button class="lang-btn @(language == "ru" ? "active" : "")" onclick="switchLanguage('ru')">RU</button>
        <button class="lang-btn @(language == "en" ? "active" : "")" onclick="switchLanguage('en')">EN</button>
        <button class="lang-btn @(language == "de" ? "active" : "")" onclick="switchLanguage('de')">DE</button>
    </div>

    <div class="main-container">
        <!-- Шапка страницы -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-handshake" style="color: var(--accent-color); margin-right: 12px;"></i>
                @GetLocalized("Наши партнеры", "Our Partners", "Unsere Partner")
            </h1>
            <p class="page-subtitle">
                @GetLocalized("Сертифицированные центры чип-тюнинга по всему миру",
                "Certified chip tuning centers worldwide",
                                "Zertifizierte Chip-Tuning-Zentren weltweit")
            </p>
        </div>

        <!-- Карта -->
        <div class="map-section">
            <div class="map-card">
                <div class="map-header">
                    <h3>
                        <i class="fas fa-map-marker-alt"></i>
                        @GetLocalized("Расположение представителей", "Partner Locations", "Partnerstandorte")
                    </h3>
                </div>
                <div class="map-container">
                    <div id="map" style="height: 100%; width: 100%;"></div>
                    <div class="yandex-map-controls">
                        <button class="map-control-btn" id="zoom-in" title="@GetLocalized("Увеличить", "Zoom in", "Vergrößern")">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button class="map-control-btn" id="zoom-out" title="@GetLocalized("Уменьшить", "Zoom out", "Verkleinern")">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="map-footer">
                    <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                    @GetLocalized("Кликните по карточке партнера — карта приблизится к его локации",
                                        "Click on a partner card — the map will zoom to their location",
                                        "Klicken Sie auf eine Partnerkarte — die Karte zoomt zu deren Standort")
                </div>
            </div>
        </div>

        <!-- Список партнеров -->
        <div class="partners-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-users"></i>
                    @GetLocalized("Представители", "Representatives", "Vertreter")
                </h2>
                @if (Model != null && Model.Count > 0)
                {
                    <div class="partners-count">
                        <i class="fas fa-user-check" style="margin-right: 6px;"></i>
                        @Model.Count @GetLocalized("партнеров", "partners", "Partner")
                    </div>
                }
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <div class="partners-grid">
                    @foreach (var partner in Model)
                    {
                        var address = string.Join(", ", new[] { partner.city, partner.street, partner.house }
                        .Where(s => !string.IsNullOrEmpty(s)));

                        <div class="partner-card" id="partner-@partner.Id" data-partner-id="@partner.Id">
                            <!-- Фото -->
                            <div class="partner-photo-container">
                                @if (!string.IsNullOrEmpty(partner.photo))
                                {
                                    <img src="/shared-fotos/partners/@partner.photo"
                                         class="partner-photo"
                                         alt="@partner.name"
                                         onerror="this.onerror=null; this.src='/images/default-partner.jpg';">
                                }
                                else
                                {
                                    <div class="no-photo-container">
                                        <i class="fas fa-user-circle no-photo-icon"></i>
                                    </div>
                                }
                            </div>

                            <!-- Информация -->
                            <div class="partner-info">
                                <div class="partner-name">
                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <a href="@partner.vk" target="_blank">
                                            <i class="fab fa-vk" style="color: var(--accent-color); margin-right: 8px;"></i>
                                            @partner.name
                                        </a>
                                    }
                                    else
                                    {
                                        @partner.name
                                    }
                                </div>

                                <div class="contact-info">
                                    @if (!string.IsNullOrEmpty(partner.phone))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-phone-alt"></i></div>
                                            <div class="contact-text">
                                                <a href="tel:@partner.phone" class="contact-link">@partner.phone</a>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(partner.website))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-globe"></i></div>
                                            <div class="contact-text">
                                                <a href="@partner.website" target="_blank" class="contact-link">
                                                    @(partner.website.Length > 35 ? partner.website.Substring(0, 35) + "..." : partner.website)
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fab fa-vk"></i></div>
                                            <div class="contact-text">
                                                <a href="@partner.vk" target="_blank" class="contact-link">
                                                    @GetLocalized("Страница VK", "VK Page", "VK-Seite")
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    @if (string.IsNullOrEmpty(partner.phone) && string.IsNullOrEmpty(partner.website) && string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-info-circle"></i></div>
                                            <div class="contact-text no-contact">
                                                @GetLocalized("Контактная информация не указана", "No contact information", "Keine Kontaktdaten")
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Адрес -->
                            @if (!string.IsNullOrEmpty(address))
                            {
                                <div class="partner-address">
                                    <i class="fas fa-map-pin"></i>
                                    <span>@address</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div class="empty-title">
                        @GetLocalized("Список партнеров пуст", "No partners yet", "Keine Partner")
                    </div>
                    <div class="empty-text">
                        @GetLocalized("На данный момент нет активных представителей",
                        "There are no active representatives at the moment",
                                        "Derzeit gibt es keine aktiven Vertreter")
                </div>
            </div>
                        }
        </div>
    </div>

    <script>
        // ========== ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА ==========
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ========== КАРТА ==========
        var map;
        var partnerPlacemarks = [];

        function initMap() {
            var mapElement = document.getElementById('map');
            if (!mapElement) {
                console.error('Элемент map не найден');
                return;
            }

            try {
                map = new ymaps.Map('map', {
                    center: [20, 0],
                    zoom: 2,
                    controls: []
                });

                // Добавляем маркеры
                addPartnersMarkers();

                // Настройка кнопок
                setupZoomControls();

            } catch (error) {
                console.error('Ошибка инициализации карты:', error);
                mapElement.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--accent-color);">' +
                    '<i class="fas fa-exclamation-triangle" style="font-size: 32px; margin-bottom: 12px; display: block;"></i>' +
                    'Ошибка загрузки карты</div>';
            }
        }

        function addPartnersMarkers() {
            @if (Model != null && Model.Count > 0)
            {
                    foreach (var partner in Model)
                    {
                            if (!string.IsNullOrEmpty(partner.latitude) && !string.IsNullOrEmpty(partner.longitude))
                            {
                                    try
                                    {
                                            var lat = partner.latitude.Replace(',', '.').Trim();
                                            var lon = partner.longitude.Replace(',', '.').Trim();
                                            var name = partner.name?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var phone = partner.phone?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var website = partner.website?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var vk = partner.vk?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var city = partner.city?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var street = partner.street?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                                            var house = partner.house?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";

                                            var address = string.Join(", ", new[] { city, street, house }.Where(s => !string.IsNullOrEmpty(s))).Trim();

                                            <text>
                                                var coords = [parseFloat("@lat"), parseFloat("@lon")];
                                                if (!isNaN(coords[0]) && !isNaN(coords[1])) {
                                                    var balloonHtml = '<div style="max-width: 280px; font-family: Inter, sans-serif;">' +
                                                        '<strong style="color: var(--accent-color);">@Html.Raw(name)</strong>' +
                                                        '<hr style="margin: 8px 0; border-color: var(--border-color);">';

                                                @if (!string.IsNullOrEmpty(phone))
                                                {
                                                        <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fas fa-phone-alt" style="color: var(--accent-color); width: 24px;"></i> <a href="tel:@phone" style="color: var(--accent-color); text-decoration: none;">@phone</a></div>';</text>
                                                }

                                                @if (!string.IsNullOrEmpty(website))
                                                {
                                                        <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fas fa-globe" style="color: var(--accent-color); width: 24px;"></i> <a href="@website" target="_blank" style="color: var(--accent-color); text-decoration: none;">Сайт</a></div>';</text>
                                                }

                                                @if (!string.IsNullOrEmpty(vk))
                                                {
                                                        <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fab fa-vk" style="color: var(--accent-color); width: 24px;"></i> <a href="@vk" target="_blank" style="color: var(--accent-color); text-decoration: none;">ВКонтакте</a></div>';</text>
                                                }

                                                @if (!string.IsNullOrEmpty(address))
                                                {
                                                        <text>balloonHtml += '<hr style="margin: 8px 0;"><div style="margin: 6px 0;"><i class="fas fa-map-marker-alt" style="color: var(--accent-color); width: 24px;"></i> @address</div>';</text>
                                                }

                                                balloonHtml += '</div>';

                                                    var placemark = new ymaps.Placemark(coords, {
                                                        hintContent: '@Html.Raw(name)',
                                                        balloonContent: balloonHtml
                                                    }, {
                                                        preset: 'islands#redIcon',
                                                        iconColor: '#FF3A2F'
                                                    });

                                                    map.geoObjects.add(placemark);
                                                    partnerPlacemarks.push(placemark);
                                                    setupPartnerCardClick(@partner.Id, coords);
                                                }
                                            </text>
                                    }
                                    catch (Exception ex) { }
                            }
                    }
            }

            if (partnerPlacemarks.length === 0) {
                console.log('Нет партнеров с координатами');
            }
        }

        function setupPartnerCardClick(partnerId, coords) {
            var partnerCard = document.getElementById('partner-' + partnerId);
            if (partnerCard) {
                partnerCard.addEventListener('click', function(e) {
                    if (e.target.tagName.toLowerCase() !== 'a') {
                        if (map) {
                            map.setCenter(coords, 12, {
                                duration: 600,
                                flying: true
                            });
                        }

                        highlightPartnerCard(partnerId);

                        var placemark = partnerPlacemarks.find(function(pm) {
                            var pmCoords = pm.geometry.getCoordinates();
                            return Math.abs(pmCoords[0] - coords[0]) < 0.0001 &&
                                   Math.abs(pmCoords[1] - coords[1]) < 0.0001;
                        });

                        if (placemark) {
                            setTimeout(function() {
                                placemark.balloon.open();
                            }, 600);
                        }
                    }
                });
            }
        }

        function highlightPartnerCard(partnerId) {
            document.querySelectorAll('.partner-card').forEach(function(card) {
                card.classList.remove('highlight');
            });

            var selectedCard = document.getElementById('partner-' + partnerId);
            if (selectedCard) {
                selectedCard.classList.add('highlight');

                selectedCard.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        }

        function setupZoomControls() {
            var zoomIn = document.getElementById('zoom-in');
            var zoomOut = document.getElementById('zoom-out');

            if (zoomIn) {
                zoomIn.onclick = function() {
                    if (map) map.setZoom(map.getZoom() + 1);
                };
            }
            if (zoomOut) {
                zoomOut.onclick = function() {
                    if (map) map.setZoom(map.getZoom() - 1);
                };
            }
        }

        // Запуск карты
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof ymaps !== 'undefined') {
                    ymaps.ready(initMap);
                } else {
                    console.error('ymaps не определен');
                }
            });
        } else {
            if (typeof ymaps !== 'undefined') {
                ymaps.ready(initMap);
            }
        }
    </script>
</body>
</html>