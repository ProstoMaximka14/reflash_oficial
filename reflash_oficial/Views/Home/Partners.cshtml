@model List<reflash_oficial.Models.PartnersModel>
@{
    ViewData["Title"] = "Партнеры";

    // Читаем язык из cookie
    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }
}

<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] — ReFlash Official</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU" type="text/javascript"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0A0A0F;
            color: #E8E8F0;
            overflow-x: hidden;
            line-height: 1.5;
        }

        /* Кастомный скролл */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #14141C;
        }
        ::-webkit-scrollbar-thumb {
            background: #FF3A2F;
            border-radius: 10px;
        }

        /* ========== ЯЗЫКОВОЙ СВИТЧЕР ========== */
        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: rgba(10, 10, 15, 0.8);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid rgba(255, 58, 47, 0.3);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: #A0A0B0;
            letter-spacing: 0.3px;
        }

        .lang-btn:hover {
            color: white;
            background: rgba(255,58,47,0.2);
        }

        .lang-btn.active {
            background: #FF3A2F;
            color: white;
            box-shadow: 0 0 8px rgba(255,58,47,0.5);
        }

        /* ========== ОСНОВНОЙ КОНТЕЙНЕР ========== */
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 100px 24px 60px;
        }

        /* Заголовок страницы */
        .page-header {
            margin-bottom: 40px;
            text-align: center;
        }

        .page-title {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, #FFFFFF 0%, #FFB5A0 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -1px;
        }

        .page-subtitle {
            color: #A0A0B0;
            font-size: 16px;
            margin-top: 12px;
        }

        /* ========== КАРТА ========== */
        .map-section {
            margin-bottom: 50px;
        }

        .map-card {
            background: #111118;
            border-radius: 28px;
            border: 1px solid #252530;
            overflow: hidden;
            transition: all 0.25s;
        }

        .map-header {
            padding: 20px 28px;
            background: linear-gradient(135deg, #FF3A2F, #B8251A);
            border-bottom: none;
        }

        .map-header h3 {
            font-size: 18px;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .map-header h3 i {
            font-size: 20px;
        }

        .map-container {
            position: relative;
            height: 450px;
            width: 100%;
        }

        #map {
            height: 100%;
            width: 100%;
        }

        /* Кастомные кнопки управления картой */
        .yandex-map-controls {
            position: absolute;
            bottom: 20px;
            right: 20px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .map-control-btn {
            width: 44px;
            height: 44px;
            background: rgba(18, 18, 26, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 58, 47, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 20px;
            color: #E8E8F0;
            transition: all 0.2s;
        }

        .map-control-btn:hover {
            background: #FF3A2F;
            border-color: #FF3A2F;
            transform: scale(1.05);
        }

        .map-footer {
            padding: 14px 28px;
            background: #0C0C14;
            border-top: 1px solid #252530;
            font-size: 13px;
            color: #6A6A7A;
        }

        /* ========== СЕТКА ПАРТНЕРОВ ========== */
        .partners-section {
            margin-top: 20px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .section-title {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: #FF3A2F;
            font-size: 28px;
        }

        .partners-count {
            background: rgba(255, 58, 47, 0.15);
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 500;
            color: #FF3A2F;
        }

        .partners-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 28px;
        }

        /* Карточка партнера */
        .partner-card {
            background: #111118;
            border-radius: 24px;
            border: 1px solid #252530;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .partner-card:hover {
            transform: translateY(-6px);
            border-color: #FF3A2F;
            box-shadow: 0 20px 30px -12px rgba(255, 58, 47, 0.2);
        }

        .partner-card.highlight {
            box-shadow: 0 0 0 2px #FF3A2F, 0 10px 30px -10px rgba(255, 58, 47, 0.3);
            transform: translateY(-2px);
        }

        /* Фото */
        .partner-photo-container {
            width: 100%;
            height: 240px;
            overflow: hidden;
            background: linear-gradient(135deg, #1A1A24, #0F0F18);
            position: relative;
        }

        .partner-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .partner-card:hover .partner-photo {
            transform: scale(1.05);
        }

        .no-photo-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1A1A24, #0F0F18);
        }

        .no-photo-icon {
            font-size: 64px;
            color: #3A3A45;
        }

        /* Информация */
        .partner-info {
            padding: 22px;
        }

        .partner-name {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
            text-align: center;
        }

        .partner-name a {
            color: #E8E8F0;
            text-decoration: none;
            transition: color 0.2s;
        }

        .partner-name a:hover {
            color: #FF3A2F;
        }

        /* Контакты */
        .contact-info {
            margin-bottom: 16px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #1E1E2A;
            font-size: 14px;
        }

        .contact-item:last-child {
            border-bottom: none;
        }

        .contact-icon {
            width: 28px;
            color: #FF3A2F;
            text-align: center;
            font-size: 14px;
        }

        .contact-text {
            flex: 1;
            color: #C0C0D0;
        }

        .contact-link {
            color: #C0C0D0;
            text-decoration: none;
            transition: color 0.2s;
        }

        .contact-link:hover {
            color: #FF3A2F;
        }

        .no-contact {
            color: #5A5A6E;
            font-style: italic;
        }

        /* Адрес */
        .partner-address {
            padding: 14px 22px;
            background: #0C0C14;
            border-top: 1px solid #1E1E2A;
            font-size: 13px;
            color: #8A8A9A;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .partner-address i {
            color: #FF3A2F;
            font-size: 14px;
        }

        /* Пустое состояние */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: #111118;
            border-radius: 28px;
            border: 1px solid #252530;
        }

        .empty-icon {
            font-size: 64px;
            color: #3A3A45;
            margin-bottom: 20px;
        }

        .empty-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #FF3A2F;
        }

        .empty-text {
            color: #6A6A7A;
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .main-container {
                padding: 80px 16px 40px;
            }

            .language-switcher {
                top: 12px;
                right: 12px;
                padding: 4px 10px;
            }

            .lang-btn {
                padding: 4px 10px;
                font-size: 11px;
            }

            .page-title {
                font-size: 32px;
            }

            .page-subtitle {
                font-size: 14px;
            }

            .map-container {
                height: 320px;
            }

            .map-header h3 {
                font-size: 16px;
            }

            .map-header {
                padding: 15px 20px;
            }

            .map-footer {
                padding: 10px 20px;
                font-size: 11px;
            }

            .section-title {
                font-size: 24px;
            }

            .partners-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .partner-photo-container {
                height: 200px;
            }

            .partner-info {
                padding: 18px;
            }

            .partner-address {
                padding: 12px 18px;
            }

            .yandex-map-controls {
                bottom: 12px;
                right: 12px;
                gap: 6px;
            }

            .map-control-btn {
                width: 38px;
                height: 38px;
                font-size: 16px;
            }
        }

        @@media (max-width: 480px) {
            .page-title {
                font-size: 28px;
            }

            .section-title {
                font-size: 20px;
            }

            .partner-name {
                font-size: 16px;
            }

            .contact-item {
                font-size: 13px;
                padding: 6px 0;
            }
        }
    </style>
</head>
<body>

    <div class="language-switcher">
        <button class="lang-btn @(language == "ru" ? "active" : "")" onclick="switchLanguage('ru')">🇷🇺 RU</button>
        <button class="lang-btn @(language == "en" ? "active" : "")" onclick="switchLanguage('en')">🇬🇧 EN</button>
        <button class="lang-btn @(language == "de" ? "active" : "")" onclick="switchLanguage('de')">🇩🇪 DE</button>
    </div>

    <div class="main-container">
        <!-- Шапка страницы -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-handshake" style="color: #FF3A2F; margin-right: 12px;"></i>
                @GetLocalized("Наши партнеры", "Our Partners", "Unsere Partner")
            </h1>
            <p class="page-subtitle">
                @GetLocalized("Сертифицированные центры чип-тюнинга по всему миру", 
                           "Certified chip tuning centers worldwide", 
                           "Zertifizierte Chip-Tuning-Zentren weltweit")
            </p>
        </div>

        <!-- Карта -->
        <div class="map-section">
            <div class="map-card">
                <div class="map-header">
                    <h3>
                        <i class="fas fa-map-marker-alt"></i>
                        @GetLocalized("Расположение представителей", "Partner Locations", "Partnerstandorte")
                    </h3>
                </div>
                <div class="map-container">
                    <div id="map" style="height: 100%; width: 100%;"></div>
                    <div class="yandex-map-controls">
                        <button class="map-control-btn" id="zoom-in" title="@GetLocalized("Увеличить", "Zoom in", "Vergrößern")">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button class="map-control-btn" id="zoom-out" title="@GetLocalized("Уменьшить", "Zoom out", "Verkleinern")">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="map-footer">
                    <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                    @GetLocalized("Кликните по карточке партнера — карта приблизится к его локации", 
                               "Click on a partner card — the map will zoom to their location", 
                               "Klicken Sie auf eine Partnerkarte — die Karte zoomt zu deren Standort")
                </div>
            </div>
        </div>

        <!-- Список партнеров -->
        <div class="partners-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-users"></i>
                    @GetLocalized("Представители", "Representatives", "Vertreter")
                </h2>
                @if (Model != null && Model.Count > 0)
                {
                    <div class="partners-count">
                        <i class="fas fa-user-check" style="margin-right: 6px;"></i>
                        @Model.Count @GetLocalized("партнеров", "partners", "Partner")
                    </div>
                }
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <div class="partners-grid">
                    @foreach (var partner in Model)
                    {
                        var address = string.Join(", ", new[] { partner.city, partner.street, partner.house }
                            .Where(s => !string.IsNullOrEmpty(s)));

                        <div class="partner-card" id="partner-@partner.Id" data-partner-id="@partner.Id">
                            <!-- Фото -->
                            <div class="partner-photo-container">
                                @if (!string.IsNullOrEmpty(partner.photo))
                                {
                                    <img src="/shared-fotos/partners/@partner.photo"
                                         class="partner-photo"
                                         alt="@partner.name"
                                         onerror="this.onerror=null; this.src='/images/default-partner.jpg';">
                                }
                                else
                                {
                                    <div class="no-photo-container">
                                        <i class="fas fa-user-circle no-photo-icon"></i>
                                    </div>
                                }
                            </div>

                            <!-- Информация -->
                            <div class="partner-info">
                                <div class="partner-name">
                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <a href="@partner.vk" target="_blank">
                                            <i class="fab fa-vk" style="color: #FF3A2F; margin-right: 8px;"></i>
                                            @partner.name
                                        </a>
                                    }
                                    else
                                    {
                                        @partner.name
                                    }
                                </div>

                                <div class="contact-info">
                                    @if (!string.IsNullOrEmpty(partner.phone))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-phone-alt"></i></div>
                                            <div class="contact-text">
                                                <a href="tel:@partner.phone" class="contact-link">@partner.phone</a>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(partner.website))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-globe"></i></div>
                                            <div class="contact-text">
                                                <a href="@partner.website" target="_blank" class="contact-link">
                                                    @(partner.website.Length > 35 ? partner.website.Substring(0, 35) + "..." : partner.website)
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fab fa-vk"></i></div>
                                            <div class="contact-text">
                                                <a href="@partner.vk" target="_blank" class="contact-link">
                                                    @GetLocalized("Страница VK", "VK Page", "VK-Seite")
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    @if (string.IsNullOrEmpty(partner.phone) && string.IsNullOrEmpty(partner.website) && string.IsNullOrEmpty(partner.vk))
                                    {
                                        <div class="contact-item">
                                            <div class="contact-icon"><i class="fas fa-info-circle"></i></div>
                                            <div class="contact-text no-contact">
                                                @GetLocalized("Контактная информация не указана", "No contact information", "Keine Kontaktdaten")
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Адрес -->
                            @if (!string.IsNullOrEmpty(address))
                            {
                                <div class="partner-address">
                                    <i class="fas fa-map-pin"></i>
                                    <span>@address</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div class="empty-title">
                        @GetLocalized("Список партнеров пуст", "No partners yet", "Keine Partner")
                    </div>
                    <div class="empty-text">
                        @GetLocalized("На данный момент нет активных представителей", 
                                   "There are no active representatives at the moment", 
                                   "Derzeit gibt es keine aktiven Vertreter")
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        // ========== ПЕРЕКЛЮЧЕНИЕ ЯЗЫКА ==========
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        // ========== КАРТА ==========
        var map;
        var partnerPlacemarks = [];

        function initMap() {
            var mapElement = document.getElementById('map');
            if (!mapElement) {
                console.error('Элемент map не найден');
                return;
            }

            try {
                map = new ymaps.Map('map', {
                    center: [20, 0],
                    zoom: 2,
                    controls: []
                });

                // Добавляем маркеры
                addPartnersMarkers();

                // Настройка кнопок
                setupZoomControls();

            } catch (error) {
                console.error('Ошибка инициализации карты:', error);
                mapElement.innerHTML = '<div style="padding: 40px; text-align: center; color: #FF3A2F;">' +
                    '<i class="fas fa-exclamation-triangle" style="font-size: 32px; margin-bottom: 12px; display: block;"></i>' +
                    'Ошибка загрузки карты</div>';
            }
        }

        function addPartnersMarkers() {
            @if (Model != null && Model.Count > 0)
            {
                foreach (var partner in Model)
                {
                    if (!string.IsNullOrEmpty(partner.latitude) && !string.IsNullOrEmpty(partner.longitude))
                    {
                        try
                        {
                            var lat = partner.latitude.Replace(',', '.').Trim();
                            var lon = partner.longitude.Replace(',', '.').Trim();
                            var name = partner.name?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var phone = partner.phone?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var website = partner.website?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var vk = partner.vk?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var city = partner.city?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var street = partner.street?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";
                            var house = partner.house?.Replace("'", "\\'").Replace("\"", "\\\"") ?? "";

                            var address = string.Join(", ", new[] { city, street, house }.Where(s => !string.IsNullOrEmpty(s))).Trim();

                            <text>
                                var coords = [parseFloat("@lat"), parseFloat("@lon")];
                                if (!isNaN(coords[0]) && !isNaN(coords[1])) {
                                    var balloonHtml = '<div style="max-width: 280px; font-family: Inter, sans-serif;">' +
                                        '<strong style="color: #FF3A2F;">@Html.Raw(name)</strong>' +
                                        '<hr style="margin: 8px 0; border-color: #ddd;">';

                                @if (!string.IsNullOrEmpty(phone))
                                {
                                    <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fas fa-phone-alt" style="color: #FF3A2F; width: 24px;"></i> <a href="tel:@phone" style="color: #007bff; text-decoration: none;">@phone</a></div>';</text>
                                }

                                @if (!string.IsNullOrEmpty(website))
                                {
                                    <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fas fa-globe" style="color: #FF3A2F; width: 24px;"></i> <a href="@website" target="_blank" style="color: #007bff; text-decoration: none;">Сайт</a></div>';</text>
                                }

                                @if (!string.IsNullOrEmpty(vk))
                                {
                                    <text>balloonHtml += '<div style="margin: 6px 0;"><i class="fab fa-vk" style="color: #FF3A2F; width: 24px;"></i> <a href="@vk" target="_blank" style="color: #007bff; text-decoration: none;">ВКонтакте</a></div>';</text>
                                }

                                @if (!string.IsNullOrEmpty(address))
                                {
                                    <text>balloonHtml += '<hr style="margin: 8px 0;"><div style="margin: 6px 0;"><i class="fas fa-map-marker-alt" style="color: #FF3A2F; width: 24px;"></i> @address</div>';</text>
                                }

                                balloonHtml += '</div>';

                                    var placemark = new ymaps.Placemark(coords, {
                                        hintContent: '@Html.Raw(name)',
                                        balloonContent: balloonHtml
                                    }, {
                                        preset: 'islands#redIcon',
                                        iconColor: '#FF3A2F'
                                    });

                                    map.geoObjects.add(placemark);
                                    partnerPlacemarks.push(placemark);
                                    setupPartnerCardClick(@partner.Id, coords);
                                }
                            </text>
                        }
                        catch (Exception ex) { }
                    }
                }
            }

            if (partnerPlacemarks.length === 0) {
                console.log('Нет партнеров с координатами');
            }
        }

        function setupPartnerCardClick(partnerId, coords) {
            var partnerCard = document.getElementById('partner-' + partnerId);
            if (partnerCard) {
                partnerCard.addEventListener('click', function(e) {
                    if (e.target.tagName.toLowerCase() !== 'a') {
                        if (map) {
                            map.setCenter(coords, 12, {
                                duration: 600,
                                flying: true
                            });
                        }

                        highlightPartnerCard(partnerId);

                        var placemark = partnerPlacemarks.find(function(pm) {
                            var pmCoords = pm.geometry.getCoordinates();
                            return Math.abs(pmCoords[0] - coords[0]) < 0.0001 &&
                                   Math.abs(pmCoords[1] - coords[1]) < 0.0001;
                        });

                        if (placemark) {
                            setTimeout(function() {
                                placemark.balloon.open();
                            }, 600);
                        }
                    }
                });
            }
        }

        function highlightPartnerCard(partnerId) {
            document.querySelectorAll('.partner-card').forEach(function(card) {
                card.classList.remove('highlight');
            });

            var selectedCard = document.getElementById('partner-' + partnerId);
            if (selectedCard) {
                selectedCard.classList.add('highlight');

                selectedCard.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        }

        function setupZoomControls() {
            var zoomIn = document.getElementById('zoom-in');
            var zoomOut = document.getElementById('zoom-out');

            if (zoomIn) {
                zoomIn.onclick = function() {
                    if (map) map.setZoom(map.getZoom() + 1);
                };
            }
            if (zoomOut) {
                zoomOut.onclick = function() {
                    if (map) map.setZoom(map.getZoom() - 1);
                };
            }
        }

        // Запуск карты
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof ymaps !== 'undefined') {
                    ymaps.ready(initMap);
                } else {
                    console.error('ymaps не определен');
                }
            });
        } else {
            if (typeof ymaps !== 'undefined') {
                ymaps.ready(initMap);
            }
        }
    </script>
</body>
</html>