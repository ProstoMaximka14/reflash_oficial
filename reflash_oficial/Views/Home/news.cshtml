@model List<reflash_oficial.Models.NewsModel>
@{
    ViewData["Title"] = "Новости";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reflash</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .news-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .news-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            }

        .news-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-bottom: 3px solid #0d6efd;
        }

        .news-content {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .news-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #212529;
            margin-bottom: 0.75rem;
            line-height: 1.4;
        }

        .news-text {
            color: #6c757d;
            line-height: 1.6;
            margin-bottom: 1rem;
            flex-grow: 1;
        }

        .news-date {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #6c757d;
            font-size: 0.9rem;
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid #e9ecef;
        }

            .news-date i {
                color: #0d6efd;
            }

        .no-news {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

            .no-news i {
                font-size: 4rem;
                color: #dee2e6;
                margin-bottom: 1rem;
            }

            .no-news h3 {
                color: #495057;
                margin-bottom: 0.5rem;
            }

            .no-news p {
                color: #6c757d;
            }

        .page-title {
            color: #212529;
            font-weight: 600;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 3px solid #0d6efd;
            display: inline-block;
        }

        /* Адаптивность */
        @@media (max-width: 768px) {
            .news-image {
                height: 180px;
            }

            .news-title {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <!-- Заголовок страницы -->
        <div class="d-flex align-items-center mb-5">
            <i class="bi bi-newspaper fs-1 text-primary me-3"></i>
            <div>
                <h1 class="page-title">Новости Reflash</h1>
                <p class="text-muted mb-0">Последние новости и обновления</p>
            </div>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Сетка новостей -->
            <div class="row g-4">
                @foreach (var news in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="news-card">
                            <!-- Изображение новости -->
                            @if (!string.IsNullOrEmpty(news.news_url))
                            {
                                <img src="/shared-fotos/news/@news.news_url"
                                     class="news-image"
                                     alt="@news.news_name"
                                     onerror="this.src='/images/default-news.jpg'">
                            }
                            else
                            {
                                <div class="news-image bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                                </div>
                            }

                            <!-- Контент новости -->
                            <div class="news-content">
                                <h3 class="news-title">@news.news_name</h3>

                                @if (!string.IsNullOrEmpty(news.news_text))
                                {
                                    <p class="news-text">
                                        @if (news.news_text.Length > 150)
                                        {
                                            @news.news_text.Substring(0, 150)
                            
                                            <text>...</text>
                                        }
                                        else
                                        {
                                            @news.news_text
                                        }
                                    </p>
                                }
                                else
                                {
                                    <p class="news-text text-muted fst-italic">Нет описания</p>
                                }

                                <!-- Дата новости -->
                                <div class="news-date">
                                    <i class="bi bi-calendar3"></i>
                                    <span>
                                        @if (!string.IsNullOrEmpty(news.news_date))
                                        {
                                            @news.news_date
                                        }
                                        else
                                        {
                                            <text>Дата не указана</text>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Сообщение, если новостей нет -->
            <div class="no-news">
                <i class="bi bi-newspaper"></i>
                <h3>Новостей пока нет</h3>
                <p class="mb-0">Следите за обновлениями, скоро здесь появятся новости!</p>
            </div>
        }
    </div>

    <!-- Bootstrap JS (опционально, если нужны какие-то интерактивные элементы) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Простой скрипт для обработки ошибок изображений -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('.news-image');
            images.forEach(img => {
                img.addEventListener('error', function() {
                    this.onerror = null;
                    this.style.display = 'none';
                    this.parentElement.innerHTML = `
                        <div class="news-image bg-light d-flex align-items-center justify-content-center">
                            <i class="bi bi-image text-secondary" style="font-size: 3rem;"></i>
                        </div>
                    `;
                });
            });
        });
    </script>
</body>
</html>