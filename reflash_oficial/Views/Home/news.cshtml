@model List<reflash_oficial.Models.NewsModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "News";

    var language = Context.Request.Cookies["Language"];
    if (string.IsNullOrEmpty(language)) language = "ru";

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalCount = ViewBag.TotalCount is int tc ? tc : (Model?.Count ?? 0);

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }

    string GetNewsName(reflash_oficial.Models.NewsModel n)
    {
        if (n == null) return "";
        return language switch
        {
            "en" => !string.IsNullOrEmpty(n.name_eng) ? n.name_eng : (n.name ?? ""),
            "de" => !string.IsNullOrEmpty(n.name_ger) ? n.name_ger : (n.name ?? ""),
            _ => n.name ?? ""
        };
    }

    string GetNewsText(reflash_oficial.Models.NewsModel n)
    {
        if (n == null) return "";
        return language switch
        {
            "en" => !string.IsNullOrEmpty(n.text_eng) ? n.text_eng : (n.text ?? ""),
            "de" => !string.IsNullOrEmpty(n.text_ger) ? n.text_ger : (n.text ?? ""),
            _ => n.text ?? ""
        };
    }

    string FormatDate(string date)
    {
        if (string.IsNullOrWhiteSpace(date)) return "";
        if (DateTime.TryParse(date, out var d))
            return d.ToString("dd.MM.yyyy");
        return date;
    }
}

<style>
    .news-page {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 24px 10% 40px;
        box-sizing: border-box;
    }

    .news-page-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .news-page-title {
        font-size: 36px;
        font-weight: 800;
        background: linear-gradient(135deg, var(--logo-color-start, #FFB5A0) 0%, var(--logo-color-end, #FFD4C4) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: -0.5px;
    }

    .news-page-subtitle {
        color: var(--text-muted, #88889a);
        font-size: 15px;
        margin-top: 8px;
    }

    .news-item {
        width: 100%;
        background: var(--bg-card, #111118);
        border: 1px solid var(--border-color, #2A2A35);
        border-radius: 16px;
        margin-bottom: 24px;
        overflow: hidden;
        box-shadow: 0 4px 20px var(--shadow-color, rgba(0,0,0,0.25));
    }

    .news-item-body {
        padding: 20px 24px 24px;
    }

    .news-item-body::after {
        content: "";
        display: table;
        clear: both;
    }

    .news-item-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-primary, #E8E8F0);
        margin: 0 0 16px;
        line-height: 1.35;
    }

    .news-item-date {
        color: var(--accent-color, #FF3A2F);
        font-weight: 700;
        margin-right: 8px;
        white-space: nowrap;
    }

    .news-item-photo-wrap {
        float: left;
        margin: 0 20px 12px 0;
        max-width: 40%;
        text-align: left;
    }

    .news-item-photo {
        max-width: 320px;
        max-height: 240px;
        width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 12px;
        display: block;
        background: var(--bg-secondary, #14141C);
    }

    .news-item-text {
        font-size: 15px;
        color: var(--text-secondary, #C0C0D0);
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .news-empty {
        text-align: center;
        padding: 60px 20px;
        background: var(--bg-card, #111118);
        border-radius: 16px;
        border: 1px solid var(--border-color, #2A2A35);
    }

    .news-empty i {
        font-size: 48px;
        color: var(--text-muted, #88889a);
        margin-bottom: 12px;
    }

    .news-empty h3 {
        color: var(--accent-color, #FF3A2F);
        margin-bottom: 8px;
    }

    .news-empty p {
        color: var(--text-muted, #88889a);
    }

    .news-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        padding-top: 8px;
    }

    .news-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid var(--border-color, #2A2A35);
        background: var(--bg-card, #111118);
        color: var(--text-secondary, #C0C0D0);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s;
    }

    .news-page-btn:hover {
        border-color: var(--accent-color, #2196F3);
        color: var(--accent-color, #2196F3);
        text-decoration: none;
    }

    .news-page-btn.active {
        background: var(--accent-color, #2196F3);
        border-color: var(--accent-color, #2196F3);
        color: #fff;
    }

    .news-page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    .news-page-info {
        width: 100%;
        text-align: center;
        font-size: 13px;
        color: var(--text-muted, #88889a);
        margin-bottom: 4px;
    }

    @@media (max-width: 768px) {
        .news-page {
            padding: 16px 12px 28px;
        }

        .news-page-title {
            font-size: 28px;
        }

        .news-item-body {
            padding: 16px;
        }

        .news-item-title {
            font-size: 17px;
        }

        .news-item-photo-wrap {
            float: none;
            max-width: 100%;
            margin: 0 0 16px 0;
            text-align: center;
        }

        .news-item-photo {
            max-width: 100%;
            max-height: 200px;
            margin: 0 auto;
        }

        .news-item-text {
            font-size: 14px;
        }
    }
</style>

<div class="news-page">
    <div class="news-page-header">
        <h1 class="news-page-title">@GetLocalized("Новости", "News", "Nachrichten")</h1>
        <p class="news-page-subtitle">
            @GetLocalized("Актуальные события ReFlash Team", "Latest updates from ReFlash Team", "Aktuelle Neuigkeiten von ReFlash Team")
        </p>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        @foreach (var news in Model)
        {
            var title = GetNewsName(news);
            var body = GetNewsText(news);
            var photo = !string.IsNullOrEmpty(news.photo_1) ? news.photo_1
                      : (!string.IsNullOrEmpty(news.photo_2) ? news.photo_2 : "");

            <article class="news-item">
                <div class="news-item-body">
                    <h2 class="news-item-title">
                        @if (!string.IsNullOrEmpty(news.date))
                        {
                            <span class="news-item-date">[@FormatDate(news.date)]</span>
                        }
                        @(string.IsNullOrEmpty(title)
                            ? GetLocalized("Без названия", "Untitled", "Ohne Titel")
                            : title)
                    </h2>

                    @if (!string.IsNullOrEmpty(photo))
                    {
                        <div class="news-item-photo-wrap">
                            <img class="news-item-photo"
                                 src="/shared-fotos/news/@photo"
                                 alt="@title"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.parentElement.style.display='none';" />
                        </div>
                    }

                    <div class="news-item-text">
                        @if (!string.IsNullOrEmpty(body))
                        {
                            @body
                        }
                        else
                        {
                            <span style="opacity:0.7;font-style:italic;">
                                @GetLocalized("Нет описания", "No description", "Keine Beschreibung")
                            </span>
                        }
                    </div>
                </div>
            </article>
        }

        @if (totalPages > 1)
        {
            <div class="news-pagination">
                <div class="news-page-info">
                    @GetLocalized("Страница", "Page", "Seite") @currentPage @GetLocalized("из", "of", "von") @totalPages
                    · @totalCount @GetLocalized("новостей", "news", "Nachrichten")
                </div>

                <a class="news-page-btn @(currentPage <= 1 ? "disabled" : "")"
                   href="@(currentPage <= 1 ? "#" : Url.Action("News", "Home", new { page = currentPage - 1 }))">
                    <i class="fas fa-chevron-left"></i>
                </a>

                @{
                    int start = Math.Max(1, currentPage - 2);
                    int end = Math.Min(totalPages, currentPage + 2);
                    if (start > 1)
                    {
                        <a class="news-page-btn" href="@Url.Action("News", "Home", new { page = 1 })">1</a>
                        if (start > 2)
                        {
                            <span class="news-page-btn disabled">…</span>
                        }
                    }
                    for (int p = start; p <= end; p++)
                    {
                        <a class="news-page-btn @(p == currentPage ? "active" : "")"
                           href="@Url.Action("News", "Home", new { page = p })">@p</a>
                    }
                    if (end < totalPages)
                    {
                        if (end < totalPages - 1)
                        {
                            <span class="news-page-btn disabled">…</span>
                        }
                        <a class="news-page-btn" href="@Url.Action("News", "Home", new { page = totalPages })">@totalPages</a>
                    }
                }

                <a class="news-page-btn @(currentPage >= totalPages ? "disabled" : "")"
                   href="@(currentPage >= totalPages ? "#" : Url.Action("News", "Home", new { page = currentPage + 1 }))">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        }
    }
    else
    {
        <div class="news-empty">
            <i class="fas fa-newspaper"></i>
            <h3>@GetLocalized("Новостей пока нет", "No news yet", "Noch keine Nachrichten")</h3>
            <p>@GetLocalized("Следите за обновлениями — скоро здесь появятся новости.", "Stay tuned — news will appear here soon.", "Bleiben Sie dran — bald erscheinen hier Neuigkeiten.")</p>
        </div>
    }
</div>
