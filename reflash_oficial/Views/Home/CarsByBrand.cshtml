@model List<reflash_oficial.Models.ReflashCarModel>
@{
    ViewData["Title"] = $"ReflashTeam";
    var brand = ViewBag.Brand as string ?? "";
    var language = Context.Request.Cookies["Language"] ?? "ru";
    var currentTheme = Context.Request.Cookies["Theme"] ?? "dark";

    string Transliterate(string text) => reflash_oficial.Controllers.HomeController.TransliterateForUrl(text);

    string GetLocalized(string ru, string eng, string ger)
    {
        return language switch
        {
            "en" => eng,
            "de" => ger,
            _ => ru
        };
    }

    string GetCarImagePath(string imageName)
    {
        if (string.IsNullOrEmpty(imageName)) return "";
        if (imageName.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            imageName.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return imageName;
        if (imageName.StartsWith("/"))
            return imageName;
        return "/shared-fotos/cars/" + imageName;
    }

    string GetBrandLogo(string brandName)
    {
        return brandName?.ToLower() switch
        {
            "honda" => "/shared-fotos/logo/honda_logo_black.png",
            "acura" => "/shared-fotos/logo/acura_logo_black.png",
            _ => "/images/default-logo.png"
        };
    }

    string GetBrandLogoDark(string brandName)
    {
        return brandName?.ToLower() switch
        {
            "honda" => "/shared-fotos/logo/honda_logo_white.png",
            "acura" => "/shared-fotos/logo/acura_logo_black_negate.png",
            _ => "/images/default-logo-dark.png"
        };
    }

    var groupedByModel = Model
        .GroupBy(c => c.Model)
        .OrderBy(g => g.Key)
        .ToList();
}

<!DOCTYPE html>
<html lang="@language" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-overlay: rgba(255, 255, 255, 0.9);
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(0, 0, 0, 0.15);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
            --transition-speed: 0.3s;
        }

        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-overlay: rgba(10, 10, 15, 0.9);
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.5);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
        }

        .language-switcher {
            position: fixed;
            top: 24px;
            right: 24px;
            display: flex;
            gap: 8px;
            z-index: 1100;
            background: var(--bg-overlay);
            backdrop-filter: blur(12px);
            padding: 6px 12px;
            border-radius: 60px;
            border: 1px solid var(--border-color);
            box-shadow: 0 8px 20px var(--shadow-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .lang-btn {
            background: transparent;
            border: none;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 13px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
        }

        .lang-btn:hover {
            color: var(--text-primary);
            background: rgba(255,58,47,0.1);
        }

        .lang-btn.active {
            background: var(--accent-color);
            color: white;
            box-shadow: 0 0 8px rgba(255,58,47,0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            transition: background 0.3s ease, color 0.3s ease;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0px 24px 60px;
        }

        .page-header {
            margin-bottom: 40px;
        }

        .back-link {
            display: inline-block;
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 12px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: var(--accent-hover);
        }

        .back-link i {
            margin-right: 8px;
        }

        .page-title {
            font-size: 36px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--logo-color-start), var(--logo-color-end));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            display: inline-block;
            position: relative;
            width: 180px;
            height: 180px;
            flex-shrink: 0;
            margin: 0 auto;
        }

        .brand-logo img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .brand-logo .logo-light {
            display: block !important;
        }
        .brand-logo .logo-dark {
            display: none !important;
        }

        [data-theme="dark"] .brand-logo .logo-light {
            display: none !important;
        }
        [data-theme="dark"] .brand-logo .logo-dark {
            display: block !important;
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 16px;
            margin-top: 8px;
        }

        .model-section {
            margin-bottom: 12px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            background: var(--bg-card);
            box-shadow: 0 4px 20px var(--shadow-color);
            transition: box-shadow 0.3s ease;
        }

        .model-section:hover {
            box-shadow: 0 8px 30px var(--shadow-hover);
        }

        .model-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px;
            background: var(--bg-secondary);
            cursor: pointer;
            transition: all 0.3s ease;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            gap: 10px;
            flex-wrap: wrap;
        }

        .model-header:hover {
            background: var(--bg-input);
        }

        .model-header.active {
            background: var(--bg-input);
            border-bottom: 1px solid var(--border-color);
        }

        .model-header .model-name {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .model-header .model-name i {
            color: var(--accent-color);
            font-size: 18px;
        }

        .model-header .model-count {
            font-size: 14px;
            color: var(--text-muted);
            background: var(--bg-card);
            padding: 4px 16px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .model-header .toggle-icon {
            color: var(--text-muted);
            font-size: 16px;
            transition: transform 0.3s ease;
            margin-left: 8px;
        }

        .model-header.active .toggle-icon {
            transform: rotate(180deg);
        }

        .model-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
            opacity: 0;
            padding: 0 24px;
            background: var(--bg-card);
        }

        .model-content.open {
            max-height: 10000px;
            opacity: 1;
            padding: 20px 24px;
        }

        /* ===== ПОКОЛЕНИЯ ===== */
        .generation-section {
            margin-bottom: 8px;
        }

        .generation-subheader {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 8px 0 0 0;
            background: var(--bg-secondary);
            border-radius: 12px;
            border-left: 3px solid var(--accent-color);
            cursor: pointer;
            user-select: none;
            transition: background 0.2s;
        }

        .generation-subheader:hover {
            background: var(--bg-input);
        }

        .generation-subheader.active {
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
        }

        .generation-subheader .gen-icon {
            color: var(--accent-color);
            font-size: 14px;
        }

        .generation-subheader .gen-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .generation-subheader .gen-count {
            font-size: 13px;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .generation-subheader .toggle-icon {
            margin-left: auto;
            color: var(--text-muted);
            font-size: 12px;
            transition: transform 0.3s ease;
        }

        .generation-subheader.active .toggle-icon {
            transform: rotate(180deg);
        }

        .generation-content {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.25s ease;
            padding: 0 0 0 10px;
            background: var(--bg-card);
            border-left: 3px solid var(--border-color);
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        .generation-content.open {
            max-height: 5000px;
            opacity: 1;
            padding: 12px 0 12px 10px;
        }

        .model-cars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            padding-left: 10px;
            padding-top: 4px;
        }

        .car-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            color: var(--text-primary);
            box-shadow: 0 2px 12px var(--shadow-color);
            display: block;
        }

        .car-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent-color);
            box-shadow: 0 12px 28px var(--shadow-hover);
        }

        .car-card .car-image-container {
            width: 100%;
            height: 160px;
            overflow: hidden;
            background: var(--bg-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .car-card .car-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .car-card:hover .car-image {
            transform: scale(1.05);
        }

        .car-card .no-image {
            font-size: 36px;
            color: var(--text-muted);
        }

        .car-card .car-info {
            padding: 14px 16px;
        }

        .car-card .car-model-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .car-card .car-details {
            color: var(--text-secondary);
            font-size: 13px;
            margin-top: 4px;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 56px;
            display: block;
            margin-bottom: 16px;
            color: var(--text-muted);
        }

        .empty-state h3 {
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .alert {
            background: rgba(255, 58, 47, 0.1);
            border: 1px solid #FF3A2F;
            color: #FF3A2F;
            padding: 16px 24px;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: center;
        }
        .model-header .model-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    flex-shrink: 0;
}

        @@media (max-width: 768px) {
            .language-switcher {
                top: 16px;
                right: 16px;
                padding: 4px 10px;
                gap: 4px;
            }

            .lang-btn {
                padding: 4px 10px;
                font-size: 10px;
            }

            .container {
                padding: 0px 12px 40px;
            }

            .page-title {
                font-size: 28px;
            }

            .brand-logo {
                width: 100px;
                height: 100px;
            }

            .model-header {
                padding: 14px 16px;
            }

            .model-header .model-name {
                font-size: 17px;
            }

            .model-content.open {
                padding: 16px;
            }

            .model-cars-grid {
                grid-template-columns: 1fr 1fr;
                padding-left: 0;
                gap: 12px;
            }

            .car-card .car-image-container {
                height: 200px;
            }

            .generation-subheader {
                margin-left: 0;
                flex-wrap: wrap;
                padding: 8px 12px;
            }

            .generation-subheader .gen-count {
                margin-left: 0;
            }
        }

        @@media (max-width: 480px) {
            .language-switcher {
                top: 12px;
                right: 12px;
                padding: 3px 8px;
                gap: 4px;
            }

            .lang-btn {
                padding: 3px 8px;
                font-size: 9px;
            }

            .page-title {
                font-size: 22px;
            }

            .model-header {
                padding: 12px 14px;
            }

            .model-header .model-name {
                font-size: 15px;
            }

            .model-header .model-count {
                font-size: 12px;
                padding: 2px 12px;
            }

            .model-content.open {
                padding: 12px;
            }

            .model-cars-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .car-card .car-image-container {
                height: 180px;
            }

            .car-card .car-model-name {
                font-size: 14px;
            }

            .car-card .car-details {
                font-size: 12px;
            }

            .generation-subheader .gen-name {
                font-size: 13px;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="page-header">
            <a href="/" class="back-link">
                <i class="fas fa-arrow-left"></i> @GetLocalized("На главную", "Back to home", "Zurück zur Startseite")
            </a>
            <h1 class="page-title">
                <span class="brand-logo">
                    <img src="@GetBrandLogo(brand)"
                         alt="@brand"
                         class="logo-light" />
                    <img src="@GetBrandLogoDark(brand)"
                         alt="@brand"
                         class="logo-dark" />
                </span>
            </h1>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert">
                <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            </div>
        }

        @if (Model != null && Model.Any())
        {
            @foreach (var modelGroup in groupedByModel)
            {
                var generationGroups = modelGroup
                    .GroupBy(c => c.Generation)
                    .OrderBy(g => g.Min(c => c.SortOrder2))
                    .ThenBy(g => g.Key)
                    .ToList();

                <div class="model-section">
                    <div class="model-header" onclick="toggleModel(this)">
    <span class="model-name">
        <i class="fas fa-chevron-right"></i> @modelGroup.Key
    </span>
    <span class="model-header-right">
        <span class="model-count">
            <i class="fas fa-car"></i> @modelGroup.Count()
        </span>
        <span class="toggle-icon">
            <i class="fas fa-chevron-down"></i>
        </span>
    </span>
</div>

                    <div class="model-content">
                        @foreach (var genGroup in generationGroups)
                        {
                            var isSingleGen = generationGroups.Count == 1;

                            <div class="generation-section">
                                <div class="generation-subheader @(isSingleGen ? "active" : "")"
                                     onclick="toggleGeneration(this)">
                                    <span class="gen-icon"><i class="fas fa-calendar-alt"></i></span>
                                    <span class="gen-name">@GetLocalized("Поколение", "Generation", "Generation") @genGroup.Key</span>
                                    <span class="toggle-icon"><i class="fas fa-chevron-down"></i></span>
                                </div>

                                <div class="generation-content @(isSingleGen ? "open" : "")">
                                    <div class="model-cars-grid">
                                        @foreach (var car in genGroup.OrderBy(c => c.SortOrder))
                                        {
                                            <a href="@Url.Action("Car", "Home", new {
                                                brand = Transliterate(car.Brand),
                                                model = Transliterate(car.Model),
                                                generation = Transliterate(car.Generation),
                                                engine = Transliterate(car.Engine)
                                            })" class="car-card">
                                                <div class="car-image-container">
                                                    @if (!string.IsNullOrEmpty(car.Image))
                                                    {
                                                        <img src="@GetCarImagePath(car.Image)" alt="@car.Brand @car.Model" class="car-image" loading="lazy"
                                                             onerror="this.parentElement.innerHTML='<div class=\'no-image\'><i class=\'fas fa-car\'></i></div>'" />
                                                    }
                                                    else
                                                    {
                                                        <div class="no-image">
                                                            <i class="fas fa-car"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="car-info">
                                                    <div class="car-model-name">@car.Model</div>
                                                    <div class="car-details">
                                                        @car.Generation · @car.Engine
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-car"></i>
                <h3>@GetLocalized("Нет доступных моделей", "No available models", "Keine verfügbaren Modelle")</h3>
                <p>@GetLocalized("Для бренда", "For brand", "Für die Marke") @brand @GetLocalized("пока нет автомобилей", "no cars yet", "gibt es noch keine Autos")</p>
            </div>
        }
    </div>

    <script>
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        function toggleModel(headerElement) {
            const section = headerElement.closest('.model-section');
            if (!section) return;

            const content = section.querySelector('.model-content');
            if (!content) return;

            headerElement.classList.toggle('active');
            content.classList.toggle('open');
        }

        function toggleGeneration(headerElement) {
            const section = headerElement.closest('.generation-section');
            if (!section) return;

            const content = section.querySelector('.generation-content');
            if (!content) return;

            headerElement.classList.toggle('active');
            content.classList.toggle('open');
        }

        // При загрузке все модели закрыты
        document.addEventListener('DOMContentLoaded', function () {
            // ничего не открываем
        });
    </script>

</body>
</html>