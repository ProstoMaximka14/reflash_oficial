<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - reflash_oficial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/reflash_oficial.styles.css" asp-append-version="true" />
    <style>
        /* Навбар всегда отображается */
        .navbar-collapse {
            display: flex !important;
        }
        
        /* Скрываем кнопку-бургер */
        .navbar-toggler {
            display: none !important;
        }
        
        /* Адаптация для мобильных */
        @@media (max-width: 768px) {
            .container-fluid {
                flex-wrap: wrap;
            }
            
            .navbar-brand {
                width: 100%;
                text-align: center;
                margin-bottom: 10px;
            }
            
            .navbar-collapse {
                width: 100%;
                justify-content: center;
            }
            
            .navbar-nav {
                flex-direction: row;
                justify-content: center;
                gap: 15px;
                flex-wrap: wrap;
            }
            
            .nav-link {
                padding: 5px 10px;
                font-size: 14px;
            }
        }
        
        /* Для очень маленьких экранов */
        @@media (max-width: 480px) {
            .navbar-nav {
                gap: 8px;
            }
            
            .nav-link {
                font-size: 12px;
                padding: 4px 8px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">reflash_oficial</a>
                <div class="navbar-collapse d-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Partners">Partners</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="News">News</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
</body>
</html>