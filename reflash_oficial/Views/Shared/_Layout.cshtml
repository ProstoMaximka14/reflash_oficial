<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - ReFlash Official</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/reflash_oficial.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ==========================================
           ОБЩИЕ СТИЛИ
           ========================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary, #0A0A0F);
            color: var(--text-primary, #E8E8F0);
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* ==========================================
           CSS ПЕРЕМЕННЫЕ ДЛЯ ТЕМ
           ========================================== */

        /* Светлая тема */
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-navbar: transparent;
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --navbar-border: transparent;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
            --lang-active-bg: #2196F3;
            --lang-active-color: #ffffff;
            --title-gradient-start: #0a0a1a;
            --title-gradient-end: #60A5FA;
            --title-shadow: rgba(0, 0, 0, 0.15);
        }

        /* Тёмная тема */
        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-navbar: transparent;
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --navbar-border: transparent;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
            --lang-active-bg: #FF3A2F;
            --lang-active-color: #ffffff;
            --title-gradient-start: #E8E8F0;
            --title-gradient-end: #FF3A2F;
            --title-shadow: rgba(0, 0, 0, 0.5);
        }

        /* ==========================================
           НАВБАР - ПРОЗРАЧНЫЙ, БЕЗ ЧЕРТЫ
           ========================================== */
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav.navbar {
            padding: 0;
            margin: 0;
            background: var(--bg-navbar) !important;
            backdrop-filter: blur(0px);
            border-bottom: none !important;
            box-shadow: none !important;
            transition: background 0.3s ease;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            flex-wrap: wrap !important;
        }

        nav.navbar .container-fluid {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            max-width: 100%;
            margin: 0 !important;
            padding: 12px 24px;
            width: 100%;
            flex-wrap: wrap !important;
        }

        .navbar-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            width: auto;
        }

        .navbar-brand {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--logo-color-start) 0%, var(--logo-color-end) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-decoration: none;
            white-space: nowrap;
            transition: opacity 0.2s;
            flex-shrink: 0;
        }

        .navbar-brand:hover {
            opacity: 0.85;
            color: transparent;
        }

        .navbar-brand i {
            color: var(--accent-color);
            margin-right: 6px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            flex-shrink: 0;
        }

        .nav-link-custom {
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary) !important;
            text-decoration: none;
            transition: all 0.2s ease;
            border-radius: 40px;
            position: relative;
            white-space: nowrap;
        }

        .nav-link-custom:hover {
            color: var(--accent-color) !important;
            background: rgba(255, 58, 47, 0.1);
        }

        .nav-link-custom.active {
            color: var(--accent-color) !important;
            background: rgba(255, 58, 47, 0.15);
        }

        .nav-link-custom.active::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 2px;
            background: var(--accent-color);
            border-radius: 2px;
        }

        .nav-link-custom i {
            margin-right: 4px;
            font-size: 12px;
        }

        /* ==========================================
           СОЦИАЛЬНЫЕ ИКОНКИ
           ========================================== */
        .social-icons {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .social-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .social-link:hover {
            transform: translateY(-2px);
            background: rgba(255, 58, 47, 0.15);
            border-color: var(--accent-color);
            color: var(--accent-color);
            box-shadow: 0 4px 15px rgba(255, 58, 47, 0.2);
        }

        /* Telegram */
        .social-link.telegram:hover {
            background: rgba(0, 136, 204, 0.2);
            border-color: #0088CC;
            color: #0088CC;
            box-shadow: 0 4px 15px rgba(0, 136, 204, 0.2);
        }

        /* VK */
        .social-link.vk:hover {
            background: rgba(69, 112, 169, 0.2);
            border-color: #4C75A3;
            color: #4C75A3;
            box-shadow: 0 4px 15px rgba(69, 112, 169, 0.2);
        }

        /* Drive2.ru */
        .social-link.drive2 {
            font-size: 11px;
            font-weight: 700;
        }

        .social-link.drive2:hover {
            background: rgba(255, 107, 0, 0.2);
            border-color: #FF6B00;
            color: #FF6B00;
            box-shadow: 0 4px 15px rgba(255, 107, 0, 0.2);
        }

        /* Facebook */
        .social-link.facebook:hover {
            background: rgba(24, 119, 242, 0.2);
            border-color: #1877F2;
            color: #1877F2;
            box-shadow: 0 4px 15px rgba(24, 119, 242, 0.2);
        }

        /* Instagram */
        .social-link.instagram:hover {
            background: rgba(225, 48, 108, 0.2);
            border-color: #E1306C;
            color: #E1306C;
            box-shadow: 0 4px 15px rgba(225, 48, 108, 0.2);
        }

        /* ==========================================
           КНОПКИ УПРАВЛЕНИЯ
           ========================================== */
        .navbar-controls {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
        }

        .nav-btn {
            background: transparent;
            border: none;
            padding: 4px 10px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 11px;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            background: var(--bg-input);
            display: flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
        }

        .nav-btn:hover {
            color: var(--accent-color);
            background: rgba(255, 58, 47, 0.1);
            border-color: var(--accent-color);
        }

        .nav-btn.lang-btn.active {
            background: var(--lang-active-bg);
            color: var(--lang-active-color);
            border-color: var(--lang-active-bg);
        }

        .nav-btn.theme-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
        }

        .nav-btn.theme-btn:hover {
            color: var(--accent-color);
            background: rgba(255, 58, 47, 0.1);
            border-color: var(--accent-color);
        }

        .nav-btn i {
            font-size: 11px;
        }

        .nav-divider {
            width: 1px;
            height: 22px;
            background: var(--border-color);
            opacity: 0.5;
        }

        /* ==========================================
           ОСНОВНОЙ КОНТЕНТ
           ========================================== */
        .container {
            max-width: 100%;
            margin: 0 auto;
            padding: 0px 0px;
        }

        main {
            min-height: calc(100vh - 80px);
        }

        /* ==========================================
           СКРОЛЛ
           ========================================== */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-color);
            border-radius: 10px;
        }

        .footer-text {
            text-align: center;
        }

        /* ==========================================
           АДАПТАЦИЯ ДЛЯ МОБИЛЬНЫХ
           ========================================== */
        @@media (max-width: 768px) {
            nav.navbar .container-fluid {
                padding: 8px 12px;
                justify-content: center !important;
            }

            .navbar-wrapper {
                gap: 8px;
                justify-content: center;
                width: 100%;
            }

            .navbar-brand {
                font-size: 1rem;
            }

            .navbar-brand i {
                font-size: 12px;
                margin-right: 4px;
            }

            .nav-link-custom {
                padding: 4px 10px;
                font-size: 11px;
            }

            .nav-link-custom i {
                font-size: 10px;
                margin-right: 2px;
            }

            .nav-link-custom.active::after {
                width: 12px;
                height: 2px;
                bottom: 1px;
            }

            .social-link {
                width: 26px;
                height: 26px;
                font-size: 11px;
            }

            .social-link.drive2 {
                font-size: 9px;
            }

            .social-icons {
                gap: 4px;
            }

            .navbar-controls {
                gap: 3px;
            }

            .nav-btn {
                padding: 3px 7px;
                font-size: 10px;
                border-radius: 30px;
            }

            .nav-btn i {
                font-size: 9px;
            }

            .nav-divider {
                display: none;
            }
        }

        @@media (max-width: 480px) {
            .navbar-wrapper {
                gap: 4px;
            }

            .navbar-brand {
                font-size: 0.85rem;
            }

            .nav-link-custom {
                padding: 3px 7px;
                font-size: 10px;
            }

            .nav-link-custom i {
                font-size: 9px;
            }

            .social-link {
                width: 22px;
                height: 22px;
                font-size: 9px;
            }

            .social-link.drive2 {
                font-size: 7px;
            }

            .nav-btn {
                font-size: 9px;
                padding: 2px 5px;
            }

            .nav-btn i {
                font-size: 8px;
            }

            .navbar-wrapper {
                gap: 4px;
            }
        }
    </style>
</head>
<body>

    @{
        var currentLang = Context.Request.Cookies["Language"] ?? "ru";
        
        string GetLocalized(string ru, string en, string de)
        {
            return currentLang == "ru" ? ru :
                   currentLang == "en" ? en :
                   currentLang == "de" ? de : ru;
        }
    }

    <header>
        <nav class="navbar">
            <div class="container-fluid">
                <div class="navbar-wrapper">
                    <!-- Логотип -->
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-microchip"></i>
                        ReFlash
                    </a>

                    <!-- Навигация -->
                    <div class="nav-links">
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i>
                            @GetLocalized("Главная", "Home", "Start")
                        </a>
                        
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Partners" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Partners">
                            <i class="fas fa-handshake"></i>
                            @GetLocalized("Партнёры", "Partners", "Partner")
                        </a>
                    </div>

                    <!-- Социальные иконки -->
                    <div class="social-icons">
                        <!-- Telegram -->
                        <a href="https://t.me/reflashteamofficial" class="social-link telegram" target="_blank" title="Telegram">
                            <i class="fab fa-telegram-plane"></i>
                        </a>
                        
                        <!-- VK -->
                        <a href="https://vk.ru/reflashteam" class="social-link vk" target="_blank" title="VK">
                            <i class="fab fa-vk"></i>
                        </a>
                        
                        <!-- Drive2.ru (кастомная иконка с буквой D) -->
                        <a href="https://www.drive2.ru/o/reflashteam" class="social-link drive2" target="_blank" title="Drive2.ru">
                            D
                        </a>
                        
                        <!-- Facebook -->
                        <a href="https://www.facebook.com/reflashteam/" class="social-link facebook" target="_blank" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        
                        <!-- Instagram -->
                        <a href="https://www.instagram.com/reflashteam/" class="social-link instagram" target="_blank" title="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>

                    <!-- Управление -->
                    <div class="navbar-controls">
                        <button class="nav-btn lang-btn" data-lang="ru" onclick="switchLanguage('ru')">
                            РУ
                        </button>
                        <button class="nav-btn lang-btn" data-lang="en" onclick="switchLanguage('en')">
                            EN
                        </button>
                        <button class="nav-btn lang-btn" data-lang="de" onclick="switchLanguage('de')">
                            DE
                        </button>

                        <span class="nav-divider"></span>

                        <button class="nav-btn theme-btn" id="themeToggle" onclick="toggleTheme()" 
                                title="@GetLocalized("Тема", "Theme", "Thema")">
                            <i class="fas fa-moon" id="themeIcon"></i>
                            <span id="themeLabel">
                                @GetLocalized("Тёмная", "Dark", "Dunkel")
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="footer-container">
            <p class="footer-text">
                &copy; @DateTime.Now.Year ReFlash Official
            </p>
        </div>
    </footer>

    <script>
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            const currentTheme = html.getAttribute('data-theme') || 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

            html.setAttribute('data-theme', newTheme);

            const lang = getCookie('Language') || 'ru';

            if (newTheme === 'dark') {
                icon.className = 'fas fa-moon';
                label.textContent = lang === 'ru' ? 'Тёмная' :
                                   lang === 'en' ? 'Dark' : 'Dunkel';
            } else {
                icon.className = 'fas fa-sun';
                label.textContent = lang === 'ru' ? 'Светлая' :
                                   lang === 'en' ? 'Light' : 'Hell';
            }

            document.cookie = "Theme=" + newTheme + "; path=/; max-age=" + (365 * 24 * 60 * 60);
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        function loadTheme() {
            const theme = getCookie('Theme') || 'light';
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            const lang = getCookie('Language') || 'ru';

            html.setAttribute('data-theme', theme);

            if (icon) {
                icon.className = theme === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
            }
            if (label) {
                label.textContent = theme === 'dark' 
                    ? (lang === 'ru' ? 'Тёмная' : lang === 'en' ? 'Dark' : 'Dunkel')
                    : (lang === 'ru' ? 'Светлая' : lang === 'en' ? 'Light' : 'Hell');
            }
        }

        function updateActiveLanguage() {
            const currentLang = getCookie('Language') || 'ru';
            const langButtons = document.querySelectorAll('.lang-btn');

            langButtons.forEach(btn => {
                btn.classList.remove('active');
                if (btn.dataset.lang === currentLang) {
                    btn.classList.add('active');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadTheme();
            updateActiveLanguage();
        });
    </script>

</body>
</html>