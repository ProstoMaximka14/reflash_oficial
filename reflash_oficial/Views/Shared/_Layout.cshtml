@{
    var currentLang = Context.Request.Cookies["Language"] ?? "ru";
    if (currentLang != "ru" && currentLang != "en" && currentLang != "de") currentLang = "ru";
    var currentTheme = Context.Request.Cookies["Theme"] ?? "dark";
    if (currentTheme != "light" && currentTheme != "dark") currentTheme = "dark";
    string GetLocalized(string ru, string en, string de)
    {
        return currentLang == "ru" ? ru :
               currentLang == "en" ? en :
               currentLang == "de" ? de : ru;
    }
}
<!DOCTYPE html>
<html lang="@currentLang" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
        (function () {
            var match = document.cookie.match(/(?:^|; )Theme=([^;]*)/);
            var theme = match ? decodeURIComponent(match[1]) : 'dark';
            if (theme !== 'light' && theme !== 'dark') theme = 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="icon" type="image/svg+xml"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='black'/><text x='50' y='75' font-size='80' font-weight='bold' text-anchor='middle' fill='red' font-family='Arial'>R</text></svg>">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/reflash_oficial.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            background: var(--bg-primary);
            color: var(--text-primary);
        }

        html {
            scrollbar-gutter: stable;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            margin: 0 !important;
            display: flex;
            flex-direction: column;
        }

        html.theme-ready body {
            transition: background 0.3s ease, color 0.3s ease;
        }

        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --bg-card: #ffffff;
            --bg-input: #f0f0f0;
            --bg-navbar: #ffffff;
            --text-primary: #1a1a2e;
            --text-secondary: #4a4a5e;
            --text-muted: #88889a;
            --border-color: #e0e0e0;
            --shadow-color: rgba(0, 0, 0, 0.08);
            --accent-color: #2196F3;
            --accent-hover: #1976D2;
            --accent-soft: rgba(33, 150, 243, 0.1);
            --accent-soft-strong: rgba(33, 150, 243, 0.15);
            --navbar-border: transparent;
            --logo-color-start: #0D47A1;
            --logo-color-end: #42A5F5;
            --lang-active-bg: #2196F3;
            --lang-active-color: #ffffff;
            --title-gradient-start: #0a0a1a;
            --title-gradient-end: #60A5FA;
            --title-shadow: rgba(0, 0, 0, 0.15);
            color-scheme: light;
        }

        [data-theme="dark"] {
            --bg-primary: #0A0A0F;
            --bg-secondary: #14141C;
            --bg-card: #111118;
            --bg-input: #1a1a24;
            --bg-navbar: #0A0A0F;
            --text-primary: #E8E8F0;
            --text-secondary: #C0C0D0;
            --text-muted: #88889a;
            --border-color: #2A2A35;
            --shadow-color: rgba(0, 0, 0, 0.3);
            --accent-color: #FF3A2F;
            --accent-hover: #D62B1F;
            --accent-soft: rgba(255, 58, 47, 0.1);
            --accent-soft-strong: rgba(255, 58, 47, 0.15);
            --navbar-border: transparent;
            --logo-color-start: #FFB5A0;
            --logo-color-end: #FFD4C4;
            --lang-active-bg: #FF3A2F;
            --lang-active-color: #ffffff;
            --title-gradient-start: #E8E8F0;
            --title-gradient-end: #FF3A2F;
            --title-shadow: rgba(0, 0, 0, 0.5);
            color-scheme: dark;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav.navbar {
            padding: 0;
            margin: 0;
            background: var(--bg-navbar) !important;
            border-bottom: none !important;
            box-shadow: none !important;
            transition: background 0.3s ease;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            flex-wrap: wrap !important;
        }

        nav.navbar .container-fluid {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            max-width: 100%;
            margin: 0 !important;
            padding: 12px 24px;
            width: 100%;
            flex-wrap: nowrap !important;
        }

        .navbar-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: nowrap;
            width: max-content;
            max-width: 100%;
            flex-shrink: 0;
        }

        /* На ПК обёртки не влияют на раскладку */
        .navbar-top,
        .navbar-bottom {
            display: contents;
        }

        .navbar-brand {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            text-decoration: none;
            white-space: nowrap;
            transition: opacity 0.2s;
            flex-shrink: 0;
        }

        .navbar-brand:hover { opacity: 0.85; }

        .nav-links {
            display: grid;
            grid-template-columns: repeat(3, 6.75rem);
            align-items: center;
            gap: 2px;
            flex-shrink: 0;
        }

        .nav-link-custom {
            padding: 6px 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary) !important;
            text-decoration: none;
            transition: color 0.2s ease, background 0.2s ease;
            border-radius: 40px;
            position: relative;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            box-sizing: border-box;
        }

        .nav-link-custom:hover {
            color: var(--accent-color) !important;
            background: var(--accent-soft);
        }

        .nav-link-custom.active {
            color: var(--accent-color) !important;
            background: var(--accent-soft-strong);
        }

        .nav-link-custom.active::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 2px;
            background: var(--accent-color);
            border-radius: 2px;
        }

        .social-icons {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 6px;
            width: 174px;
            flex-shrink: 0;
        }

        .social-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .social-link:hover {
            transform: translateY(-2px);
            background: var(--accent-soft-strong);
            border-color: var(--accent-color);
            color: var(--accent-color);
            box-shadow: 0 4px 15px var(--accent-soft-strong);
        }

        .social-link.telegram:hover {
            background: rgba(0, 136, 204, 0.2);
            border-color: #0088CC;
            color: #0088CC;
            box-shadow: 0 4px 15px rgba(0, 136, 204, 0.2);
        }

        .social-link.vk:hover {
            background: rgba(69, 112, 169, 0.2);
            border-color: #4C75A3;
            color: #4C75A3;
            box-shadow: 0 4px 15px rgba(69, 112, 169, 0.2);
        }

        .social-link.drive2 { font-size: 11px; font-weight: 700; }

        .social-link.drive2:hover {
            background: rgba(255, 107, 0, 0.2);
            border-color: #FF6B00;
            color: #FF6B00;
            box-shadow: 0 4px 15px rgba(255, 107, 0, 0.2);
        }

        .social-link.facebook:hover {
            background: rgba(24, 119, 242, 0.2);
            border-color: #1877F2;
            color: #1877F2;
            box-shadow: 0 4px 15px rgba(24, 119, 242, 0.2);
        }

        .social-link.instagram:hover {
            background: rgba(225, 48, 108, 0.2);
            border-color: #E1306C;
            color: #E1306C;
            box-shadow: 0 4px 15px rgba(225, 48, 108, 0.2);
        }

        .navbar-controls {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
        }

        .nav-btn.lang-btn {
            min-width: 36px;
            justify-content: center;
            padding: 4px 8px;
            font-size: 13px;
            background: transparent;
            border: none;
            letter-spacing: 0.3px;
        }

        #themeLabel {
            display: inline-block;
            min-width: 5.2em;
            text-align: left;
        }

        .nav-btn {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            padding: 4px 10px;
            cursor: pointer;
            font-weight: 600;
            border-radius: 40px;
            transition: all 0.2s ease;
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
        }

        .nav-btn:hover {
            color: var(--accent-color);
            background: var(--accent-soft);
            border-color: var(--accent-color);
        }

        .nav-btn.lang-btn:hover {
            border: none;
            background: var(--accent-soft);
        }

        .nav-btn.lang-btn.active {
            background: var(--lang-active-bg);
            color: var(--lang-active-color);
            border-color: var(--lang-active-bg);
        }

        .nav-btn.theme-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
        }

        .nav-btn.theme-btn:hover {
            color: var(--accent-color);
            background: var(--accent-soft);
            border-color: var(--accent-color);
        }

        .nav-btn i { font-size: 11px; }

        .nav-divider {
            width: 1px;
            height: 22px;
            background: var(--border-color);
            opacity: 0.5;
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
            padding: 0;
            flex: 1 0 auto;
            width: 100%;
        }

        main {
    min-height: 0 !important;
    padding-bottom: 0 !important;
}

main.pb-3 {
    padding-bottom: 0 !important;
}

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-secondary); }
        ::-webkit-scrollbar-thumb { background: var(--accent-color); border-radius: 10px; }

        .footer {
    flex: 0 0 auto !important;
    flex-grow: 0 !important;
    width: 100%;
    margin-top: auto;
    margin-bottom: 0 !important;
    padding: 10px 0 12px !important;
    min-height: 0 !important;
    height: auto !important;
    line-height: normal !important;
    text-align: center;
    position: static !important; /* важнее, чем relative */
    bottom: auto !important;
}

        .footer-text { text-align: center; margin: 0; }

        /* ========== МОБИЛКА: 2 РЯДА ========== */
        @@media (max-width: 768px) {
            nav.navbar .container-fluid {
                padding: 8px 12px;
                flex-wrap: wrap !important;
            }

            .navbar-wrapper {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                width: 100%;
                flex-wrap: nowrap;
            }

            .navbar-top {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                flex-wrap: nowrap;
                width: 100%;
            }

            .navbar-bottom {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                flex-wrap: nowrap;
                width: 100%;
            }

            .navbar-brand img {
                height: 28px !important;
            }

            .nav-links {
                grid-template-columns: repeat(3, 5.7rem);
                gap: 2px;
            }

            .nav-link-custom {
                padding: 4px 6px;
                font-size: 12px;
            }

            .nav-link-custom.active::after {
                width: 12px;
                height: 2px;
                bottom: 1px;
            }

            .social-icons {
                gap: 6px;
                width: 160px;
            }

            .social-link {
                width: 28px;
                height: 28px;
                font-size: 12px;
                flex-shrink: 0;
            }

            .social-link.drive2 { font-size: 10px; }

            .navbar-controls { gap: 4px; }

            .nav-btn {
                padding: 4px 8px;
                font-size: 11px;
                border-radius: 30px;
            }

            .nav-btn.lang-btn {
                font-size: 13px;
                padding: 4px 8px;
            }

            .nav-btn i { font-size: 11px; }

            .nav-divider { display: none; }

            #themeLabel { display: none; }
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar">
            <div class="container-fluid">
                <div class="navbar-wrapper">
                    <div class="navbar-top">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="/shared-fotos/logo/logo.png" alt="ReFlash Logo"
                                 style="height: 32px; width: auto; filter: drop-shadow(0 0 1px #000000) drop-shadow(0 0 2px #000000) drop-shadow(0 0 3px #000000);" />
                        </a>

                        <div class="nav-links">
                            <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                @GetLocalized("Главная", "Home", "Start")
                            </a>
                            <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "News" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="News">
                                @GetLocalized("Новости", "News", "News")
                            </a>
                            <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Partners" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Partners">
                                @GetLocalized("Партнёры", "Partners", "Partner")
                            </a>
                        </div>
                    </div>

                    <div class="navbar-bottom">
                        <div class="social-icons">
                            <a href="https://t.me/reflashteamofficial" class="social-link telegram" target="_blank" title="Telegram">
                                <i class="fab fa-telegram-plane"></i>
                            </a>
                            <a href="https://vk.ru/reflashteam" class="social-link vk" target="_blank" title="VK">
                                <i class="fab fa-vk"></i>
                            </a>
                            <a href="https://www.drive2.ru/o/reflashteam" class="social-link drive2" target="_blank" title="Drive2.ru">
                                D
                            </a>
                            <a href="https://www.facebook.com/reflashteam/" class="social-link facebook" target="_blank" title="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="https://www.instagram.com/reflashteam/" class="social-link instagram" target="_blank" title="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                        </div>

                        <div class="navbar-controls">
                            <button class="nav-btn lang-btn @(currentLang == "ru" ? "active" : "")" data-lang="ru" onclick="switchLanguage('ru')">РУ</button>
                            <button class="nav-btn lang-btn @(currentLang == "en" ? "active" : "")" data-lang="en" onclick="switchLanguage('en')">EN</button>
                            <button class="nav-btn lang-btn @(currentLang == "de" ? "active" : "")" data-lang="de" onclick="switchLanguage('de')">DE</button>
                            <span class="nav-divider"></span>
                            <button class="nav-btn theme-btn" id="themeToggle" onclick="toggleTheme()"
                                    title="@GetLocalized("Тема", "Theme", "Thema")">
                                <i class="fas @(currentTheme == "dark" ? "fa-moon" : "fa-sun")" id="themeIcon"></i>
                                <span id="themeLabel">@(currentTheme == "dark"
                                    ? GetLocalized("Тёмная", "Dark", "Dunkel")
                                    : GetLocalized("Светлая", "Light", "Hell"))</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="footer-container">
            <p class="footer-text">
                &copy; 2005-@DateTime.Now.Year ReflashTeam
            </p>
        </div>
    </footer>

    <script>
        function switchLanguage(lang) {
            document.cookie = "Language=" + lang + "; path=/; max-age=" + (365 * 24 * 60 * 60);
            location.reload();
        }

        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            const currentTheme = html.getAttribute('data-theme') || 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', newTheme);
            const lang = getCookie('Language') || 'ru';
            if (newTheme === 'dark') {
                if (icon) icon.className = 'fas fa-moon';
                if (label) label.textContent = lang === 'ru' ? 'Тёмная' : lang === 'en' ? 'Dark' : 'Dunkel';
            } else {
                if (icon) icon.className = 'fas fa-sun';
                if (label) label.textContent = lang === 'ru' ? 'Светлая' : lang === 'en' ? 'Light' : 'Hell';
            }
            document.cookie = "Theme=" + newTheme + "; path=/; max-age=" + (365 * 24 * 60 * 60);
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }

        function loadTheme() {
            const theme = getCookie('Theme') || 'dark';
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            const lang = getCookie('Language') || 'ru';
            html.setAttribute('data-theme', theme);
            if (icon) icon.className = theme === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
            if (label) {
                label.textContent = theme === 'dark'
                    ? (lang === 'ru' ? 'Тёмная' : lang === 'en' ? 'Dark' : 'Dunkel')
                    : (lang === 'ru' ? 'Светлая' : lang === 'en' ? 'Light' : 'Hell');
            }
            requestAnimationFrame(function () {
                html.classList.add('theme-ready');
            });
        }

        function updateActiveLanguage() {
            const currentLang = getCookie('Language') || 'ru';
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.dataset.lang === currentLang) btn.classList.add('active');
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            loadTheme();
            updateActiveLanguage();
        });
    </script>
</body>
</html>
